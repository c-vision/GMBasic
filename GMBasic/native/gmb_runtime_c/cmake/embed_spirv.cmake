# embed_spirv.cmake — genera un header C con shader SPIR-V embedded (niente Python).
# Uso: cmake -DOUT=<out.h> -DIN1=<a.spv> -DNAME1=<a> [-DIN2=... -DNAME2=...] -P embed_spirv.cmake
function(gmb_embed_one in_path arr_name)
    file(READ "${in_path}" hex HEX)
    string(LENGTH "${hex}" hex_len)
    math(EXPR nbytes "${hex_len} / 2")
    file(APPEND "${OUT}" "static const unsigned char ${arr_name}[] = {\n")
    set(line "   ")
    set(idx 0)
    while(idx LESS nbytes)
        math(EXPR off "${idx} * 2")
        string(SUBSTRING "${hex}" ${off} 2 byte)
        string(APPEND line " 0x${byte},")
        math(EXPR idx "${idx} + 1")
        math(EXPR mod "${idx} % 12")
        if(mod EQUAL 0)
            file(APPEND "${OUT}" "${line}\n")
            set(line "   ")
        endif()
    endwhile()
    if(NOT line STREQUAL "   ")
        file(APPEND "${OUT}" "${line}\n")
    endif()
    file(APPEND "${OUT}" "};\nstatic const unsigned int ${arr_name}_len = ${nbytes}u;\n\n")
endfunction()
file(WRITE "${OUT}" "/* GENERATO da cmake/embed_spirv.cmake — non modificare a mano. */\n#ifndef GMB_GFX_SPIRV_H\n#define GMB_GFX_SPIRV_H\n\n")
if(DEFINED IN1)
    gmb_embed_one("${IN1}" "${NAME1}")
endif()
if(DEFINED IN2)
    gmb_embed_one("${IN2}" "${NAME2}")
endif()
file(APPEND "${OUT}" "#endif /* GMB_GFX_SPIRV_H */\n")
