<Project>

  <!--
    GMBASIC — Directory.Build.props
    Matrice di build: Edition × Backend × Modules × Deployment.
    Definizione unica dei valori ammessi (regola: valori definiti una sola volta).
  -->

  <!-- ── EDITION ─────────────────────────────────────────────── -->
  <PropertyGroup>
    <!-- DEFAULT GARANTITO: Commercial (sempre, anche da IDE). La Community è SOLO
         esplicita con -p:GmbEdition=Community (override da CLI/riga di comando). -->
    <GmbEdition>Commercial</GmbEdition>
  </PropertyGroup>

  <!-- Valori ammessi: Community | Commercial (gate in targets) -->

  <!-- ── BACKENDS ────────────────────────────────────────────── -->
  <!-- Sottoinsieme di {VM,IL}. Default: VM,IL (il backend C99 C# è ritirato: la gamba C è C99Native) -->
  <PropertyGroup>
    <GmbBackends Condition="'$(GmbBackends)' == ''">VM,IL</GmbBackends>
  </PropertyGroup>

  <PropertyGroup Condition="$(GmbBackends.Contains('VM'))">
    <GmbBackendVM>true</GmbBackendVM>
  </PropertyGroup>
  <PropertyGroup Condition="$(GmbBackends.Contains('IL'))">
    <GmbBackendIL>true</GmbBackendIL>
  </PropertyGroup>

  <!-- ── MODULES ─────────────────────────────────────────────── -->
  <!-- Lista esplicita di moduli. I driver commerciali sono aggiunti solo in Commercial (targets). -->
  <PropertyGroup>
    <GmbModules Condition="'$(GmbModules)' == ''">Sql,VectorDB</GmbModules>
  </PropertyGroup>

  <!-- ── DEPLOYMENT ──────────────────────────────────────────── -->
  <PropertyGroup>
    <GmbDeployment Condition="'$(GmbDeployment)' == ''">FrameworkDependent</GmbDeployment>
  </PropertyGroup>

  <!-- ── SYMBOLS ─────────────────────────────────────────────── -->
  <PropertyGroup>
    <DefineConstants Condition="'$(GmbEdition)' == 'Community'">$(DefineConstants);GMBASIC_COMMUNITY</DefineConstants>
    <DefineConstants Condition="'$(GmbEdition)' == 'Commercial'">$(DefineConstants);GMBASIC_COMMERCIAL</DefineConstants>
  </PropertyGroup>

  <!-- ── COMMON C# SETTINGS ──────────────────────────────────── -->
  <PropertyGroup>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
