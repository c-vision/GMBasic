#!/usr/bin/env bash
# ── MUTEX di build: i comandi di build (cc/clang/cmake/make/dotnet) prendono un lock ──
# esclusivo su mutex.txt SOLO per la durata del SINGOLO comando, poi lo rilasciano subito
# (lo script puo proseguire a lungo senza tenere il lock). Scadenza 15 min con heartbeat:
# un processo in hang non blocca le altre AI. Vedi tools/gmb_with_lock.sh e Knowledge/
# Build-Mutex-Lock-AI.md.
if [ -z "${GMB_BUILDBIN_ON:-}" ]; then
  export GMB_BUILDBIN_ON=1
  GMB_BUILDBIN="$(cd "$(dirname "$0")" && pwd)/buildbin"
  [ -d "$GMB_BUILDBIN" ] && export PATH="$GMB_BUILDBIN:$PATH"
fi

# tools/sh/parity4 — esegue UN sample .bas sulle 4 gambe del MONOREPO e confronta l'output
# normalizzato. Le gambe sono 4, una per backend vivo: il backend C99Backend (emitter C#) e'
# DEPRECATO nel monorepo e non e' piu' una gamba di parita'.
#
#   gamba 1  IL          : tools/runners/test_ilrun --engine=il     (in-process, IL generato)
#   gamba 2  PCodeVM     : tools/runners/test_ilrun --engine=pcode  (PCodeVm C#)
#   gamba 3  VM/C        : tools/runners/test_vmrun                 (gmb_vm_host, chunk A1)
#   gamba 4  C99Native   : gmb_c99native_run.sh (lexer/parser/emitter C -> C)
#
# Gli harness C# NON stanno dentro GMBasic/: vivono in `GMBasicSharp/`, sibling di `GMBasic/`
# nella root del monorepo. I percorsi sono risolti da `$HARNESS_DIR` (monorepo/GMBasicSharp),
# quindi il tool funziona da qualunque CWD.
#
# Uso:
#   tools/sh/parity4 <sample.bas> [--timeout N] [--legs il,pcode,vmc,c99n] [--keep]
#
# Exit 0 se TUTTE le gambe richieste concordano col RIFERIMENTO, che e' la gamba NATIVA
# (C99Native): il compilatore principale del monorepo e' quello nativo, quindi i test girano
# su C99Native e le gambe IL/PCode/VM-C servono a verificare la PARITA'. Se la gamba nativa
# non e' disponibile (driver/build mancante) il riferimento ricade sulla prima gamba eseguita.
# Le gambe non disponibili sono riportate SKIP, non come errore.
set -u
# Locale C: l'output dei programmi può contenere byte non-UTF-8 (record non inizializzati
# documentati come bug). Sotto un locale UTF-8 grep/sed si FERMANO al byte illegale ("Illegal
# byte sequence") e il confronto risulta troncato (falso DIFF/OK).
export LC_ALL=C
ROOT="$(cd "$(dirname "$0")/../../GMBasic" && pwd)"        # GMBasic/
MONOREPO="$(cd "$ROOT/.." && pwd)"              # monorepo: contiene GMBasic/ e GMBasicSharp/
HARNESS_DIR="$MONOREPO/tools/runners"            # harness C# (spostati da GMBasicSharp/ il 2026-10-30)
if [ ! -d "$HARNESS_DIR/test_ilrun" ] || [ ! -d "$HARNESS_DIR/test_vmrun" ]; then
  echo "harness C# non trovati in $HARNESS_DIR (attesi test_ilrun/ e test_vmrun/)"
  echo "parity4 gira sul MONOREPO: GMBasic/ e GMBasicSharp/ devono essere sibling."
  exit 2
fi
CALLER_PWD="$PWD"   # per risolvere un path RELATIVO del sample prima del `cd "$ROOT"`
cd "$ROOT"

FILE=""
TIMEOUT=180
LEGS="il,pcode,vmc,c99n"
KEEP=0
GFX=0
while [ $# -gt 0 ]; do
  case "$1" in
    --timeout) TIMEOUT="$2"; shift 2;;
    --legs)    LEGS="$2"; shift 2;;
    --keep)    KEEP=1; shift;;
    --gfx)     GFX=1; shift;;
    -*)        echo "opzione ignota: $1"; exit 2;;
    *)         FILE="$1"; shift;;
  esac
done
[ -n "$FILE" ] || { echo "uso: tools/sh/parity4 <sample.bas> [--timeout N] [--legs il,pcode,vmc,c99n] [--gfx]"; exit 2; }
# --gfx: gamba IL/PCode con il motore grafico NATIVO (CGfx, esecuzione in linea) invece del
# NullGraphicsService. Serve per confrontare programmi che DISEGNANO: con Null le primitive
# sono no-op sul backend IL e il confronto è falso. Non usarlo con i test "parked"/modali
# (SYNC, SCREEN con pump): senza main thread il park non si completa (timeout).
GFX_ARG=""
[ "$GFX" = 1 ] && GFX_ARG="--gfx" 
# INTERATTIVO (marker header `' TAG: interactive`): salta salvo GMB_RUN_INTERACTIVE=1.
if [ "${GMB_RUN_INTERACTIVE:-0}" != "1" ] && grep -q "^' TAG: interactive" "$FILE" 2>/dev/null; then
  echo "SKIP (interattivo): $FILE — usa GMB_RUN_INTERACTIVE=1"; exit 0; fi
# LIBRARY (marker header `' TAG: library`): il prodotto e' una libreria condivisa, non un
# eseguibile -> nessun output atteso sulle gambe interprete; il gate C99Native deve comunque PASS.
LIB_MODE=0
if grep -q "^' TAG: library" "$FILE" 2>/dev/null; then
  LIB_MODE=1
  # Una libreria non e' eseguibile: le gambe interprete non hanno output da confrontare. Resta
  # la gamba C99Native (che compila -shared e verifica l'export dei simboli ABI).
  LEGS="c99n"
fi
# HEAVY (marker header `' TAG: heavy`): richiede modello reale + training; salta salvo GMB_RUN_HEAVY=1.
if [ "${GMB_RUN_HEAVY:-0}" != "1" ] && grep -q "^' TAG: heavy" "$FILE" 2>/dev/null; then
  echo "SKIP (heavy): $FILE — usa GMB_RUN_HEAVY=1"; exit 0; fi
if [ ! -f "$FILE" ] && [ -f "$CALLER_PWD/$FILE" ]; then FILE="$CALLER_PWD/$FILE"; fi
[ -f "$FILE" ] || { echo "sample non trovato: $FILE"; exit 2; }
# PATH ASSOLUTO: `dotnet run` lancia l'harness con CWD = directory del progetto .NET, quindi un
# percorso relativo (risolto dalla shell di parity4) si romperebbe DENTRO la gamba.
FILE="$(cd "$(dirname "$FILE")" && pwd)/$(basename "$FILE")"

# ── broker pub/sub: se il sample apre un `tcp://` loopback, parity4 lo avvia e lo ferma da sé ──
# È un prerequisito del test, non del codice in prova: un broker morto fa fallire (o rende
# ambiguo) un campione tcp che invece è corretto. `ensure` non tocca un broker già attivo.
BROKER_SH="$MONOREPO/tools/sh/msg_broker.sh"
BROKER_PORTS=""
broker_cleanup() {
  local p
  for p in $BROKER_PORTS; do "$BROKER_SH" release "$p" >/dev/null 2>&1; done
}
trap broker_cleanup EXIT
if [ -x "$BROKER_SH" ]; then
  for _bp in $("$BROKER_SH" ports "$FILE" 2>/dev/null); do
    _bres="$("$BROKER_SH" ensure "$_bp" 2>/dev/null)" || _bres=failed
    case "$_bres" in
      started) BROKER_PORTS="$BROKER_PORTS $_bp"; echo "broker pub/sub avviato da parity4 su :$_bp" ;;
      already) echo "broker pub/sub già attivo su :$_bp (lo lascio a chi l'ha avviato)" ;;
      *)       echo "attenzione: broker non avviabile su :$_bp" >&2 ;;
    esac
  done
fi

# TORCH (macOS): la gamba VM-C/C99 carica libgmb_torch, che ha una LC_RPATH stale verso il
# torch di una virtualenv (stub incompatibile) → dyld carica il torch sbagliato e il processo
# ABORTA (SIGSEGV). Puntiamo DYLD_LIBRARY_PATH alla dir col torch CORRETTO, PRIMA delle gambe
# (deve essere presente al lancio del processo). Vedi Bugs/(solved) - MiniTest-Filter-Array-Crash.md.
# ROOT = GMBasic/ (calcolata prima del cd); usata per build/libs
case "$(uname -m)" in
  arm64) RID5=osx-arm64;;
  x86_64) RID5=osx-x64;;
  *) RID5="";;
esac
# Componenti e librerie NON stanno nel checkout: la cache utente `~/.gmbasic/libs` contiene
# `<componente>/<rid>/` (ml = torch, chromium, obscura, ocr) e `<rid>/` (nostre lib + esterne);
# in sviluppo si aggiunge `GMBasic/build/libs/<rid>/`. Stessa regola di tools/sh/harness.sh.
LIBS_CACHE="$HOME/.gmbasic/libs"
if [ "$(uname)" = "Darwin" ] && [ -n "$RID5" ]; then
  export GMB_TORCH_PATH="${GMB_TORCH_PATH:-$LIBS_CACHE/ml/$RID5}"
  DYLD4="$LIBS_CACHE/ml/$RID5:$LIBS_CACHE/$RID5:$ROOT/build/libs/$RID5"
  if [ -n "${DYLD_LIBRARY_PATH:-}" ]; then
    export DYLD_LIBRARY_PATH="$DYLD4:$DYLD_LIBRARY_PATH"
  else
    export DYLD_LIBRARY_PATH="$DYLD4"
  fi
fi

# CONTRATTO PARITÀ: un sample dichiara nelle prime righe `' PARITY-EXCLUDE: <motivo>` se la
# sua parità cross-backend NON è definibile (nondeterminismo: timestamp/GUID; fixture C#-only;
# browser/CDP; tool-loop C#; rete/server esterni; allocator). parity4 lo segnala SKIP col motivo
# invece di FAIL: il motivo è la documentazione del contratto (Cat.3 della nota Sample-Parita).
EXCL=$(grep -m1 -E "^'[[:space:]]*PARITY-EXCLUDE:" "$FILE" || true)
if [ -n "$EXCL" ]; then
  echo "== SKIP $FILE (PARITY-EXCLUDE) =="
  echo "  motivo: ${EXCL#*PARITY-EXCLUDE:}"
  exit 0
fi

OUT=/tmp/parity4
mkdir -p "$OUT"
# Nome leggibile (per i messaggi) e CHIAVE DI OUTPUT unica per PERCORSO (per i file).
# Il basename da solo NON identifica il test: piu' MiniTest omonimi in domini diversi
# (`arrays/slice.bas` e `matrix/slice.bas`, `abs.bas`, `sum.bas`, `range.bas`, …) scrivevano
# gli STESSI `/tmp/parity4/<base>.<gamba>.txt`: una suite (o due esecuzioni in parallelo)
# sovrascriveva i risultati dell'altro file e il verdetto veniva calcolato sull'output di un
# ALTRO programma — falso PASS/DIFF intermittente. La chiave deriva dal path relativo al repo.
NAME=$(basename "$FILE" .bas)
REL=${FILE#"$MONOREPO"/}
BASE=$(printf '%s' "$REL" | sed -e 's|^/||' -e 's|\.bas$||' -e 's|[^A-Za-z0-9_.-]|_|g')
# Pulizia dei file STANTII della stessa chiave. `find` invece di un glob: invocando lo script
# con `zsh` (invocazione canonica) un glob non corrispondente stampa "no matches found"; con
# `find` è silenzioso e non dipende dalla shell. BASE è sanificato (niente metacaratteri).
find "$OUT" -maxdepth 1 -type f -name "$BASE.*" -delete 2>/dev/null || true

# normalizza: via ANSI, via righe di harness/prompt, trim, via righe vuote.
norm() {
  tr -d '\r' | tr -d '\000-\010\013\014\016-\037' \
  | sed 's/\x1b\[[0-9;]*[A-Za-z]//g; s/\x1b\[[0-9;]*[HJK]//g' \
  | sed -E 's/[[:space:]]+$//' \
  | sed -E 's/\[(bf16|auto-policy|packed-qkv|GMB_MLX_PEROP|GMB_MLX_[A-Z_]+|pflash)[^]]*\][^[:cntrl:]]*//g' \
  | sed -E 's/[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\.[0-9]+[+-][0-9]{2}:[0-9]{2}//g' \
  | sed -E 's/id=[0-9a-f]{32}/id=<id>/g' \
  | grep -v -E '^\[ask\] ' \
  | grep -v -E '^\s*$' \
  | grep -v -E 'Execution completed|Conformance:|^code=|VM/C OUTPUT|exit=|Tempo trascorso|MSBuild|warning|SUCCESS=|BLOCKED=|^\[$|^\?|gmb_vm_host|^OK\b|^\d+\.\d+s' \
  | grep -v -E '^\[ILOptim\]|^\[IL dump\]|^\s*code=[0-9]+ bytes|^\s*--|^Lavoratore [0-9]+' \
  | grep -v -E '^\[OK\] terminato|^\[VMC\]|^\[SYS\]' \
  | grep -v -E '^\[AGENT [A-Za-z]+\] agent='
}

has_leg() { case ",$LEGS," in *",$1,"*) return 0;; esac; return 1; }

# Stderr di una gamba fallita o muta: è l'unica spiegazione disponibile (build del harness,
# MSBuild/MSB4166 per contesa fra sessioni, NuGet, link, loader). Scartandolo, un guasto di build
# diventava "nessun output" e sembrava che il programma fosse morto prima del primo PRINT.
show_stderr() {  # nome, file stderr, rc
  local name="$1" err="$2" rc="$3"
  if [ ! -s "$err" ]; then
    echo "        $name: stderr vuoto (timeout ${TIMEOUT}s o nessun messaggio)"
    return 0
  fi
  echo "        stderr di $name (rc=$rc) — $err:"
  grep -viE 'warning (NU|CS|MSB)[0-9]+|Ripristino|Restore|Determinazione dei progetti|Build started|Tempo trascorso' "$err" \
    | grep -vE '^[[:space:]]*$' | head -8 | sed 's/^/        | /'
  local tot
  tot=$(grep -c . "$err")
  [ "$tot" -gt 8 ] && echo "        | … ($tot righe non vuote; vedi $err)"
  return 0
}

run_leg() {  # nome, comando...
  local name="$1"; shift
  local raw="$OUT/$BASE.$name.raw" err="$OUT/$BASE.$name.stderr"
  # Solo STDOUT entra nel confronto: l'output del programma (PRINT) va su stdout; i log diagnostici
  # del motore nativo ([bf16:*], [auto-policy], [packed-qkv], [GMB_MLX_PEROP], ...), i messaggi di
  # build e quelli del harness vanno su stderr (interleaving non deterministico) e non si confrontano.
  # Lo stderr però si CONSERVA in un file per gamba: è la prova del perché una gamba è muta.
  ( perl -e 'alarm shift; exec @ARGV' "$TIMEOUT" "$@" ) >"$raw" 2>"$err"
  local rc=$?
  norm <"$raw" >"$OUT/$BASE.$name.txt"
  echo "$rc" >"$OUT/$BASE.$name.rc"
  echo "  $name: rc=$rc righe=$(wc -l <"$OUT/$BASE.$name.txt" | tr -d ' ')"
  # Gamba in errore o muta: mostra subito il perché invece del generico "nessun output".
  if [ "$rc" -ne 0 ] || [ ! -s "$OUT/$BASE.$name.txt" ]; then show_stderr "$name" "$err" "$rc"; fi
}

echo "== parity4 $FILE =="
if has_leg il;   then run_leg il   dotnet run --project "$HARNESS_DIR/test_ilrun" -- --engine=il    $GFX_ARG "$FILE"; fi
if has_leg pcode;then run_leg pcode    dotnet run --project "$HARNESS_DIR/test_ilrun" -- --engine=pcode $GFX_ARG "$FILE"; fi
if has_leg vmc;  then run_leg vmc  dotnet run --project "$HARNESS_DIR/test_vmrun" --               "$FILE" "$TIMEOUT"; fi
if has_leg c99n; then
  # gmb_c99native_run.sh sceglie il driver PIÙ RECENTE fra tools/ e il build del
  # compilatore (la copia in tools/ diventa stantia dopo ogni modifica nativa).
  # Nome corrente del driver: gmbnative; fallback al nome ritirato gmb_c99native_driver.
  if [ -x tools/gmbnative ] || [ -x native/gmb_compiler_c/build/gmbnative ] \
     || [ -x tools/gmb_c99native_driver ] || [ -x native/gmb_compiler_c/build/gmb_c99native_driver ]; then
    run_leg c99n bash "$MONOREPO/tools/sh/gmb_c99native_run.sh" "$FILE" p4
  else
    echo "  c99n: SKIP (nessun driver: tools/ né build del compilatore)"
    # marcatore di SKIP: distingue "non eseguibile" da "eseguito senza output" (che è FAIL).
    : > "$OUT/$BASE.c99n.skip"
  fi
fi
# confronto: riferimento = la prima gamba che ha **eseguito con successo** e prodotto output.
# Una gamba con rc != 0 (crash) NON può fare da riferimento e NON può "sparire" in silenzio:
# prima veniva scelta la prima gamba con output, quindi se l'IL crashava il confronto cadeva sul
# VM/C e il verdetto era PASS — un FALSO PASS (misurato su DbfReplication.bas con l'IL in
# segfault: il tool stampava PASS mentre una gamba era morta).
# Un errore NON gestito è un esito legittimo e confrontabile: le gambe divergono solo per
# prefisso (harness/VM) ed exit code, non per il payload. Classificate le gambe in "successo"
# (rc=0) ed "errore" (rc!=0):
#  - tutte successo  → confronto normale (comportamento storico);
#  - tutte errore    → confronto del PAYLOAD con i prefissi per-gamba normalizzati (errpayload);
#    l'exit code resta divergente (6/1/2, decisione canonica ancora aperta) e viene solo riportato;
#  - mix successo/errore → divergenza semantica reale (FAIL).
errpayload() {  # stdin: output normalizzato di una gamba in errore -> solo payload
  sed -E 's/^\[RUN\] [A-Za-z.]+: //; s/^\[P-CODE ERROR\] IP=[0-9]+ op=[A-Za-z_]+: //; s/^\[VM ERROR\] //; s/^BASIC Runtime Error: //; s/^\[GMBASIC\] ERROR [0-9]+: //; s/ \(line [0-9]+\)$//; s/\[RUN\] exit code [0-9]+//' \
  | grep -v -E '^\s*$'
}
REF=""; fail=0; nok=0; nerr=0; nskip=0; nempty=0
# 4 gambe: non esiste piu' la gamba c99 (emitter C# deprecato nel monorepo).
for l in c99n il pcode vmc; do
  has_leg "$l" || continue
  # SKIP dichiarato (driver/build mancante): non è un fallimento del test, ma va contato.
  if [ -f "$OUT/$BASE.$l.skip" ]; then nskip=$((nskip+1)); continue; fi
  rc=$(cat "$OUT/$BASE.$l.rc" 2>/dev/null || echo 1)
  # Una gamba RICHIESTA che non ha prodotto output non può sparire in silenzio: o non ha
  # compilato, o è morta prima del primo PRINT (= nessun test eseguito). Storicamente la
  # guardia `[ -s .txt ] || continue` la ignorava e il verdetto restava PASS (falso PASS
  # misurato il 2026-09-30: le gambe C producevano output VUOTO e il tool stampava PASS).
  if [ ! -s "$OUT/$BASE.$l.txt" ]; then
    if [ "$LIB_MODE" = "1" ]; then nok=$((nok+1)); [ -z "$REF" ] && REF="$l"; continue; fi
    nempty=$((nempty+1))
    echo "  FAIL $l: nessun output — la gamba è stata eseguita ma non ha prodotto nulla"
    echo "        (compilazione fallita, esecuzione morta prima del primo PRINT, o gate assente)"
    if [ -s "$OUT/$BASE.$l.raw" ]; then
      echo "        prime righe di $OUT/$BASE.$l.raw:"
      sed -n '1,4p' "$OUT/$BASE.$l.raw" | sed 's/^/        | /'
    elif [ -s "$OUT/$BASE.$l.stderr" ]; then
      echo "        stderr: $OUT/$BASE.$l.stderr (riportato sopra)"
    fi
    fail=1
    continue
  fi
  errpayload <"$OUT/$BASE.$l.txt" >"$OUT/$BASE.$l.err.txt"
  if [ "$rc" = "0" ]; then nok=$((nok+1)); [ -z "$REF" ] && REF="$l"
  else nerr=$((nerr+1)); fi
done
for l in il pcode vmc c99n; do
  rcf="$OUT/$BASE.$l.rc"; [ -s "$rcf" ] && echo "  $l: exit=$(cat "$rcf")"
done
if [ "$nskip" -gt 0 ]; then echo "  gambe SKIP (non eseguibili, non contate): $nskip"; fi
# LIBRARY: nessuna gamba interprete eseguita; il verdetto e' la gamba C99Native (sotto).
if [ "$LIB_MODE" = "1" ]; then nok=1; REF=c99n; fi

if [ "$nok" = "0" ] && [ "$nerr" = "0" ]; then
  # Caso peggiore: nessun test eseguito. Un verdetto qui sarebbe inventato.
  if [ "$nempty" -gt 0 ]; then
    echo "  FAIL: nessuna gamba ha prodotto output — 0 test eseguiti, verdetto impossibile"
  else
    echo "  FAIL: nessuna gamba eseguita (0 test) — verdetto impossibile"
  fi
  fail=1
elif [ "$nok" = "0" ] && [ "$nerr" -ge 2 ]; then
  # Exit code canonico dell'errore non gestito: DEVE essere identico su tutte le gambe (6).
  codes=""
  for l in il pcode vmc c99n; do
    [ -s "$OUT/$BASE.$l.rc" ] && codes="$codes $(cat "$OUT/$BASE.$l.rc")"
  done
  nuniq=$(printf '%s\n' $codes | sort -u | grep -c .)
  if [ "$nuniq" -gt 1 ]; then
    echo "  FAIL: exit code d'errore NON uniformi:${codes} (atteso 6 su tutte le gambe)"; fail=1
  fi
  REFE="$OUT/$BASE.c99n.err.txt"; [ -s "$REFE" ] || REFE="$OUT/$BASE.il.err.txt"
  [ -s "$REFE" ] || REFE=$(ls "$OUT/$BASE".*.err.txt 2>/dev/null | head -1)
  REFL=$(basename "$REFE" .err.txt); REFL=${REFL#"$BASE."}
  echo "riferimento errore: $REFL"
  for l in il pcode vmc c99n; do
    [ -s "$OUT/$BASE.$l.err.txt" ] || continue
    [ "$l" = "$REFL" ] && continue
    if diff -q "$REFE" "$OUT/$BASE.$l.err.txt" >/dev/null; then
      echo "  OK   $l == $REFL (payload errore identico)"
    else
      echo "  DIFF $l != $REFL (payload errore)"; diff "$REFE" "$OUT/$BASE.$l.err.txt" | head -10; fail=1
    fi
  done
elif [ "$nok" -gt 0 ] && [ "$nerr" -gt 0 ]; then
  echo "  FAIL: gambe in errore (rc!=0) e gambe in successo insieme (divergenza semantica)"; fail=1
else
  if [ -z "$REF" ]; then
    echo "  FAIL: nessuna gamba di riferimento (solo gambe in errore non confrontabili: nerr=$nerr)"; fail=1
  else
  echo "riferimento: $REF"
  for l in il pcode vmc c99n; do
    has_leg "$l" || continue
    [ "$l" = "$REF" ] && continue
    [ -f "$OUT/$BASE.$l.skip" ] && continue
    # Una gamba vuota è già stata segnalata come FAIL sopra: non si confronta (un confronto
    # vuoto-vuoto darebbe un falso OK) e comunque non è un riferimento valido.
    [ -s "$OUT/$BASE.$l.txt" ] || continue
    [ "$(cat "$OUT/$BASE.$l.rc" 2>/dev/null || echo 1)" = "0" ] || continue
    if diff -q "$OUT/$BASE.$REF.txt" "$OUT/$BASE.$l.txt" >/dev/null; then
      echo "  OK   $l == $REF"
    else
      echo "  DIFF $l != $REF"; diff "$OUT/$BASE.$REF.txt" "$OUT/$BASE.$l.txt" | head -10; fail=1
    fi
  done
  fi
fi
# LIBRARY: allineamento su TUTTE le gambe — le gambe interprete devono ACCETTARE la direttiva
# senza errore (nessun output di programma atteso); la gamba C nativa deve PRODURRE la
# libreria condivisa (driver nativo qui sotto).
if [ "$LIB_MODE" = "1" ]; then
  run_leg il_lib    dotnet run --project "$HARNESS_DIR/test_ilrun" -- --engine=il    "$FILE"
  run_leg pcode_lib dotnet run --project "$HARNESS_DIR/test_ilrun" -- --engine=pcode "$FILE"
  run_leg vmc_lib   dotnet run --project "$HARNESS_DIR/test_vmrun" --               "$FILE" "$TIMEOUT"
  for l in il_lib pcode_lib vmc_lib; do
    if [ "$(cat "$OUT/$BASE.$l.rc" 2>/dev/null || echo 1)" = "0" ]; then
      echo "  OK   ${l%_lib} (LIBRARY accettato)"
    else
      echo "  FAIL ${l%_lib} (LIBRARY) rc=$(cat "$OUT/$BASE.$l.rc" 2>/dev/null)"; fail=1
    fi
  done
  if [ -x native/gmb_compiler_c/build/gmbnative ] || [ -x native/gmb_compiler_c/build/gmb_c99native_driver ]; then
    run_leg c99n_lib bash "$MONOREPO/tools/sh/gmb_c99native_run.sh" "$FILE" p4lib
    if [ "$(cat "$OUT/$BASE.c99n_lib.rc" 2>/dev/null || echo 1)" = "0" ]; then
      echo "  OK   c99n (lib condivisa costruita)"
    else
      echo "  FAIL c99n (lib) rc=$(cat "$OUT/$BASE.c99n_lib.rc" 2>/dev/null)"; fail=1
    fi
  fi
fi

[ "$KEEP" = 1 ] || true
[ "$fail" = 0 ] && echo "== PASS $NAME ==" || echo "== DIFF $NAME (output in $OUT/$BASE.*) =="
