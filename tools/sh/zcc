#!/usr/bin/env bash
# tools/sh/zcc — `zig cc` per macOS con i pezzi che clang Apple ricava da sé e zig no.
#
#   -F<SDK>/System/Library/Frameworks  header dei framework (`<Accelerate/Accelerate.h>`) e, al
#                                      LINK, il percorso dove ld cerca i framework: senza,
#                                      `-framework Accelerate` muore con «unable to find system
#                                      framework … searched paths: none», e `Accelerate.h` non si
#                                      trova. Misurato: la sola compilazione dei 395 sorgenti del
#                                      runtime NON se ne accorge (non includono header di
#                                      framework), quindi non usatela come prova che `-F` è
#                                      superfluo — serve appena si compila o linka un framework.
#   -isystem <SDK>/usr/include         libDER/DERItem.h, che l'SDK include da
#                                      Security.framework/oids.h (vi arriva ApplicationServices):
#                                      misurato — senza, gmb_ax_mac.c e gmb_computer_provider_mac.c
#                                      non compilano.
# NESSUNA `-include` forzata su ogni unità: chi usa `_NSGetExecutablePath` include
# `mach-o/dyld.h` da sé (14 chiamanti) o lo dichiara `extern`. L'unica eccezione
# storica era gmb_eval_hook.c, che ora ha il suo `#include` sotto `__APPLE__`.
#   -L<SDK>/usr/lib                    .tbd di sistema (libsqlite3/libcurl/libz/libbz2)
#   -target <arch>-macos.<FLOOR>       PAVIMENTO: senza, il minimo di macOS lo decide lo SDK del
#                                      builder (qui 27.2) e il binario NON parte su macOS
#                                      precedenti. zig ignora `-mmacosx-version-min`: la versione
#                                      va nella triple. Un `-target` del chiamante (cross) vince.
#                                      Il VALORE sta in `tools/sh/macos-floor`, unica fonte letta
#                                      anche da `gmb_link_set.sh`: qui non c'è nessun letterale.
#
# XCODE NON SERVE: basta l'SDK dei Command Line Tools (`xcode-select --install`). `xcrun` è la
# via normale; se Xcode è stato rimosso dopo l'installazione `xcode-select` punta a un percorso
# morto e `xcrun` fallisce mentre l'SDK dei CLT è ancora al suo posto — si cerca anche lì.
#
# Uso: tools/sh/test_minitests_c99native --rid osx-arm64 --cc "tools/sh/zcc"
#      tools/sh/zcc --print        riga esatta (debug)
# Fuori da Darwin esegue `zig cc "$@"` senza flag macOS (il cross li prende da gmb_link_set.sh).
set -uo pipefail

ZIG=""
for c in "${HOME}"/.gmbasic/toolchains/zig/*/zig; do [ -x "$c" ] && ZIG="$c"; done
[ -n "$ZIG" ] || ZIG="$(command -v zig || true)"
[ -n "$ZIG" ] || { echo "zcc: zig non trovato (PATH o ~/.gmbasic/toolchains/zig/*/zig)" >&2; exit 127; }

FLAGS=()
if [ "$(uname -s)" = Darwin ]; then
  # Pavimento macOS: UNICA fonte `tools/sh/macos-floor` (nessun letterale, così non può andare
  # fuori sincrono con gmb_link_set.sh). `read` è un BUILTIN: zero processi in più per ogni
  # unità compilata. Si legge QUI e non a livello di script: fuori da Darwin il valore non serve
  # e un build Linux non deve dipendere da un file che non usa.
  case "${BASH_SOURCE[0]:-$0}" in
    */*) _zcc_dir="${BASH_SOURCE[0]:-$0}"; _zcc_dir="${_zcc_dir%/*}" ;;
    *)   _zcc_dir="$(command -v -- "$0")"; _zcc_dir="${_zcc_dir%/*}" ;;
  esac
  [ -r "$_zcc_dir/macos-floor" ] \
    || { echo "zcc: $_zcc_dir/macos-floor mancante (pavimento macOS: unica fonte)" >&2; exit 127; }
  IFS= read -r MACOS_FLOOR < "$_zcc_dir/macos-floor"
  SDK="$(xcrun --show-sdk-path 2>/dev/null || true)"
  if [ ! -d "${SDK:-}" ]; then
    for s in /Library/Developer/CommandLineTools/SDKs/MacOSX.sdk \
             /Library/Developer/CommandLineTools/SDKs/MacOSX*.sdk; do
      if [ -d "$s" ]; then SDK="$s"; break; fi
    done
  fi
  [ -d "${SDK:-}" ] || { echo "zcc: SDK macOS non trovato — servono i Command Line Tools (xcode-select --install); Xcode NON serve" >&2; exit 127; }
  FLAGS=(-isysroot "$SDK" -L"$SDK/usr/lib" -isystem "$SDK/usr/include" \
         -F"$SDK/System/Library/Frameworks")
  # Pavimento macOS: solo per l'HOST, cioè quando il chiamante non ha già scelto il target
  # (il cross passa `-target` via gmb_link_set.sh, che ha lo stesso pavimento nella triple).
  explicit=0
  for a in "$@"; do [ "$a" = "-target" ] && explicit=1; done
  if [ "$explicit" = 0 ]; then
    case "$(uname -m)" in
      arm64) FLAGS+=(-target "aarch64-macos.$MACOS_FLOOR") ;;
      *)     FLAGS+=(-target "x86_64-macos.$MACOS_FLOOR") ;;
    esac
  fi
fi

if [ "${1:-}" = "--print" ]; then
  printf '%s cc' "$ZIG"
  printf ' %q' ${FLAGS[@]+"${FLAGS[@]}"}
  echo
  exit 0
fi

exec "$ZIG" cc ${FLAGS[@]+"${FLAGS[@]}"} "$@"
