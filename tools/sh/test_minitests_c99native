#!/usr/bin/env bash
# ── MUTEX di build: i comandi di build (cc/clang/cmake/make/dotnet) prendono un lock ──
# esclusivo su mutex.txt SOLO per la durata del SINGOLO comando, poi lo rilasciano subito
# (lo script puo proseguire a lungo senza tenere il lock). Scadenza 15 min con heartbeat:
# un processo in hang non blocca le altre AI. Vedi tools/gmb_with_lock.sh e Knowledge/
# Build-Mutex-Lock-AI.md.
if [ -z "${GMB_BUILDBIN_ON:-}" ]; then
  export GMB_BUILDBIN_ON=1
  GMB_BUILDBIN="$(cd "$(dirname "$0")" && pwd)/buildbin"
  [ -d "$GMB_BUILDBIN" ] && export PATH="$GMB_BUILDBIN:$PATH"
fi

# test_minitests_c99native — esegue ogni MiniTest/ con il compilatore nativo C99
# (C99Native): lex→parse→gmb_c99_emit (driver gmbnative) → compilazione col runtime
# reale → esecuzione. PASS = genera C + compila + run exit 0. Complementare al gate C99
# (C99Native) e al test di parità IL/PCode/VMC.
#
# COMPILATORE: ZIG è il toolchain canonico su ogni piattaforma (`tools/sh/zcc` = `zig cc`
# + i flag che Apple clang ricava da sé), quindi è il DEFAULT: non serve `--cc`.
# `--cc cc` esiste solo come GAMBA A/B di confronto col clang di sistema, mai come
# riferimento: il clang di zig promuove a errore difetti che Apple clang nasconde
# (es. -Wincompatible-pointer-types), quindi una corsa solo-`cc` non è un gate di
# portabilità. Senza zig installato si ripiega su `cc` con un avviso (modalità degradata).
#
# Uso: tools/sh/test_minitests_c99native [--cc <compilatore>] [--target <triple>] [--rid <rid>]
#   F5: gli stessi argomenti del runner diretto. `--rid` prende triple, framework, sistema e terze
#   parti da `tools/sh/gmb_link_set.sh` (stessa fonte di `gmb_c99native_run.sh`).
#   Filtro dei file: GMB_MINI_ONLY="<dominio>/<file>[,<altro>]".
set -u
PRE_CC=""; PRE_TRIPLE=""; PRE_RID=""
while [ $# -gt 0 ]; do
  case "$1" in
    --cc)       PRE_CC="${2:-}"; shift 2 ;;
    --cc=*)     PRE_CC="${1#--cc=}"; shift ;;
    --target)   PRE_TRIPLE="${2:-}"; shift 2 ;;
    --target=*) PRE_TRIPLE="${1#--target=}"; shift ;;
    --rid)      PRE_RID="${2:-}"; shift 2 ;;
    --rid=*)    PRE_RID="${1#--rid=}"; shift ;;
    *) echo "test_minitests_c99native: argomento sconosciuto: $1 (--cc/--target/--rid)" >&2; exit 2 ;;
  esac
done
ROOT="$(cd "$(dirname "$0")/../../GMBasic" && pwd)"; cd "$ROOT"
# I TOOL vivono nella radice del MONOREPO (`tools/`), non più in GMBasic/tools.
# NB: si ricava da ROOT (assoluto) e NON da `$0`: dopo il `cd` un `$0` relativo
# (`tools/sh/…`) non è più risolvibile — succedeva e MONO restava vuoto.
MONO="$(cd "$ROOT/.." && pwd)"
# llmtoken.h (gmb_distill.c lo include) vive in LLMEnv/LLMToken (radice, non include/).
LLMENV="${LLMENV:-$HOME/Documents/Projects/LLMEnv}"
# Include LLMEnv (post-migrazione: header rinominati gmb_* -> llmengine_*/*): gli stessi -I del
# gate C99 (tests/GMBASIC.Backend.C99.Tests). llmtoken.h sta nella RADICE di LLMToken.
LLM_INC="-I$LLMENV/LLMToken -I$LLMENV/LLMJinja -I$LLMENV/LLMEngine/mlx -I$LLMENV/LLMCodec/include -I$LLMENV/LLMEngine/include -I$ROOT/gmbllm/include -I$ROOT/gmbllm/include/quant -I$ROOT/gmbllm/include/train -I$ROOT/gmbllm/include/lora -I$LLMENV/LLMEngine/plugin -I$LLMENV/LLMDesc -I$LLMENV/LLMEngine/Options -I$LLMENV/LLMEngine/moe/include"
HOST_BUILD="$ROOT/native/gmb_compiler_c/build"
# -I del driver nativo: stessa lista di CMake (gmb_compiler_c/CMakeLists.txt:42-47).
# Sono TUTTI flag -I: una lista di path senza -I verrebbe passata come file di input al linker.
INC_C="-I$ROOT/native/gmb_compiler_c/include -I$ROOT/native/gmb_compiler_c/frontend/include"
INC_C="$INC_C -I$ROOT/native/gmb_bytecode/include -I$ROOT/native/gmb_c99native/include"
INC_RT="-I$ROOT/native/gmb_runtime_c/include"
INC_CHART="$ROOT/native/gmb_chart/include"
DRV="$HOST_BUILD/gmbnative"
# gmb_chart = motore chart autonomo (native/gmb_chart): compilato insieme al runtime.
RT_SRCS="$(echo "$ROOT"/native/gmb_runtime_c/src/*.c) $(echo "$ROOT"/native/gmb_runtime_c/src/amos/*.c) $(echo "$ROOT"/native/gmb_chart/src/*.c)"
# SPLIT core/AI (2026-11-02): l'implementazione del provider locale DECIDE dipende da LLMEnv
# (llmtoken/llmjinja/engine) e vive nella dylib `gmb_runtime_ai`, NON nel core. Il glob sopra la
# includerebbe → due definizioni di `gmb_ai_decide_local_run` e riferimenti LLMEnv non linkati.
# Il core usa il forwarder del gateway, che carica la dylib a runtime.
RT_SRCS="$(echo $RT_SRCS | tr ' ' '\n' | grep -v '/gmb_ai_decide_local.c$' | tr '\n' ' ')"
# ORDINE DEI MEMBRI NELL'ARCHIVIO (§0bis: una sola implementazione, quella FORTE).
# `gmb_ai_gateway.c` espone copie DEBOLI (GMB_AI_WEAK) di ASR/LLM/modelio/distill, che a runtime
# fanno `dlopen` di `libgmb_runtime_ai`: sul ramo non-Windows quei forti vivono nella dylib AI, non
# nel core (CMakeLists §"SPLIT core/AI"). Qui però il runtime è MONOLITICO (come il ramo WIN32) e i
# sorgenti AI ci sono TUTTI. In un archivio vince il PRIMO membro che soddisfa un simbolo: con
# l'ordine alfabetico è il gateway, che quindi fa scartare il forte → il test ricade sul `dlopen`,
# che in questo eseguibile non riesce a risolvere i simboli del core e muore con SIGSEGV
# (train/train_dataset_build.bas, 2026-11-04: EXC_BAD_ACCESS a 0x0 dentro un initializer della
# dylib, chiamato da ai_sym). I forti vanno PRIMA del gateway.
RT_SRCS_AI_STRONG=""
for _ai in gmb_asr_cmd.c gmb_llm_tok.c gmb_model_io.c gmb_distill.c gmb_ai_register.c; do
  [ -f "$ROOT/native/gmb_runtime_c/src/$_ai" ] && RT_SRCS_AI_STRONG="$RT_SRCS_AI_STRONG $ROOT/native/gmb_runtime_c/src/$_ai"
done
RT_SRCS="$RT_SRCS_AI_STRONG $(echo $RT_SRCS | tr ' ' '\n' | grep -vE '/(gmb_asr_cmd|gmb_llm_tok|gmb_model_io|gmb_distill|gmb_ai_register)\.c$' | tr '\n' ' ')"
# Engine ASR (LLMEnv/LLMEngine/asr): gmb_asr_cmd.c (in gmb_runtime_c/src) usa i simboli gmb_asr_*,
# le cui implementazioni NON sono più in gmb_runtime_c/src (refactor ASR) → senza, il link fallisce.
RT_SRCS="$RT_SRCS $(echo "$LLMENV"/LLMEngine/asr/src/*.c)"
INC_RT="$INC_RT -I$LLMENV/LLMEngine/asr/include"
# MODEL I/O / gmoe converter (native/gmb_compiler_c/src/model/*.c): gmb_runtime_c/src/gmb_model_io.c
# li richiama (gmb_gmoe_convert/gmb_model_quantize_ex/...). Il gate C99 li compila così (rtSrcs += model).
RT_SRCS="$RT_SRCS $(echo "$ROOT"/native/gmb_compiler_c/src/model/*.c)"
# CODEC: il CORE è la static lib; le IMPLEMENTAZIONI sono plugin DYLIB (come il target gmb_runtime).
CODEC_DIR="$LLMENV/LLMEngine/mlx/build-gmbasic"
CODEC_INC="-I$LLMENV/LLMCodec/include -I$LLMENV/LLMEngine/moe/include -I$ROOT/native/gmb_compiler_c/include"
CODEC_LIB="$CODEC_DIR/llmcodec_mlx_build/libllmcodec.a -L$CODEC_DIR -lllmcodec_ggml -lllmcodec_mlx_affine -lllmcodec_fp8 -Wl,-rpath,$CODEC_DIR"
# gmb_moe_runtime (prebuilt, come il gate): gmb_gmoe_convert/gmb_model_io usano gmb_moe_arch/discover/
# model/gguf_* che non stanno in gmb_runtime_c/src. Fix 2026-09-24.
MOE_LIB="$LLMENV/LLMEngine/mlx/build-gmbasic/llmengine_moe_mlx_build/libllmengine_moe.a"
# CUA/browser: i backend C usano gmb_agent_runtime (C) — vedi CUA-Universal-Action-Runtime-Guida.
# gmb_agent_runtime dipende dal motore Jinja C (gmb_chat_template.c -> gmb_jinja): va linkato.
AGENT_SRCS="$(echo "$ROOT"/native/gmb_agent_runtime/*.c) $LLMENV/LLMJinja/llmjinja.c $LLMENV/LLMJinja/llmjinja_builtins.c"
# ZIG È IL COMPILATORE CANONICO (accordo 2026-11-13: un solo toolchain, artefatti uguali su
# ogni piattaforma). Default = `tools/sh/zcc`, cioè `zig cc` + i flag che su macOS clang Apple
# ricava da sé. `--cc cc` resta soltanto come gamba A/B di confronto, NON come default.
# Se zig non è installato si ripiega su `cc` con un avviso: il runner non deve morire su una
# macchina senza toolchain zig (la cache del runtime resta separata perché lo stamp include il
# compilatore, vedi `cc=$FC`).
if [ -z "$PRE_CC" ] && [ -x "$MONO/tools/sh/zcc" ]; then PRE_CC="tools/sh/zcc"; fi
# `--cc "tools/sh/zcc"` è relativo al MONOREPO, ma qui la cwd è `$ROOT`: si risolve sotto `$MONO`.
case "$PRE_CC" in ""|/*) : ;; *) [ -f "$MONO/$PRE_CC" ] && PRE_CC="$MONO/$PRE_CC" ;; esac
[ -n "$PRE_CC" ] || echo "compilatore: cc (fallback: tools/sh/zcc non eseguibile, installa la toolchain zig)" >&2
FC="${PRE_CC:-cc}"          # compilatore (F5: `--cc "<zig> cc"` come nel runner diretto)
TF=""                        # -target del RID (F5)
if [ -n "$PRE_RID" ] && [ -z "$PRE_TRIPLE" ]; then
  PRE_TRIPLE="$(bash "$MONO/tools/sh/gmb_link_set.sh" --rid "$PRE_RID" --print triple)" || exit 2
fi
# (niente `case` dentro `$( )`: bash 3.2 di macOS non lo parsa — errore di sintassi a ogni run)
_U="$(uname -s)-$(uname -m)"
if   [ "$_U" = Darwin-arm64 ];  then HOST_RID=osx-arm64
elif [ "$_U" = Darwin-x86_64 ]; then HOST_RID=osx-x64
elif [ "$_U" = Linux-x86_64 ];  then HOST_RID=linux-x64
elif [ "$_U" = Linux-aarch64 ] || [ "$_U" = Linux-arm64 ]; then HOST_RID=linux-arm64
else HOST_RID=osx-arm64; fi
TARGET_RID="${PRE_RID:-$HOST_RID}"
# Framework/sistema/terze parti: dal resolver del RID (F5), non cablati su Darwin.
eval "$(bash "$MONO/tools/sh/gmb_link_set.sh" --rid "$TARGET_RID" --cache "$HOME/.gmbasic/libs/$TARGET_RID")" || exit 2
# `-target` DOPO il resolver (LS_SDK nasce lì): ordine sbagliato = `set -u` rosso su LS_SDK.
  [ -n "$PRE_TRIPLE" ] && TF="-target $PRE_TRIPLE ${LS_SDK[*]+${LS_SDK[*]}}"   # + `-isysroot` (piano L13)
  # Windows: force-include dello shim POSIX→Win32 (gmtime_r/localtime_r, unistd, sys/*) e i
  # define *_STATIC, perché nella cache win curl/pcre2/SDL sono statici ma gli header usano dllimport.
  case "$TARGET_RID" in
    win-*) TF="$TF -include $ROOT/native/win32shim/include/gmb_win32.h -I$ROOT/native/win32shim/include -DCURL_STATICLIB -DPCRE2_STATIC -DSDL_STATIC" ;;
  esac
# ── Vulkan: backend OPZIONALE, aggiunto da CMake solo se il system header esiste. Il bundle del
# RID non lo porta (`vulkan/vulkan.h` è un header di sistema, non un file scaricabile da lì):
# senza questo filtro il cross si ferma sulla PRIMA riga di gmb_gfx_vulkan.c. Sull'host, dove
# l'header c'è, il sorgente resta nel set come prima.
if [ ! -f "$HOME/.gmbasic/libs/$TARGET_RID/include/vulkan/vulkan.h" ]; then
  RT_SRCS="$(echo $RT_SRCS | tr ' ' '\n' | grep -v '/gmb_gfx_vulkan.c$' | tr '\n' ' ')"
fi
# ── AR: l'`ar` di Apple RIFIUTA oggetti non-Mach-O («archive member … not a mach-o file») e
# scrive un archivio con ZERO membri: il link poi fallisce con «undefined symbol» su tutto il
# runtime. Per un RID ELF da macOS serve `zig ar` (llvm-ar), ricavato dal primo campo di --cc.
AR_CMD="ar"
case "$PRE_CC" in
  *zig*' cc') AR_CMD="${PRE_CC% cc} ar" ;;
  *zcc)       ZIGBIN="$("$PRE_CC" --print 2>/dev/null | awk '{print $1}')"
              [ -n "$ZIGBIN" ] && AR_CMD="$ZIGBIN ar" ;;   # ar di Apple rifiuta oggetti non-Mach-O
             esac
FRAMEWORKS="${LS_FRAMEWORKS[*]+${LS_FRAMEWORKS[*]}}"   # vuoto fuori da macOS; `set -u` + bash 3.2
if [ "$TARGET_RID" != "$HOST_RID" ]; then
  echo "cross $TARGET_RID da $HOST_RID: i binari vengono linkati ma NON eseguiti" >&2
fi

# Il driver va RICOMPILATO se manca OPPURE se è più vecchio della libreria del compilatore
# o del proprio sorgente. Prima si ricompilava SOLO se il binario mancava: dopo ogni modifica
# all'emitter/parser nativo il runner riusava il binario stale in silenzio (lezione
# erase_alias 2026-09-14, ripetuta nella sessione rag-eval — entrambe le volte sintomi
# "simbolo non trovato"/emissioni vecchie con libreria fresca).
# Il driver sta in native/gmb_c99native/driver/ (NON in gmb_compiler_c/driver/, path obsoleto:
# qui il rebuild falliva con "no such file or directory" e il tool non verificava NULLA).
DRIVER_SRC="$ROOT/native/gmb_c99native/driver/gmb_c99native_driver.c"

# ── Anti-stale delle STATIC LIB precompilate, linkate BY-PATH ──────────────────
# libgmb_compiler_c.a (frontend + gmb_bytecode + gmb_c99native: lexer/parser/emitter) e
# libgmb_db.a non hanno dipendenza di build verso il driver: si linkano per percorso. Se i
# sorgenti cambiano senza ricostruire la .a, il driver usa il codice VECCHIO in silenzio.
# Caso reale 2026-10-26: modificato `gmb_c99native/src/gmb_c99_emit.c` (RUN -> gmb_shell_run),
# il MiniTest continuava a dare output vuoto ANCHE dopo aver ricompilato il driver, perche'
# libgmb_compiler_c.a era vecchia. Costo quando e' tutto fresco: solo la scansione dei mtime.
newest_src_mtime() {
  # mtime piu' recente tra sorgenti/header/CMake delle directory date (esclusi build*/tests/_deps)
  find "$@" -type f \( -name '*.c' -o -name '*.h' -o -name '*.txt' -o -name '*.cmake' \) \
       -not -path '*/build*' -not -path '*/tests/*' -not -path '*/_deps/*' 2>/dev/null \
    | while IFS= read -r s; do stat -f '%m' "$s" 2>/dev/null || echo 0; done | sort -rn | head -1
}
# Policy del rebuild ("hard" di default):
#   hard → se il rebuild fallisce ci si FERMA. È la scelta giusta per le lib che cambiano la
#          semantica di OGNI test (compiler/emitter, db).
#   soft → se il rebuild fallisce si avvisa FORTE e si prosegue con la lib esistente: le lib LLM
#          vivono anche in LLMEnv (repo separato, editato da altre sessioni) e un suo stato
#          intermedio rotto non deve bloccare i MiniTest che con le LLM non c'entrano nulla.
ENSURE_POLICY=hard
ensure_static_lib() {
  # ensure_static_lib <lib.a> <build dir> <target cmake> <dir sorgenti...>
  local lib="$1" build="$2" target="$3"; shift 3
  [ -d "$build" ] || return 0
  local newest; newest="$(newest_src_mtime "$@")"
  [ -n "$newest" ] || newest=0
  local lib_mtime=0
  [ -f "$lib" ] && lib_mtime="$(stat -f '%m' "$lib" 2>/dev/null || echo 0)"
  # nessun sorgente trovato (es. LLMEnv assente) => non si forza nulla
  if [ -f "$lib" ] && [ "$newest" -le "$lib_mtime" ]; then return 0; fi
  echo "build $target (static lib stale o mancante)..."
  local log; log="$(mktemp "${TMPDIR:-/tmp}/gmb_c99native_${target}.XXXXXX")"
  if ! cmake --build "$build" --target "$target" -j 4 >"$log" 2>&1; then
    if [ "$ENSURE_POLICY" = "soft" ] && [ -f "$lib" ]; then
      echo "!! build $target FALLITA: uso la lib esistente, che può essere STALE" >&2
      echo "!!   → i risultati di questo run che toccano le LLM NON sono affidabili" >&2
      tail -5 "$log" >&2
      rm -f "$log"
      return 0
    fi
    echo "!! build $target FALLITA — mi fermo: una lib vecchia produce falsi negativi" >&2
    tail -15 "$log" >&2
    rm -f "$log"
    exit 1
  fi
  rm -f "$log"
}
ensure_static_lib "$HOST_BUILD/libgmb_compiler_c.a" "$HOST_BUILD" gmb_compiler_c \
  "$ROOT/native/gmb_compiler_c" "$ROOT/native/gmb_c99native" "$ROOT/native/gmb_bytecode"
ensure_static_lib "$ROOT/native/gmb_db_c/build/libgmb_db.a" "$ROOT/native/gmb_db_c/build" gmb_db \
  "$ROOT/native/gmb_db_c"

# Lib LLM precompilate, stesso problema (linkate by-path in LINK_IN): gmbllm è PUL e vive nel
# repo; llmengine_plugin/llmdesc vivono in LLMEnv. Una .a vecchia falsa i test LLM (o fa fallire
# il link con simboli che non esistono più). Policy soft: vedi commento sopra.
# `gmbllm` è un target INTERFACE (aggregato): gli archivi reali sono gmbllm_core e gmbllm_train
# (link order: train prima di core), non esiste più un libgmbllm.a da ricostruire.
# Solo per il RID nativo: per un altro RID queste librerie NON si linkano (vedi LINK_IN/LS_LLM),
# quindi non ha senso compilarle qui (per win-* non compilerebbero nemmeno).
if [ "$LS_LLM" = 1 ]; then
  ENSURE_POLICY=soft
  ensure_static_lib "$ROOT/native/gmb_runtime_c/build/gmbllm_build/libgmbllm_train.a" \
    "$ROOT/native/gmb_runtime_c/build" gmbllm_train "$ROOT/gmbllm"
  ensure_static_lib "$ROOT/native/gmb_runtime_c/build/gmbllm_build/libgmbllm_core.a" \
    "$ROOT/native/gmb_runtime_c/build" gmbllm_core "$ROOT/gmbllm"
  ensure_static_lib "$ROOT/native/gmb_runtime_c/build/llmengine_plugin_build/libllmengine_plugin.a" \
    "$ROOT/native/gmb_runtime_c/build" llmengine_plugin "$LLMENV/LLMEngine/plugin"
  ensure_static_lib "$ROOT/native/gmb_runtime_c/build/llmdesc_build/libllmdesc.a" \
    "$ROOT/native/gmb_runtime_c/build" llmdesc "$LLMENV/LLMDesc"
  ENSURE_POLICY=hard
fi

if [ ! -x "$DRV" ] || [ "$DRV" -ot "$HOST_BUILD/libgmb_compiler_c.a" ] || \
   [ "$DRV" -ot "$DRIVER_SRC" ]; then
  echo "build driver (stale o mancante)..."
  # gmb_opt_env/gmb_paths/gmb_abi vivono nel runtime ma il driver li usa per il registro
  # opzioni: il target CMake `gmbnative` li compila DENTRO (vedi gmb_compiler_c/CMakeLists.txt);
  # il link manuale del gate deve fare lo stesso, altrimenti "_gmb_opt_env non definito".
  # Stesso motivo per `gmb_first_use_spawn.c`: il driver chiama `gmb_first_use_spawn_if_needed`
  # (primo uso delle librerie/toolchain) e senza quel sorgente il gate non linka
  # (`_gmb_first_use_spawn_if_needed` undefined).
  cc "$DRIVER_SRC" \
     "$ROOT/native/gmb_runtime_c/src/gmb_opts.c" \
     "$ROOT/native/gmb_runtime_c/src/gmb_paths.c" \
     "$ROOT/native/gmb_runtime_c/src/gmb_abi.c" \
     "$ROOT/native/gmb_runtime_c/src/gmb_first_use_spawn.c" \
     $INC_C $INC_RT "$HOST_BUILD/libgmb_compiler_c.a" -o "$DRV" || exit 1
fi

# incExtra/ext (stesso setup del gate C99)
# Terze parti: SOLO dalla CACHE del RID (`gmb install --runtime-only` / `--dev`). Nessun path
# del builder: renderebbe gli eseguibili dipendenti da una cartella che esiste solo qui.
# L'indice TSV (`<bin>.libs.txt`) è lo STESSO di `gmb_c99native_run.sh` (una sola implementazione):
# serve al download on-demand delle lib che non stanno più nel repo (le nostre FFI, release `ffi-v1`).
. "$MONO/tools/sh/libs_index_lib.sh"
RID="$TARGET_RID"
li_init
LIBS_CACHE="$HOME/.gmbasic/libs/$RID"
ZSTD_INC="$LIBS_CACHE/include"
# Sistema + terze parti dal resolver (F5): prima `-lcurl -lz -lbz2 -lsqlite3` erano cablati e
# brotli/pcre2/SDL/crypto si aggiungevano solo se esisteva il file `.dylib` (nome macOS nel test).
EXT="${LS_SYS[*]} ${LS_THIRD[*]}"
INC_EXTRA="-I$ROOT/native/gmb_runtime_c/src"
if [ -d "$LIBS_CACHE/include/SDL2" ] || [ -f "$LIBS_CACHE/libcrypto.$LS_DYLIBEXT" ]; then
  INC_EXTRA="$INC_EXTRA -I$LIBS_CACHE/include"
fi

# ── EXPORT dei simboli che le NOSTRE dylib cercano a load-time ───────────────────────────────
# Stessa regola di `tools/sh/gmb_c99native_run.sh` (una sola regola, due runner). Le dylib AI sono
# linkate con `-undefined dynamic_lookup`: non importano il core, lo risolvono quando dyld le carica,
# e chi glielo fornisce è la TABELLA DEGLI EXPORT dell'eseguibile. Su Darwin ld64 li esporta da sé
# mentre lld di `zig cc` dead-strippa i simboli che nulla referenzia (stub NULL → crash in un
# inizializzatore, prima di `main`); su LINUX senza `--export-dynamic` l'eseguibile non li esporta
# affatto — qui mancava del tutto, quindi i MiniTest AI su linux-x64 linkavano e morivano all'avvio.
# Si forzano SOLO i 4 simboli ABI (`libs_exports_file.sh abi`), non gli import di tutte le dylib:
# `-u` trattiene l'oggetto che definisce il simbolo, e la lista piena infilava oggetti AI/grafici
# in ogni eseguibile (misurato: 198 KB → 594 KB su un `PRINT`).
EXPORT_FLAGS=()
EXPORT_SYMS_FILE=""; EXPORT_SYMS_TMP=0; EXPORT_GATE=0
# Il flag dipende dall'OS di DESTINAZIONE (F5: con `--rid linux-x64` da macOS serve
# `--export-dynamic`, che su Darwin non esiste), non da `uname` dell'host.
case "$LS_OS" in
  Linux)
    EXPORT_FLAGS=(-Wl,--export-dynamic) ;;
  Darwin)
    if command -v dyld_info >/dev/null 2>&1; then
      EXPORT_SYMS_FILE="$(mktemp "${TMPDIR:-/tmp}/gmbexports.XXXXXX")"; EXPORT_SYMS_TMP=1
      # SOLO l'ABI minima (4 simboli), non l'unione degli import di tutte le dylib: `-u`
      # obbliga a TENERE l'oggetto che definisce il simbolo, quindi la lista piena ficcava
      # oggetti AI (e grafici) in ogni eseguibile — misurato: 198 KB → 594 KB su `PRINT "ciao"`.
      bash "$MONO/tools/sh/libs_exports_file.sh" abi > "$EXPORT_SYMS_FILE"
      while IFS= read -r _s; do EXPORT_FLAGS+=("-Wl,-u,$_s"); done < "$EXPORT_SYMS_FILE"
    else
      echo "test_minitests_c99native: dyld_info assente — export dell'ABI minima (llmdesc) non forzato" >&2
    fi
    ;;
esac

# ── broker pub/sub: lo avvia e lo ferma il GATE (vedi tools/sh/msg_broker.sh) ──────────────
# I MiniTest tcp aprono un broker esterno: senza, falliscono con "timeout" per un prerequisito
# che non è il codice in prova. Le porte si leggono dai `tcp://` loopback dei file selezionati.
BROKER_STARTED=()
broker_cleanup() {
  local p
  for p in ${BROKER_STARTED[@]+"${BROKER_STARTED[@]}"}; do
    "$MONO/tools/sh/msg_broker.sh" release "$p" >/dev/null 2>&1
  done
}

WORK="$(mktemp -d /tmp/minitests_c99native.XXXXXX)"
# ── CWD PULITA PER CASO ────────────────────────────────────────────────────
# Ogni MiniTest gira nella SUA directory (i path relativi "work/…" e
# "../../samples/…" devono valere), ma i file che il caso CREA non devono finire
# nei sorgenti: un artefatto lasciato da un caso (es. shared/minitests/ai/x)
# faceva fallire i gen_AI_* al giro successivo. La cwd e' quindi uno SPECCHIO in
# $WORK con la STESSA struttura di path — antenati come directory reali con i
# fratelli symlinkati (cosi' ".." e "../.." restano identici), file dei test come
# CLONI copy-on-write (contenuto identico, ma una scrittura del caso non tocca il
# sorgente) e sottodirectory reali: tutto cio' che il caso scrive nasce in $WORK e
# sparisce con il caso. Lo specchio si costruisce una volta per directory e fra un
# caso e l'altro viene riportato allo stato iniziale (niente residui da un caso al
# successivo). I sorgenti non si toccano.
# Copia specchio della directory del caso: UN clone ricorsivo (`cp -cR`), non una `cp` per voce.
# Misurato su `ai` (447 file): 0,86 s di ciclo per-voce → 0,076 s per copia; su `misc` 0,157 → 0,017.
# `-c` è clonefile(2): il test legge il contenuto vero ma una sua SCRITTURA non tocca i sorgenti
# (con un symlink la toccava: un test ha riscritto shared/minitests/ai/app.settings.json). Dove il
# filesystem non clona, fallback `cp -Rp`: senza `-p` ogni file sembrerebbe toccato dal caso e il
# ripristino ri-clonerebbe tutto a ogni test. Verificato con `diff -r` e `stat` su misc e ai:
# contenuto identico al vecchio specchio e ai sorgenti, mtime dei FILE identiche a entrambi;
# le sole mtime diverse sono quelle delle DIRECTORY, che anche il vecchio `mkdir -p` scriveva
# all'ora della copia (e comunque prima del TIMBRO, quindi il cancello del ripristino non scatta).
mirror_case_files() {   # $1 = dir reale da specchiare, $2 = dir reale di destinazione (deve esistere)
    cp -cR "$1/." "$2/" 2>/dev/null || cp -Rp "$1/." "$2/"
}
# Riporta la copia specchio allo stato dei sorgenti fra un caso e il successivo.
# "Toccato" = mtime più recente del TIMBRO, e `find -newer` lo vede al NANOSECONDO (a differenza
# di `[ -nt ]`, che confronta al secondo e perderebbe una riscrittura nello stesso secondo).
# Il primo `find` è un CANCELLO che esce al primo elemento nuovo (`-print -quit`): il caso quasi
# mai tocca la sua directory, e allora si paga un solo `find` invece di due passate + elenco —
# misurato 3,5 ms/caso su misc e 4,9 su ai, contro 8,2 e 19,0 della versione a tre passate.
# Anche una CANCELLAZIONE passa il cancello: togliere un file aggiorna l'mtime della directory
# che lo conteneva, e la directory è fra gli elementi visti da `-newer`.
reset_case_dir() {      # $1 = dir del caso nei sorgenti, $2 = copia specchio, $3 = timbro, $4 = elenco relativo
    local x rel
    [ -d "$2" ] || return 0
    [ -n "$(find "$2" -mindepth 1 -newer "$3" -print -quit 2>/dev/null)" ] || return 0
    # una sola passata, in `-depth`: i figli prima della directory, che così è già vuota
    find "$2" -depth -mindepth 1 -newer "$3" 2>/dev/null | while IFS= read -r x; do
        if [ -d "$x" ] && [ ! -L "$x" ]; then rmdir "$x" 2>/dev/null; continue; fi
        rel="${x#"$2"/}"
        if [ -f "$1/$rel" ] && [ ! -L "$1/$rel" ]; then
            rm -f "$x"; cp -c "$1/$rel" "$x" 2>/dev/null || cp -p "$1/$rel" "$x"
        else
            rm -f "$x"
        fi
    done
    # cancellati dal caso: l'elenco dice cosa DEVE esistere nello specchio
    while IFS= read -r rel; do
        [ -n "$rel" ] || continue
        [ -e "$2/$rel" ] && continue
        case "$rel" in */*) mkdir -p "$2/${rel%/*}" ;; esac
        cp -c "$1/$rel" "$2/$rel" 2>/dev/null || cp -p "$1/$rel" "$2/$rel"
    done < "$4"
}
prepare_case_cwd() {    # $1 = dir assoluta del MiniTest; imposta CASE_CWD
    local src="$1" rest cur dst comp e b
    case "$src" in
        "$MONO"/*) rest="${src#"$MONO"/}" ;;
        *) CASE_CWD="$src"; return 0 ;;   # fuori dal monorepo: si gira dove si e'
    esac
    cur="$MONO"; dst="$WORK/casecwd"
    # Stessa directory del caso precedente: lo specchio e' gia' pronto (ricostruirlo costa
    # ~0,6 s/caso fra cloni e antenati) → basta riportarlo allo stato iniziale.
    if [ "${PREP_SRC:-}" = "$src" ] && [ -d "$dst/$rest" ]; then
        reset_case_dir "$MONO/$rest" "$dst/$rest" "$WORK/casecwd.stamp" "$WORK/casecwd.files"
        CASE_CWD="$dst/$rest"; return 0
    fi
    PREP_SRC="$src"
    rm -rf "$dst"; mkdir -p "$dst"
    while [ -n "$rest" ]; do
        comp="${rest%%/*}"
        case "$rest" in */*) rest="${rest#*/}" ;; *) rest="" ;; esac
        [ "$comp" = ".." ] && break
        for e in "$cur"/* "$cur"/.[!.]*; do
            [ -e "$e" ] || [ -L "$e" ] || continue
            b="${e##*/}"
            [ "$b" = "$comp" ] && continue
            ln -sfn "$e" "$dst/$b"
        done
        cur="$cur/$comp"; dst="$dst/$comp"; mkdir -p "$dst"
    done
    mirror_case_files "$cur" "$dst"
    # Stato del ripristino: il TIMBRO dice cosa il caso ha toccato, l'ELENCO cosa deve esistere
    # (per ripristinare i file cancellati). Path relativi alla foglia dello specchio.
    touch "$WORK/casecwd.stamp"
    ( cd "$dst" && find . -mindepth 1 \( -type f -o -type l \) | sed 's|^\./||' ) > "$WORK/casecwd.files"
    CASE_CWD="$dst"
}
trap 'rm -rf "$WORK"; [ "$EXPORT_SYMS_TMP" = 1 ] && rm -f "$EXPORT_SYMS_FILE" "$EXPORT_SYMS_FILE.m"; broker_cleanup' EXIT
pass=0; fail=0; skip=0
# Il runtime C e' compilato UNA volta per invocazione in una static library, poi ogni
# MiniTest linka solo il proprio out.c (prima il runtime veniva ricompilato per ogni test).
# ── Cache della static library del runtime ────────────────────────────────────────────────
# Prima il runtime (≈60 sorgenti C) veniva ricompilato a OGNI invocazione: con un sample alla
# volta significava minuti per test. Ora la libreria è in una cache in /tmp, invalidata SOLO se
# cambia un sorgente o gli header (hash di mtime+percorso). Il flag GMB_RT_REBUILD=1 la forza.
# …e la CARTELLA è per-RID (2026-11-12). Prima era una sola per host e per cross: lo STAMP
# distingueva i due mondi, ma lo stesso path no — un run host (o un'altra sessione) che partiva
# mentre un cross era in corso SOVRASCRIVEVA `librt.a` con oggetti arm64 Mach-O. Sintomo: il
# cross «linka» e il linker dichiara undefined OGNI simbolo del runtime (`gmb_print_stage_end`,
# `gmb_ffi_dl_sym`, …), perché i nomi Mach-O hanno l'underscore iniziale e non corrispondono.
# Con la cartella per RID i due build non si toccano più.
RT_CACHE_DIR="${TMPDIR:-/tmp}/gmb_c99native_rt_cache/$TARGET_RID"
# FILE per-COMPILATORE, con i nomi SENZA suffisso per il canonico (zig). Prima c'era un solo
# `librt.a` con lo STAMP che includeva `cc=$FC`: alternare zig e cc (gamba A/B) invalidava e
# SOVRASCRIVEVA la cache dell'altro — 395 sorgenti ricompilati a ogni cambio (~4 min).
# Ora `librt.a` è l'archivio zig, e siccome è anche il nome cercato dal cross
# (`gmb_c99native_run.sh`) non serve nessuna copia-alias; la gamba A/B usa `librt.<tag>.a` e
# non tocca il canonico. Il tag è un hash della stringa di `--cc`: stabile fra invocazioni
# identiche.
case "${FC%% *}" in
  zcc|zig|*/zcc|*/zig) RT_CACHE="$RT_CACHE_DIR/librt.a";         RT_STAMP="$RT_CACHE_DIR/src.stamp" ;;
  *)        RT_TAG="$(printf '%s' "$FC" | shasum | cut -c1-8)"
            RT_CACHE="$RT_CACHE_DIR/librt.$RT_TAG.a"; RT_STAMP="$RT_CACHE_DIR/src.$RT_TAG.stamp" ;;
esac
# Gli HEADER contano: prima la cache era invalidata solo dai .c, quindi una modifica a un header
# (es. gmb_runtime.h, dove vive ogni prototipo gmb_*) lasciava in cache un runtime compilato con
# le vecchie dichiarazioni → simboli/ABI stantii in silenzio. Sono le -I usate qui sotto.
# NB: `native/gmb_tokenizer_bpe` NON esiste più (tokenizer in LLMEnv/LLMToken, già in LLM_INC):
# tenerlo qui non copriva nulla e lasciava fuori dallo STAMP gli header del tokenizer.
RT_HDR_DIRS="$ROOT/native/gmb_runtime_c/include $ROOT/native/gmb_runtime_c/src $ROOT/native/gmb_chart/include $ROOT/native/gmb_agent_runtime $ROOT/native/gmb_doc_c/include $ROOT/native/gmb_db_c/include $ROOT/native/gmb_torch/include $LLMENV/LLMToken"
RT_HDRS="$(find $RT_HDR_DIRS -type f -name '*.h' 2>/dev/null | tr '\n' ' ')"
# STAMP = HASH DEL CONTENUTO (non mtime): una cache basata sui timestamp può servire codice che
# nei sorgenti non esiste più — caso reale 2026-10-28: una stampa di debug `[GFX-LOAD] …`
# (simbolo `gmb_graphics_trace_load`) rimasta in un oggetto in cache mentre nei sorgenti era già
# stata rimossa → ogni MiniTest C99Native stampava quella traccia, invisibile con `grep` sul codice.
# Con l'hash del contenuto, qualunque modifica (anche un revert nello stesso secondo) invalida la cache.
# I FLAG di compilazione fanno parte della cache: senza, cambiare -DGMB_WITH_UI (o OpenSSL/ZSTD)
# riuserebbe un archivio costruito con un'altra configurazione.
# La cache è PER-TARGET: gli stessi sorgenti compilati per un altro RID (`--rid`/`--target`) o con
# un altro compilatore non sono riusabili (sarebbero oggetti dell'host dentro un link cross).
# `zflags` = i flag INTERNI del wrapper (`zcc --print`): `cc=$FC` copre il percorso, non ciò che
# il wrapper aggiunge. Senza, cambiare le flag di zcc (SDK, `-include`, pavimento) lasciava in
# cache oggetti costruiti con le vecchie — misurato il 13/11: la build "verde" era con oggetti
# vecchi, è servito GMB_RT_REBUILD=1 per accorgersene.
# Identità del compilatore, UNA volta per entrambi gli usi: nello stamp (cambiare zcc o aggiornare
# zig deve invalidare) e nella chiave della directory oggetti. `--print` dà il percorso di zig, che
# porta la versione nella directory; per `cc` (che `--print` non ce l'ha) vale `--version`.
RT_CC_ID="$("$FC" --print 2>/dev/null || { "$FC" --version 2>/dev/null | head -1; })"
rt_stamp_hash() {       # hash del contenuto: un `shasum` per BLOCCO (xargs), non uno per file
    ( printf '%s\n' "GMB_WITH_UI=1 HAVE_OPENSSL GMB_PARQUET_HAVE_ZSTD rid=$TARGET_RID tf=$TF cc=$FC zflags=$RT_CC_ID"
      printf '%s\n' $RT_SRCS $RT_HDRS | xargs shasum -a 1 2>/dev/null ) | shasum | cut -c1-16
}
# La validità la decide l'HASH DEL CONTENUTO, senza cancello sull'mtime: in blocco (`xargs`) i
# 552 sorgenti+header costano 0,04 s — meno di quanto rendeva il `find -newer` su 9 directory
# (0,00 s) che questa versione aveva, e senza il suo punto debole: un file ripristinato con mtime
# più vecchia del timbro non apriva il cancello e restava in cache. L'mtime non è mai l'autorità.
# ── Cache PER-OGGETTO ─────────────────────────────────────────────────────────────────────────
# Chiave di una unità = contenuto del SORGENTE (nome dell'oggetto) + flag + identità del
# compilatore + contenuto degli HEADER (directory che porta la chiave). Così toccare un `.c`
# ricompila UNA unità su 395, mentre un header toccato, un flag cambiato o un aggiornamento di zig
# invalidano la directory intera — stessa sicurezza di prima, granularità più fine dove serve.
# `RT_UNIT_FLAGS` è UNA stringa: la stessa va nella chiave e nella riga di compilazione, così non
# possono divergere.
RT_UNIT_FLAGS="$TF $INC_RT -I$INC_CHART -I$ROOT/native/gmb_runtime_c/build -I$ROOT/native/gmb_agent_runtime -I$ROOT/native/gmb_doc_c/include -I$ROOT/native/gmb_db_c/include -I$ROOT/native/gmb_torch/include $LLM_INC -I$ZSTD_INC $CODEC_INC $INC_EXTRA -O2 -ffunction-sections -fdata-sections -w -ffp-contract=off -DHAVE_OPENSSL -DGMB_PARQUET_HAVE_ZSTD -DGMB_WITH_UI=1"
mkdir -p "$RT_CACHE_DIR"
STAMP="$(rt_stamp_hash)"
if [ "${GMB_RT_REBUILD:-}" != "1" ] && [ -f "$RT_CACHE" ] && [ -f "$RT_STAMP" ] && [ "$(cat "$RT_STAMP")" = "$STAMP" ]; then
  echo "runtime C: cache valida ($RT_CACHE)"
  RT_LIB="$RT_CACHE"
else
  # Identità del compilatore (già in $RT_CC_ID): la chiave cambia con zcc e con la versione di zig.
  RT_OBJ_KEY="$( ( printf '%s\n%s\n' "$RT_UNIT_FLAGS" "$RT_CC_ID"; printf '%s\n' $RT_HDRS | xargs shasum -a 1 2>/dev/null ) | shasum | cut -c1-16 )"
  RT_OBJ_DIR="$RT_CACHE_DIR/obj/$RT_OBJ_KEY"
  mkdir -p "$RT_OBJ_DIR"
  echo "runtime C: ricostruisco l'archivio (cache per-oggetto)..."
  # Una sola passata di `shasum` per TUTTI i sorgenti (xargs): 395 fork in meno, e l'ordine
  # delle righe è quello di $RT_SRCS, che è anche l'ordine dei membri nell'archivio.
  printf '%s\n' $RT_SRCS | xargs shasum -a 1 2>/dev/null > "$WORK/rt_shasums"
  RT_N=0; RT_COMPILED=0; OBJS=""
  while read -r h s; do
    RT_N=$((RT_N+1))
    o="$RT_OBJ_DIR/$h.o"
    if [ "${GMB_RT_REBUILD:-}" = "1" ] || [ ! -f "$o" ]; then
      $FC -c "$s" -o "$o.$$.tmp" $RT_UNIT_FLAGS || { rm -f "$o.$$.tmp"; exit 1; }
      mv "$o.$$.tmp" "$o"
      RT_COMPILED=$((RT_COMPILED+1))
    fi
    OBJS="$OBJS $o"
  done < "$WORK/rt_shasums"
  echo "runtime C: compilate $RT_COMPILED di $RT_N unità"
  $AR_CMD rcs "$RT_CACHE.tmp" $OBJS && mv "$RT_CACHE.tmp" "$RT_CACHE"
  echo "$STAMP" > "$RT_STAMP"
  RT_LIB="$RT_CACHE"
fi
# I MiniTest cambiano posto fra i due repository: nella radice di GMBasic in quello originale,
# in `shared/minitests` nel monorepo (fratello di `GMBasic/`). Si prende il primo che esiste,
# così lo STESSO script vale in entrambi senza flag. GMB_MINI_ROOT forza una radice diversa.
MINI="${GMB_MINI_ROOT:-}"
if [ -z "$MINI" ]; then
  for cand in "$ROOT/MiniTests" "$ROOT/../shared/minitests"; do
    [ -d "$cand" ] && { MINI="$(cd "$cand" && pwd)"; break; }
  done
fi
[ -n "$MINI" ] || {
  echo "MiniTest non trovati: attesi in $ROOT/MiniTests o $ROOT/../shared/minitests (o in GMB_MINI_ROOT)"; exit 1;
}
echo "MiniTest: $MINI"
echo "Compilatore: $FC"
# Rumore diagnostico del motore MLX: prefissi in UNA fonte di verità (`tests/engine_noise_prefixes.txt`
# nel repo originale, `GMBasicSharp/tests/` nel monorepo — la stessa lista dell'xUnit).
NOISE_FILE="${GMB_NOISE_FILE:-}"
if [ -z "$NOISE_FILE" ]; then
  for cand in "$ROOT/tests/engine_noise_prefixes.txt" "$ROOT/../GMBasicSharp/tests/engine_noise_prefixes.txt"; do
    [ -f "$cand" ] && { NOISE_FILE="$cand"; break; }
  done
fi
[ -n "$NOISE_FILE" ] && [ -f "$NOISE_FILE" ] || echo "attenzione: engine_noise_prefixes.txt assente, nessun filtro del rumore del motore" >&2

# Filtro ambientale: come l'harness xUnit, GMB_MINI_ONLY accetta UNA o PIÙ sottostringhe
# separate da virgola (match ANY). Prima era confrontato con la variabile INTERA: con
# GMB_MINI_ONLY="a.bas,b.bas" nessun file corrispondeva, la gamba non eseguiva NULLA e
# stampava `PASS=0 FAIL=0` con exit 0 — un FALSO VERDE (le altre tre gambe erano passate),
# osservato il 2026-10-29 lanciando due file in una sola invocazione.
ONLY_NEEDLES=()
if [ -n "${GMB_MINI_ONLY:-}" ]; then
  IFS=',' read -r -a _raw_needles <<< "$GMB_MINI_ONLY"
  for _n in "${_raw_needles[@]}"; do
    _n="${_n#"${_n%%[![:space:]]*}"}"; _n="${_n%"${_n##*[![:space:]]}"}"
    [ -n "$_n" ] && ONLY_NEEDLES+=("$_n")
  done
fi
ONLY_MATCHED=0

# Broker delle porte richieste dai file selezionati (tutti, se non c'è filtro).
BROKER_SH="$MONO/tools/sh/msg_broker.sh"
if [ -x "$BROKER_SH" ]; then
  if [ ${#ONLY_NEEDLES[@]} -gt 0 ]; then
    _bports="$("$BROKER_SH" ports "${ONLY_NEEDLES[@]}" 2>/dev/null)"
  else
    _bports="$("$BROKER_SH" ports 2>/dev/null)"
  fi
  for _bp in $_bports; do
    _bres="$("$BROKER_SH" ensure "$_bp" 2>/dev/null)" || _bres=failed
    case "$_bres" in
      started) BROKER_STARTED+=("$_bp"); echo "broker pub/sub avviato dal gate su :$_bp" ;;
      already) echo "broker pub/sub già attivo su :$_bp (lo lascio a chi l'ha avviato)" ;;
      *)       echo "attenzione: broker non avviabile su :$_bp" >&2 ;;
    esac
  done
fi

for f in "$MINI"/**/*.bas "$MINI"/*.bas; do
  # Filtro (lista di sottostringhe, match ANY): conta anche i file poi saltati per TAG, così
  # un filtro che punta a un interattivo/heavy resta legittimo e non diventa "filtro errato".
  if [ ${#ONLY_NEEDLES[@]} -gt 0 ]; then
    _hit=0
    for _n in "${ONLY_NEEDLES[@]}"; do [[ "$f" == *"$_n"* ]] && { _hit=1; break; }; done
    [ "$_hit" = 1 ] || continue
    ONLY_MATCHED=$((ONLY_MATCHED+1))
  fi
  # INTERATTIVI (marker header `' TAG: interactive`): esclusi di default; inclusi con GMB_RUN_INTERACTIVE=1.
  if [ "${GMB_RUN_INTERACTIVE:-0}" != "1" ] && grep -q "^' TAG: interactive" "$f" 2>/dev/null; then skip=$((skip+1)); continue; fi
  # HEAVY (marker header `' TAG: heavy`): richiede modello reale + training; escluso di default.
  if [ "${GMB_RUN_HEAVY:-0}" != "1" ] && grep -q "^' TAG: heavy" "$f" 2>/dev/null; then skip=$((skip+1)); continue; fi
  # gen_AI_*: campioni di COPERTURA SIMBOLO generati; le loro EXPECT catturano STATO di
  # macchina/sessione (`AI.BRAINUSED` = brain usati nel processo, `AI.PROVIDERS` = provider
  # configurati, `AI.VAULTLIST` = vault creati dai test precedenti, `AI.COUNT` = documenti
  # indicizzati). Non esiste un oracolo unico: si escludono come nel cross-leg xUnit
  # (IsParityExcluded, stesso criterio di gen_BROWSER_*). La copertura del simbolo resta
  # garantita dal census.
  case "$(basename "$f")" in gen_AI_*) skip=$((skip+1)); continue ;; esac
  [ -f "$f" ] || continue
  name="${f#$MINI/}"
  if ! "$DRV" "$f" "$WORK/out.c" --no-exe >/dev/null 2>"$WORK/derr.txt"; then
    # MiniTest NEGATIVO di compilazione (`' EXPECT: ERROR: ...`): il driver DEVE rifiutare il sorgente. Il testo esatto del
    # messaggio differisce fra parser C# e parser C, quindi qui conta che l'errore ci sia (e che il driver non vada in HANG).
    if grep -m1 -q "^' EXPECT: ERROR:" "$f" 2>/dev/null; then
      echo "PASS $name :: (errore di compilazione atteso) $(head -1 "$WORK/derr.txt" | head -c 100)"; pass=$((pass+1)); continue
    fi
    # DIPENDENZA ESTERNA ASSENTE, dichiarata nel file (`' TAG: unsupported-c99native`): i test
    # che fanno `REQUIRE "<pacchetto>"` non sono verificabili senza il pacchetto installato.
    # SKIP DICHIARATO (contato a parte), NON un rosso: un pacchetto assente non è un difetto
    # del backend. Il marker da solo non basta: serve ANCHE l'errore "non trovato" del driver,
    # così un fallimento diverso resta un FAIL.
    if grep -q "^' TAG: unsupported-c99native" "$f" 2>/dev/null && grep -q "non trovato" "$WORK/derr.txt"; then
      echo "SKIP $name (dipendenza esterna assente: $(head -1 "$WORK/derr.txt" | head -c 90))"; skip=$((skip+1)); continue
    fi
    echo "FAIL $name (driver: $(head -1 "$WORK/derr.txt"))"; fail=$((fail+1)); continue
  fi
  # Solo i test CUA/browser/computer/agent_loop necessitano di gmb_agent_runtime: lo si linka
  # solo se il C generato referenzia quei simboli (evita ricompilare agent_runtime per tutti).
  # F2 multimodale (2026-09-11): AI.DOCEXTRACT chiama gmb_llm_complete -> gmb_agent_ask ->
  # gmb_brain_ask_sync (definito in gmb_agent_runtime/gmb_agent_loop.c): senza questi
  # sorgenti il link fallisce.
  AGENT=""
  # gmb_agent_run_named (AI.AGENTRUN/AGENTRUNGRAPH/AGENTRUNRAG) vive in gmb_agent_runtime
  # (gmb_agent_loop.c) ma il C GENERATO lo nomina senza 'gmb_agent_loop' → senza questa voce
  # il link fallisce con 'call to undeclared function'.
  if [ "$LS_AGENT" = 1 ] && grep -qE 'gmb_cua_|gmb_browser_|gmb_computer_|gmb_ax_|gmb_agent_loop|gmb_agent_run_named|tool_search|gmb_cdp_|gmb_desktop_|screenshot|llm_|gmb_docextract_json' "$WORK/out.c" 2>/dev/null; then
    AGENT="$AGENT_SRCS"
  fi
  # Fuori da Darwin `gmb_agent_runtime` non compila affatto: `gmb_ax_mac.c` e
  # `gmb_computer_provider_mac.c` includono `<ApplicationServices/…>` (CMake li mette solo
  # nel ramo APPLE). `LS_AGENT` è 0 per linux-*/win-* e il resolver lo dice: senza questo
  # gate il cross di un MiniTest qualunque moriva su quell'include, non sul codice in prova.
  # B2: AI VERIFY COMPILE nel mondo C → serve il compilatore C (gmb_compile_bas_file).
  COMPILER=""
  # gmb_observe_test (AI OBSERVE TEST) e gmb_verify_require usano gmb_compile_bas_file
  # come gmb_verify_run: senza libgmb_compiler_c.a il link fallisce con
  # "undefined _gmb_compile_bas_file, referenced from _gmb_observe_test".
  if grep -qE 'gmb_verify_run|gmb_verify_require|gmb_observe_test' "$WORK/out.c" 2>/dev/null; then
    COMPILER="$ROOT/native/gmb_compiler_c/build/libgmb_compiler_c.a"
  fi
  # DB: il C generato per gli statement/funzioni DBF-ISAM usa il runtime Commercial
  # (native/gmb_db_c + libgmb_db): include e libreria vanno aggiunti qui (i sample DB
  # fallivano con "call to undeclared function gmb_db_dbf_*").
  DB_LIB="$ROOT/native/gmb_db_c/build/libgmb_db.a"
  DB_INC="-I$ROOT/native/gmb_db_c/include -I$ROOT/native/gmb_torch/include -I$ROOT/native/gmb_doc_c/include"
  # F2 multimodale (2026-09-11): AI.DOCFIELDS/DOCEXTRACT emettono gmb_docfields_json/
  # gmb_docextract_json che chiamano gmb_doc_extract (gmb_doc_c, fuori da librt.a) —
  # sorgenti compilati solo se referenziati (stesso pattern del blocco AGENT sopra).
  DOC_SRCS=""
  # gmb_agent_ask_file (AI.AGENTASKFILE) vive in librt.a ma CHIAMA gmb_doc_extract
  # (gmb_doc_c) per i PDF: senza i sorgenti doc il link fallisce con un simbolo mancante
  # che punta a gmb_agent_ask_file. Anche questo caso va coperto dalla condizione.
  if grep -qE 'gmb_doc_|gmb_docfields_json|gmb_docextract_json|gmb_agent_ask_file' "$WORK/out.c" 2>/dev/null; then
    DOC_SRCS="$ROOT/native/gmb_doc_c/src/gmb_doc.c $ROOT/native/gmb_doc_c/src/gmb_doc_pdf.c $ROOT/native/gmb_doc_c/src/gmb_doc_ocr.c"
  fi
  # TORCH: il loader C (dlopen dell'host ML) NON sta in librt.a — lo script diretto
  # (gmb_c99native_run.sh) lo compila insieme al programma. Senza questo blocco ogni
  # MiniTest TORCH.* falliva al link con `_gmb_ml_tensor_*` indefiniti (relu: il C emesso
  # era corretto, mancava solo gmb_torch.o). Condizionale: chi non usa TORCH non lo paga.
  TORCH_SRCS=""
  if grep -q 'gmb_ml_' "$WORK/out.c" 2>/dev/null; then
    TORCH_SRCS="$ROOT/native/gmb_torch/src/gmb_torch.c"
    [ -f "$ROOT/native/gmb_torch/src/gmb_torch_str.c" ] && TORCH_SRCS="$TORCH_SRCS $ROOT/native/gmb_torch/src/gmb_torch_str.c"
  fi
  # TRAY: le funzioni gmb_tray_* vere vivono nella dylib CONDIVISA (target CMake gmb_tray: Cocoa su
  # macOS, Win32 su Windows). In librt.a entra solo il `gmb_tray.c` compilato SENZA
  # GMB_TRAY_COCOA — quello che questo script compila nel glob di `src/*.c`: il suo
  # `gmb_tray_backend()` risponde "none" e ogni chiamata è un no-op. La gamba nativa divergeva
  # così da IL/VM-C (`backend=macos`, `available=-1`) e il MiniTest passava lo stesso, perché il
  # suo oracolo è cross-leg (con tutte le gambe a "none" non c'è niente da confrontare).
  # La dylib va PRIMA di librt.a: l'archivio estrae un membro solo se un simbolo è ancora
  # indefinito, quindi con la dylib davanti lo stub non entra nel binario. Solo se il C generato la
  # usa: un MiniTest testuale non paga la dipendenza (stesso criterio di AGENT/DOC/TORCH).
  TRAY_IN=()
  if grep -q 'gmb_tray_' "$WORK/out.c" 2>/dev/null; then
    cmake --build "$ROOT/native/gmb_runtime_c/build" --target gmb_tray -j4 >/dev/null 2>&1 || true
    TRAY_DYLIB="$LIBS_CACHE/libgmb_tray.$LS_DYLIBEXT"
    [ -f "$TRAY_DYLIB" ] || TRAY_DYLIB="$ROOT/build/libs/$RID/libgmb_tray.$LS_DYLIBEXT"
    if [ -f "$TRAY_DYLIB" ]; then
      TRAY_IN=( "$TRAY_DYLIB" -Wl,-rpath,"$(dirname "$TRAY_DYLIB")" )
    else
      echo "test_minitests_c99native: libgmb_tray.$LS_DYLIBEXT assente (target gmb_tray non costruito): resta il backend none di librt.a" >&2
    fi
  fi
  # MODEL I/O + plugin/model_desc + tokenizer: `gmb_llm_model_convert` (e il resto del namespace
  # LLM) vivono nel progetto separato gmb_model_io, che il C99Native deve linkare
  # (il C generato per `LLM MODEL CONVERT` li chiama). Prebuilt come db/moe/codec.
  MIO=( "$ROOT/native/gmb_runtime_c/build/gmbllm_build/libgmbllm_train.a" \
        "$ROOT/native/gmb_runtime_c/build/gmbllm_build/libgmbllm_core.a" )
  PLG="$ROOT/native/gmb_runtime_c/build/llmengine_plugin_build/libllmengine_plugin.a"
  MDS="$ROOT/native/gmb_runtime_c/build/llmdesc_build/libllmdesc.a"
  # Pila LLM dell'host: solo per il RID nativo (`LS_LLM`, da gmb_link_set.sh). Per un altro RID
  # llmtoken/llmcodec_*/gmbllm* sono archivi dell'host e il loro errore di link nasconde quello
  # vero: si omettono e si dichiara.
  LLM_STATIC=(); LLM_CODEC_FLAGS=""
  if [ "$LS_LLM" = 1 ]; then
    LLM_STATIC=( "$MOE_LIB" "${MIO[@]}" "$PLG" "$MDS" )
    TOK="$LIBS_CACHE/libllmtoken.$LS_DYLIBEXT"
    [ -f "$TOK" ] || TOK="$LLMENV/build/dist/osx-arm64/libllmtoken.dylib"
    LLM_CODEC_FLAGS="$CODEC_LIB $TOK -Wl,-rpath,$(dirname "$TOK")"
  else
    echo "test_minitests_c99native: llmtoken/llmcodec_* omesse per $TARGET_RID (pila LLM costruita per $LS_HOST_RID, LS_LLM=0)" >&2
  fi
  # Input e flag di link CONDIVISI fra l'eseguibile e la libreria condivisa: la lista era
  # duplicata (due copie da tenere allineate) e la gamba LIBRARY linkava per forza un binario.
  # Array (non stringa) perché il path di rpath può contenere spazi e perché $AGENT/$DOC_SRCS
  # sono già liste: nello stringone i confini dei token dipendevano dallo split implicito.
  LINK_IN=( ${TRAY_IN[@]+"${TRAY_IN[@]}"} "$RT_LIB" $AGENT $COMPILER "$DB_LIB" ${LLM_STATIC[@]+"${LLM_STATIC[@]}"} $DOC_SRCS $TORCH_SRCS )
  LINK_FLAGS=( $INC_RT -I"$ROOT/native/gmb_agent_runtime" -I"$LLMENV/LLMJinja" -I"$LLMENV/LLMEngine/mlx"
    -I"$ROOT/native/gmb_compiler_c/include" $CODEC_INC $DB_INC $LLM_INC $INC_EXTRA $FRAMEWORKS
    -lm -w -ffp-contract=off -DGMB_WITH_UI=1 $LS_STRIP $LLM_CODEC_FLAGS
    $EXT )
  # LIBRARY (marker header `' TAG: library`): il prodotto e' una LIBRERIA condivisa, e per
  # contratto NON ha entry point (Guide/utente/LIBRARY-gmblib-Guide.md §1). Linkare `-o bin`
  # falliva con `undefined _main` su un file che, per l'ABI, era corretto: il test non poteva
  # passare su NESSUN backend-eseguibile. Il verdetto giusto e' che la dylib compili E
  # esporti l'ABI documentata: `<lib>_init`/`<lib>_fini` (+ ctor/dtor) e `<lib>_<Proc>` per
  # ogni PUBLIC SUB/FUNCTION.
  if grep -q "^' TAG: library" "$f" 2>/dev/null; then
    if ! $FC $TF "$WORK/out.c" "${LINK_IN[@]}" "${LINK_FLAGS[@]}" -shared -fPIC -o "$WORK/lib.$LS_DYLIBEXT" 2>"$WORK/ccerr.txt"; then
      echo "FAIL $name (cc -shared: $(tail -3 "$WORK/ccerr.txt" | tr '\n' ' '))"; fail=$((fail+1)); continue
    fi
    lib="$(awk 'toupper($1)=="LIBRARY"{n=$2; gsub(/\"/,"",n); print n; exit}' "$f")"
    [ -n "$lib" ] || { echo "FAIL $name (ABI: nessun nome dopo LIBRARY)"; fail=$((fail+1)); continue; }
    procs="$(awk 'toupper($1)=="PUBLIC" && (toupper($2)=="FUNCTION" || toupper($2)=="SUB"){n=$3; sub(/\(.*/,"",n); print n}' "$f")"
    SYMS="$(nm $LS_NM_GU "$WORK/lib.$LS_DYLIBEXT" 2>/dev/null | awk '{print $NF}')"
    missing=""
    for want in "_${lib}_init" "_${lib}_fini" $(for p in $procs; do echo "_${lib}_$p"; done); do
      printf '%s\n' "$SYMS" | grep -qx "$want" || missing="$missing $want"
    done
    if [ -n "$missing" ]; then
      echo "FAIL $name (ABI: simboli non esportati:$missing)"; fail=$((fail+1)); continue
    fi
    if printf '%s\n' "$SYMS" | grep -qx "_main"; then
      echo "FAIL $name (ABI: una LIBRARY non deve avere main)"; fail=$((fail+1)); continue
    fi
    echo "PASS $name :: .gmblib '$lib' → $(echo $procs | wc -w | tr -d ' ') export ($(for p in $procs; do printf '%s ' "${lib}_$p"; done))"
    pass=$((pass+1)); continue
  fi
  # `EXPORT_FLAGS` SOLO sull'eseguibile: su `-shared` una `-u` verso un simbolo non definito lì
  # sarebbe un errore di link (la gamba LIBRARY resta com'era).
  if ! $FC $TF "$WORK/out.c" "${LINK_IN[@]}" "${LINK_FLAGS[@]}" ${EXPORT_FLAGS[@]+"${EXPORT_FLAGS[@]}"} -o "$WORK/bin" 2>"$WORK/ccerr.txt"; then
    echo "FAIL $name (cc: $(tail -3 "$WORK/ccerr.txt" | tr '\n' ' '))"; fail=$((fail+1)); continue
  fi
  # GATE EXPORT (una volta sola, al primo eseguibile): il link può riuscire e produrre un binario
  # che muore all'avvio, perché per le dylib conta ciò che l'eseguibile ESPORTA. Qui si verifica
  # PRIMA di eseguire, con i nomi dei simboli scoperti: un crash silenzioso in un inizializzatore
  # diventerebbe un FAIL inspiegabile del MiniTest.
  if [ "$EXPORT_GATE" = 0 ] && [ -n "$EXPORT_SYMS_FILE" ] && [ -s "$EXPORT_SYMS_FILE" ]; then
    if ! bash "$MONO/tools/sh/libs_exports_file.sh" verify "$WORK/bin" "$EXPORT_SYMS_FILE"; then
      echo "" >&2
      echo "ERRORE: l'eseguibile non esporta i simboli che le dylib cercano a load-time (elenco sopra)." >&2
      echo "  Un binario così muore nel costruttore della dylib, prima di \`main\`: si ferma il run invece" >&2
      echo "  di riportare FAIL incomprensibili. Rigenerare il bundle: tools/sh/libs_build_release.sh" >&2
      exit 1
    fi
    EXPORT_GATE=1
  fi
  # CROSS (F5): il binario per un altro RID si linka e si verifica, non si esegue — il loader
  # dell'host rifiuterebbe un ELF con un errore che non dice nulla sul codice BASIC.
  if [ "$TARGET_RID" != "$HOST_RID" ]; then
    echo "PASS $name :: (cross $TARGET_RID: linkato, non eseguito)"
    pass=$((pass+1)); continue
  fi
  # Il motore MLX (dlopen in LLM QUALITY/REGISTRY MEASURE) e' raggiungibile via loader path: senza,
  # le gambe C sono standalone e la PPL reale darebbe `ppl=na` (divergenza vs IL). I log engine
  # restano su stderr e vengono filtrati sotto, come gia' `LLM QUALITY:`.
  # `<bin>.libs.txt` accanto all'eseguibile: le lib dell'indice da cui dipende + le FFI dichiarate
  # (`DECLARE … LIB`). Il runtime C lo legge se una lib manca e la scarica (sha verificato).
  emit_exe_libs "$WORK/bin" "$WORK/bin.libs.txt" "$WORK/out.c" 2>/dev/null || true
  # CWD PULITA PER CASO: il binario NON gira nella dir dei sorgenti ma in uno specchio
  # dentro $WORK (prepare_case_cwd). I MiniTest si aspettano la loro directory (path
  # relativi "work/…" e "../../samples/…"), ma i file che CREANO (es. `x`, che poi faceva
  # fallire i gen_AI_*) restavano nei sorgenti e contaminavano i casi successivi.
  prepare_case_cwd "$(cd "$(dirname "$f")" && pwd)"
  if ! (cd "$CASE_CWD" && DYLD_LIBRARY_PATH="$ROOT/build/libs/$RID:$HOME/.gmbasic/libs/$RID${DYLD_LIBRARY_PATH:+:$DYLD_LIBRARY_PATH}" "$WORK/bin" >"$WORK/out.txt" 2>&1); then
    # TEST DI ERRORE ATTESO (marker header `' TAG: expected-error`): l'EXPECT descrive il
    # messaggio che DEVE comparire. Serve ai MiniTest che verificano un errore esplicito
    # (es. AI.DISCOVER su endpoint irraggiungibile): prima erano FAIL solo per l'exit != 0.
    # PASS solo con il messaggio giusto: un errore diverso resta un FAIL.
    if grep -q "^' TAG: expected-error" "$f" 2>/dev/null; then
      exp_e="$(grep -m1 "^' EXPECT: " "$f" | sed "s/^' EXPECT: //" | sed -e 's/[[:space:]]*$//' -e 's/^ERROR: *//')"
      norm_e="$(sed -E -e 's/^.*\[GMBASIC\] ERROR [0-9]+: *//' -e 's/ *\(line [0-9]+\)[[:space:]]*$//' "$WORK/out.txt" | grep -v '^[[:space:]]*$' | head -1)"
      if [ -n "$exp_e" ] && [ -n "$norm_e" ] && [ "$norm_e" = "$exp_e" ]; then
        echo "PASS $name :: $norm_e"; pass=$((pass+1)); continue
      fi
      echo "FAIL $name (expected-error: messaggio diverso da EXPECT)"
      echo "     EXPECT:   $exp_e"
      echo "     OTTENUTO: $norm_e"
      fail=$((fail+1)); continue
    fi
    # NESSUNO skip "di comodo": anche il gap dichiarato del backend C ("non disponibile nel
    # backend C99 headless") è un FAIL visibile — un esempio non verificabile è un gap reale,
    # non una regressione nascosta. (Stessa direttiva del gate C99Native.)
    echo "FAIL $name (run exit != 0): $(tail -1 "$WORK/out.txt" 2>/dev/null | head -c 120)"
    fail=$((fail+1)); continue
  fi
  # ORACOLO = IL MINITEST STESSO. Ogni MiniTest dichiara il proprio output atteso con
  #   ' EXPECT: <riga1>|<riga2>|...
  # (righe trimmate ai due estremi, righe vuote scartate, unite da '|' — la stessa
  # normalizzazione dell'harness xUnit). Senza questo confronto il runner verificava solo
  # l'exit code: un comando ignorato in silenzio risultava "PASS" pur divergendo (e' cosi'
  # che sono passati SEEK n,pos e GETFOLDERPATH = parentdir).
  # Rumore NATIVO su stderr (fuso in out.txt): log diagnostici del motore/tokenizer, non output
  # del programma. Già si filtrava `gmb_tokenizer_bpe_load:`; si filtrano anche i log di
  # llmtoken_load/LLM QUALITY (percorso NLL: modello assente -> diagnostica su stderr).
  # Rumore diagnostico del motore MLX: prefissi in UNA fonte di verita' (tests/engine_noise_prefixes.txt),
  # condivisa con l'xUnit. Filtro per PREFISSO SPECIFICO (mai "^[" generico: ci sono output legittimi
  # come "[-7]"/"[ 3.5]"/"[user: Ciao]").
  NOISE_RE=""
  [ -n "$NOISE_FILE" ] && [ -f "$NOISE_FILE" ] && \
    NOISE_RE="$(grep -vE '^[[:space:]]*(#|$)' "$NOISE_FILE" | sed -e 's/\[/\\[/g' -e 's/\]/\\]/g' | paste -sd'|' -)"
  NORM="$(perl -pe 's/\e\[[0-9;?]*[A-Za-z]//g' "$WORK/out.txt" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' | grep -v '^$' | grep -v '^gmb_tokenizer_bpe_load:' | grep -v '^llmtoken_load:' | grep -v '^LLM QUALITY:' | grep -v '^LLM PROFILE:')"
  # `grep -vE "^()"` (lista vuota) scarterebbe OGNI riga: il filtro si applica solo se la lista
  # esiste davvero. Senza questo, ogni confronto con EXPECT diventava un FAIL.
  if [ -n "$NOISE_RE" ]; then
    NORM="$(printf '%s\n' "$NORM" | grep -vE "^(${NOISE_RE})")"
  fi
  OUT="$(printf '%s\n' "$NORM" | tr '\n' '|' | sed 's/|$//')"
  EXPECT="$(grep -m1 "^' EXPECT: " "$f" | sed "s/^' EXPECT: //" | sed -e 's/[[:space:]]*$//')"
  if [ -n "$EXPECT" ] && [ "$OUT" != "$EXPECT" ]; then
    echo "FAIL $name (output != EXPECT)"
    echo "     EXPECT:   $EXPECT"
    echo "     OTTENUTO: $OUT"
    fail=$((fail+1)); continue
  fi
  # Salva il codice C generato per ispezione (verifica reale, non solo verdetto).
  # Nome UNICO per percorso: due test omonimi in domini diversi (`arrays/slice.bas` e
  # `matrix/slice.bas`) sovrascrivevano lo stesso `tools/out/c99native/slice.c` e chi
  # ispezionava il C poteva leggere quello dell'ALTRO test.
  CNAME="$(printf '%s' "${name%.bas}" | sed 's|/|__|g')"
  CDEST="$MONO/tools/out/c99native/$CNAME.c"
  mkdir -p "$(dirname "$CDEST")" 2>/dev/null; cp "$WORK/out.c" "$CDEST" 2>/dev/null || true
  echo "PASS $name :: $OUT|"
  echo "     C generato: tools/out/c99native/$CNAME.c"
  if [ "${GMB_C99NATIVE_SHOW_C:-0}" = "1" ]; then echo "  --- C generato ($CNAME) ---"; cat "$CDEST"; echo "  --- fine C ---"; fi
  pass=$((pass+1))
done
# Filtro che non corrisponde ad ALCUN file = gate ROSSO: senza questo controllo la gamba
# nativa riportava `PASS=0 FAIL=0` con exit 0 (falso verde) su un nome file sbagliato.
if [ ${#ONLY_NEEDLES[@]} -gt 0 ] && [ "$ONLY_MATCHED" -eq 0 ]; then
  echo "ERRORE: GMB_MINI_ONLY=\"$GMB_MINI_ONLY\" non corrisponde ad alcun MiniTest in $MINI" >&2
  echo "        (la gamba C99Native non ha eseguito NULLA: filtro errato, non un esito verde)" >&2
  exit 1
fi
echo "---------------------------------"
echo "C99Native MiniTests: PASS=$pass FAIL=$fail SKIP=$skip"
[ "$fail" -eq 0 ]
