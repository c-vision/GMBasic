<%@ IMPORT JSON, AI, MEMORY %>
<%@ IMPORT DASHBOARD %>
<%
  ' FILE: shared/webapp/pages/index.bsp — Agents Operating Center (UI)
  ' =====================================================================
  ' Pagina unica, 5 tab. Il markup e questo file sono il "sorgente di verità":
  ' si modifica qui (HTML/CSS/JS) e negli helper BASIC di include/AgentsDashboard.inc,
  ' senza toccare C#.
  '
  ' Dati:
  '   - SSR (funziona anche senza JavaScript) via AI.AGENTLIST/TEAMLIST/AGENTEVENTS,
  '     AI.WorkflowList, MEMORY.LIST;
  '   - live via /api/* (proxy same-origin di app.bas verso il server agenti 8765).
  '
  ' Endpoint propri della app (implementati in app.bas):
  '   GET /api/status · POST /api/agents · PATCH|DELETE /api/agents/{name}
  '   POST /api/agents/{name}/ask
  ' Tutti gli altri /api/* sono inoltrati al server agenti.
%>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>GMBasic — Agents Operating Center</title>
<style>
  :root{
    color-scheme: light dark;
    --bg:#f4f6fb; --card:#fff; --ink:#1c2430; --muted:#64748b;
    --line:#e2e8f0; --brand:#2563eb; --brand-ink:#1d4ed8;
    --ok:#059669; --warn:#d97706; --bad:#dc2626;
    --head1:#0f172a; --head2:#1e293b;
  }
  *{box-sizing:border-box;margin:0}
  body{font-family:-apple-system,"Segoe UI",Roboto,sans-serif;background:var(--bg);color:var(--ink);line-height:1.45}
  header{background:linear-gradient(135deg,var(--head1),var(--head2));color:#fff;padding:1.1rem 1.6rem}
  header .row{display:flex;align-items:center;gap:1rem;flex-wrap:wrap}
  header h1{font-size:1.25rem;font-weight:650;letter-spacing:.2px}
  header .sub{color:#cbd5e1;font-size:.8rem}
  .chips{display:flex;gap:.45rem;flex-wrap:wrap;margin-left:auto}
  .chip{background:rgba(255,255,255,.10);border:1px solid rgba(255,255,255,.16);color:#e2e8f0;
        border-radius:999px;padding:.28rem .65rem;font-size:.75rem;white-space:nowrap}
  .chip b{color:#fff;font-weight:600}
  .chip.ok{border-color:rgba(16,185,129,.55)} .chip.bad{border-color:rgba(248,113,113,.65)}
  .chip-btn{cursor:pointer}
  .banner{display:none;margin:0;padding:.7rem 1.6rem;background:#fef2f2;color:#991b1b;border-bottom:1px solid #fecaca;font-size:.85rem}
  .banner.show{display:block}
  nav.tabs{display:flex;gap:.25rem;padding:.6rem 1.6rem 0;border-bottom:1px solid var(--line);background:var(--card);flex-wrap:wrap}
  nav.tabs button{background:none;border:none;border-bottom:2px solid transparent;padding:.55rem .85rem;font:inherit;font-size:.88rem;
        color:var(--muted);cursor:pointer;border-radius:6px 6px 0 0}
  nav.tabs button:hover{background:#eef2ff;color:var(--brand-ink)}
  nav.tabs button.active{color:var(--brand-ink);border-bottom-color:var(--brand);font-weight:600}
  main{padding:1.2rem 1.6rem 3rem;max-width:1280px;margin:0 auto}
  section.panel{display:none} section.panel.active{display:block}
  h2{font-size:1.02rem;margin:.2rem 0 .5rem}
  h3{font-size:.92rem;margin:1.2rem 0 .5rem}
  p.muted,.muted{color:var(--muted);font-size:.82rem}
  .card{background:var(--card);border:1px solid var(--line);border-radius:12px;box-shadow:0 1px 2px rgba(15,23,42,.05);padding:1rem;margin:.6rem 0}
  table{width:100%;border-collapse:collapse;font-size:.86rem}
  th{text-align:left;color:var(--muted);font-weight:600;font-size:.74rem;text-transform:uppercase;letter-spacing:.04em;
     padding:.45rem .5rem;border-bottom:1px solid var(--line)}
  td{padding:.5rem;border-bottom:1px solid #f1f5f9;vertical-align:middle}
  tr:last-child td{border-bottom:none}
  td.name{font-weight:600}
  .badge{display:inline-block;border-radius:999px;padding:.12rem .5rem;font-size:.72rem;background:#eef2ff;color:#3730a3}
  .badge.idle{background:#f1f5f9;color:#475569}.badge.working{background:#dcfce7;color:#166534}
  .badge.planning{background:#fef9c3;color:#854d0e}.badge.waiting{background:#fef3c7;color:#92400e}
  .badge.perm-yolo{background:#fee2e2;color:#991b1b}.badge.perm-supervised{background:#e0f2fe;color:#075985}
  .badge.perm-sandbox{background:#f3e8ff;color:#6b21a8}.badge.strategy{background:#ecfeff;color:#155e75}
  .badge-empty{background:#fef2f2;color:#b91c1c}
  .toolbar{display:flex;gap:.5rem;align-items:center;flex-wrap:wrap;margin:.7rem 0}
  .btn{background:#eef2ff;color:#3730a3;border:none;border-radius:8px;padding:.42rem .8rem;font:inherit;font-size:.82rem;
       font-weight:600;cursor:pointer}
  .btn:hover{background:#e0e7ff}
  .btn-primary{background:var(--brand);color:#fff}.btn-primary:hover{background:var(--brand-ink)}
  .btn-danger{background:#fee2e2;color:#991b1b}.btn-danger:hover{background:#fecaca}
  .btn-ghost{background:transparent;color:var(--muted);border:1px solid var(--line)}
  .btn-ghost:hover{background:#f8fafc;color:var(--ink)}
  input,select,textarea{font:inherit;font-size:.85rem;padding:.42rem .55rem;border:1px solid var(--line);border-radius:8px;background:var(--card);color:inherit}
  input:focus,select:focus,textarea:focus{outline:2px solid #bfdbfe;border-color:#93c5fd}
  textarea{width:100%;min-height:80px;resize:vertical}
  .grid{display:grid;gap:.55rem}
  .grid.cols4{grid-template-columns:repeat(4,minmax(0,1fr))}
  .grid.cols3{grid-template-columns:repeat(3,minmax(0,1fr))}
  .grid.cols2{grid-template-columns:repeat(2,minmax(0,1fr))}
  .grid label{display:flex;flex-direction:column;gap:.2rem;font-size:.75rem;color:var(--muted)}
  .out{background:#0f172a;color:#e2e8f0;border-radius:10px;padding:.7rem .9rem;font-size:.78rem;overflow:auto;max-height:320px;
       white-space:pre-wrap;word-break:break-word;display:none}
  .out.show{display:block}
  .split{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
  .toast{position:fixed;right:1rem;bottom:1rem;background:#0f172a;color:#fff;padding:.65rem 1rem;border-radius:10px;
         font-size:.84rem;opacity:0;transform:translateY(8px);transition:.18s;pointer-events:none;max-width:420px}
  .toast.show{opacity:1;transform:none}
  .toast.bad{background:#991b1b}
  canvas.gmb-canvas{width:100%;max-width:820px;border:1px solid var(--line);border-radius:12px;background:#fff;display:block}
  code{background:#f1f5f9;padding:.08rem .34rem;border-radius:4px;font-size:.8rem}
  .hint{background:#fffbeb;border:1px solid #fde68a;color:#92400e;border-radius:10px;padding:.6rem .8rem;font-size:.8rem;margin:.6rem 0}
  .kv{display:flex;gap:.5rem;align-items:center;flex-wrap:wrap}
  @media (max-width:900px){.grid.cols4{grid-template-columns:1fr 1fr}.split{grid-template-columns:1fr}}
</style>
</head>
<body>
<header>
  <div class="row">
    <div>
      <h1><%= DASHBOARD.TITLE$ %></h1>
      <div class="sub">Agents · Teams · Log · Workflows · Memory · Canvas · WASM — all in BASIC</div>
    </div>
    <div class="chips">
      <span class="chip" id="chip-api">API: <b>…</b></span>
      <span class="chip" id="chip-provider">provider: <b>…</b></span>
      <span class="chip" id="chip-model">model: <b>…</b></span>
      <span class="chip" id="chip-agents">agents: <b>0</b></span>
      <span class="chip" id="chip-teams">teams: <b>0</b></span>
      <span class="chip" id="chip-uptime">uptime: <b>…</b></span>
      <span class="chip chip-btn" id="btn-pause" title="Pause/resume polling">⏸ pause</span>
    </div>
  </div>
</header>

<div class="banner" id="banner"></div>

<nav class="tabs" id="tabs">
  <button data-tab="agents" class="active">Agents</button>
  <button data-tab="teams">Teams</button>
  <button data-tab="log">Log</button>
  <button data-tab="workflows">Workflows</button>
  <button data-tab="memory">Memory</button>
  <button data-tab="brain">Brain</button>
  <button data-tab="canvas">Canvas</button>
  <button data-tab="wasm">WASM</button>
</nav>

<main>

<!-- ===================== AGENTS ===================== -->
<section id="panel-agents" class="panel active">
  <h2>Agents</h2>
  <p class="muted">Full lifecycle: create, update (prompt/permissions/model), delete, synchronous chat.
     Data comes from <code>/api/agents</code> (proxy) and <code>POST/PATCH/DELETE /api/agents*</code> (implemented in <code>app.bas</code>).</p>
  <div class="card">
    <table>
      <thead><tr><th>Name</th><th>Status</th><th>Permissions</th><th>Model</th><th>Actions</th></tr></thead>
      <tbody id="agents-body">
        <%
          DIM anames() = AI.AGENTLIST()
          IF UBOUND(anames) < 0 THEN
            PRINT DASHBOARD.EmptyRowHtml(5, "No agents — create one with the form below")
          ELSE
            FOR i = 0 TO UBOUND(anames)
              DIM nm$ = anames(i)
              DIM perm$ = AI.AGENTGET(nm$, "permission")
              IF perm$ = "" THEN perm$ = "YOLO"
              DIM model$ = AI.AGENTGET(nm$, "model")
              IF model$ = "" THEN model$ = "-"
              PRINT DASHBOARD.AgentRowRichHtml(nm$, "Idle", perm$, "-", model$)
            NEXT i
          END IF
        %>
      </tbody>
    </table>
  </div>

  <div class="split">
    <div class="card">
      <h3 style="margin-top:0">New agent</h3>
      <div class="grid cols2">
        <label>Name <input id="new-name" placeholder="e.g. Reviewer"></label>
        <label>Permissions
          <select id="new-perm">
            <option value="YOLO">YOLO</option>
            <option value="Supervised" selected>Supervised</option>
            <option value="Sandbox">Sandbox</option>
          </select>
        </label>
        <label>Model <input id="new-model" placeholder="(provider default)"></label>
        <label>Temperature <input id="new-temp" placeholder="e.g. 0.3" inputmode="decimal"></label>
      </div>
      <label style="display:flex;flex-direction:column;gap:.2rem;font-size:.75rem;color:var(--muted);margin-top:.5rem">
        System prompt
        <textarea id="new-prompt" placeholder="You are a concise, precise assistant."></textarea>
      </label>
      <div class="toolbar"><button class="btn btn-primary" id="btn-create">Create agent</button></div>
    </div>

    <div class="card">
      <h3 style="margin-top:0">Chat / update</h3>
      <div class="grid cols2">
        <label>Agent <input id="sel-agent" placeholder="agent name" list="agent-names"><datalist id="agent-names"></datalist></label>
        <label>New model <input id="set-model" placeholder="(leave empty = unchanged)"></label>
        <label>New permissions
          <select id="set-perm">
            <option value="">(unchanged)</option>
            <option value="YOLO">YOLO</option>
            <option value="Supervised">Supervised</option>
            <option value="Sandbox">Sandbox</option>
          </select>
        </label>
        <label>Temperature <input id="set-temp" placeholder="(unchanged)" inputmode="decimal"></label>
      </div>
      <label style="display:flex;flex-direction:column;gap:.2rem;font-size:.75rem;color:var(--muted);margin-top:.5rem">
        New system prompt <input id="set-prompt" placeholder="(unchanged)">
      </label>
      <div class="toolbar">
        <button class="btn" id="btn-update">Update</button>
        <button class="btn btn-danger" id="btn-delete">Delete</button>
      </div>
      <label style="display:flex;flex-direction:column;gap:.2rem;font-size:.75rem;color:var(--muted)">
        Chat prompt
        <input id="chat-prompt" placeholder="Type a prompt and press Send">
      </label>
      <div class="toolbar">
        <button class="btn btn-primary" id="btn-ask">Send</button>
        <span class="muted" id="ask-state"></span>
      </div>
      <pre class="out" id="chat-out"></pre>
    </div>
  </div>
</section>

<!-- ===================== TEAMS ===================== -->
<section id="panel-teams" class="panel">
  <h2>Teams</h2>
  <p class="muted">Runtime teams. Creation and member changes go through the API (the BASIC
     commands <code>AI TEAM …</code> need static names). Broadcast via <code>POST /api/team/{name}/broadcast</code>.</p>
  <div class="card">
    <table>
      <thead><tr><th>Name</th><th>Strategy</th><th>Members</th><th>Actions</th></tr></thead>
      <tbody id="teams-body">
        <%
          DIM tl$ = AI.TEAMLIST()
          IF LEN(tl$) = 0 THEN
            PRINT DASHBOARD.EmptyRowHtml(4, "No teams — create one below")
          ELSE
            DIM tnames() AS STRING = SPLIT(tl$, CHR$(10))
            FOR i = 0 TO UBOUND(tnames)
              IF LEN(TRIM$(tnames(i))) > 0 THEN PRINT DASHBOARD.TeamRowHtml(TRIM$(tnames(i)), "-", 0)
            NEXT i
          END IF
        %>
      </tbody>
    </table>
  </div>
  <div class="split">
    <div class="card">
      <h3 style="margin-top:0">New team</h3>
      <div class="grid cols2">
        <label>Name <input id="team-name" placeholder="e.g. Review"></label>
        <label>Strategy
          <select id="team-strategy">
            <option value="Sequential">Sequential</option>
            <option value="RoundRobin">RoundRobin</option>
            <option value="Coordinator">Coordinator</option>
            <option value="Mixture">Mixture</option>
            <option value="Deliberation">Deliberation</option>
            <option value="Dag">Dag</option>
          </select>
        </label>
      </div>
      <div class="toolbar"><button class="btn btn-primary" id="btn-team-create">Create team</button></div>
      <h3>Add member</h3>
      <div class="grid cols3">
        <label>Team <input id="team-add-team" placeholder="team name" list="team-names"><datalist id="team-names"></datalist></label>
        <label>Agent <input id="team-add-agent" placeholder="agent name" list="agent-names-2"><datalist id="agent-names-2"></datalist></label>
        <label>Role
          <select id="team-add-role">
            <option value="Worker">Worker</option>
            <option value="Coordinator">Coordinator</option>
            <option value="Critic">Critic</option>
          </select>
        </label>
      </div>
      <div class="toolbar"><button class="btn" id="btn-team-add">Add</button></div>
    </div>
    <div class="card">
      <h3 style="margin-top:0">Broadcast</h3>
      <div class="grid cols2">
        <label>Team <input id="bc-team" placeholder="team name"></label>
        <label>Message <input id="bc-msg" placeholder="message"></label>
      </div>
      <div class="toolbar"><button class="btn btn-primary" id="btn-broadcast">Send</button></div>
      <pre class="out" id="bc-out"></pre>
      <p class="muted" style="margin-top:.6rem">Teams are <b>persisted</b> in <code>bin/teams/&lt;name&gt;.team.json</code> and reloaded on startup.</p>
    </div>
  </div>
</section>

<!-- ===================== LOG ===================== -->
<section id="panel-log" class="panel">
  <h2>Log / Events</h2>
  <p class="muted">Ring buffer of <code>AI.AGENTEVENTS()</code> (filled by <code>AI AGENT TRACE VERBOSE</code>, enabled at startup).
     Live from <code>GET /api/events</code>.</p>
  <div class="toolbar">
    <input id="log-filter" placeholder="filter (text)" style="min-width:220px">
    <button class="btn btn-ghost" id="btn-log-refresh">Refresh</button>
    <label class="kv muted" style="font-size:.8rem"><input type="checkbox" id="log-autoscroll" checked> autoscroll</label>
    <span class="badge" id="log-live">polling</span>
    <span class="muted" id="log-count"></span>
  </div>
  <div class="card">
    <table><thead><tr><th>Event</th></tr></thead>
      <tbody id="log-body">
        <%
          DIM evs() = AI.AGENTEVENTS()
          IF UBOUND(evs) < 0 THEN
            PRINT "<tr><td class='empty muted'>No events — enable TRACE and use an agent</td></tr>"
          ELSE
            FOR i = 0 TO UBOUND(evs)
              PRINT "<tr><td class='detail'>" + DASHBOARD.EscapeHtml(evs(i)) + "</td></tr>"
            NEXT i
          END IF
        %>
      </tbody>
    </table>
  </div>
</section>

<!-- ===================== WORKFLOWS ===================== -->
<section id="panel-workflows" class="panel">
  <h2>Workflows</h2>
  <p class="muted">Create, add steps, run, inspect, delete.
     API: <code>POST /api/workflows</code>, <code>POST /api/workflows/{n}/steps|execute</code>, <code>GET/DELETE /api/workflows/{n}</code>.</p>
  <div class="card">
    <table>
      <thead><tr><th>Name</th><th>Status</th><th>Steps</th><th>Actions</th></tr></thead>
      <tbody id="wf-body">
        <%
          DIM wl$ = AI.WorkflowList()
          IF LEN(wl$) = 0 THEN
            PRINT "<tr><td colspan='4' class='muted'>No workflows — create one below</td></tr>"
          ELSE
            DIM wfs() AS STRING = SPLIT(wl$, CHR$(10))
            FOR i = 0 TO UBOUND(wfs)
              DIM wname AS STRING = TRIM$(wfs(i))
              IF LEN(wname) > 0 THEN
                PRINT "<tr><td class='name'>" + DASHBOARD.EscapeHtml(wname) + "</td><td><span class='badge'>" + DASHBOARD.EscapeHtml(AI.WorkflowStatus(wname)) + "</span></td><td class='muted'>" + DASHBOARD.EscapeHtml(AI.WorkflowSteps(wname)) + "</td><td></td></tr>"
              END IF
            NEXT i
          END IF
        %>
      </tbody>
    </table>
  </div>
  <div class="split">
    <div class="card">
      <h3 style="margin-top:0">New workflow</h3>
      <div class="grid cols2">
        <label>Name <input id="wf-name" placeholder="e.g. Smoke"></label>
        <label>&nbsp;<button class="btn btn-primary" id="btn-wf-create">Create</button></label>
      </div>
      <h3>Step</h3>
      <div class="grid cols4">
        <label>Workflow <input id="wf-step-wf" placeholder="name"></label>
        <label>Step <input id="wf-step-name" placeholder="s1"></label>
        <label>Action <input id="wf-step-action" placeholder="PRINT 42"></label>
        <label>Retry <input id="wf-step-retry" placeholder="0" inputmode="numeric"></label>
      </div>
      <div class="toolbar"><button class="btn" id="btn-wf-step">Add step</button></div>
    </div>
    <div class="card">
      <h3 style="margin-top:0">Run / inspect / delete</h3>
      <div class="grid cols3">
        <label>Workflow <input id="wf-target" placeholder="name"></label>
        <label>&nbsp;<button class="btn btn-primary" id="btn-wf-run">Run</button></label>
        <label>&nbsp;<button class="btn btn-ghost" id="btn-wf-detail">Detail</button></label>
      </div>
      <div class="toolbar"><button class="btn btn-danger" id="btn-wf-delete">Delete workflow</button></div>
      <pre class="out" id="wf-out"></pre>
    </div>
  </div>
</section>

<!-- ===================== MEMORY ===================== -->
<section id="panel-memory" class="panel">
  <h2>Memory</h2>
  <p class="muted">Runtime key-value store (<code>MEMORY.STORE/LOAD/DELETE/LIST</code>) via <code>/api/memory*</code>.</p>
  <div class="card">
    <div class="toolbar">
      <input id="mem-search" placeholder="search key (pattern)" style="min-width:220px">
      <button class="btn btn-ghost" id="btn-mem-refresh">Refresh</button>
      <span class="muted" id="mem-count"></span>
    </div>
    <table><thead><tr><th>Key</th><th>Value</th><th>Actions</th></tr></thead>
      <tbody id="mem-body">
        <%
          DIM mlist$ = MEMORY.LIST()
          IF LEN(mlist$) = 0 THEN
            PRINT "<tr><td colspan='3' class='muted'>No keys — use the form below</td></tr>"
          ELSE
            DIM mkeys() AS STRING = SPLIT(mlist$, CHR$(10))
            FOR i = 0 TO UBOUND(mkeys)
              DIM mk$ = TRIM$(mkeys(i))
              IF LEN(mk$) > 0 THEN PRINT "<tr><td class='name'>" + DASHBOARD.EscapeHtml(mk$) + "</td><td class='muted'>…</td><td></td></tr>"
            NEXT i
          END IF
        %>
      </tbody>
    </table>
  </div>
  <div class="card">
    <div class="grid cols3">
      <label>Key <input id="mem-key" placeholder="key"></label>
      <label>Value <input id="mem-value" placeholder="value"></label>
      <label class="kv" style="flex-direction:row;align-items:center;gap:.35rem;font-size:.8rem;color:var(--muted)">
        <input type="checkbox" id="mem-long"> long term
      </label>
    </div>
    <div class="toolbar">
      <button class="btn btn-primary" id="btn-mem-store">Save</button>
      <button class="btn btn-ghost" id="btn-mem-load">Load</button>
      <button class="btn btn-danger" id="btn-mem-delete">Delete</button>
    </div>
    <pre class="out" id="mem-out"></pre>
  </div>
</section>

<!-- ===================== BRAIN ===================== -->
<section id="panel-brain" class="panel">
  <h2>Second Brain</h2>
  <p class="muted">Notes/facts + semantic search (<code>AI.MEMORYASK</code>) via <code>/api/brain/*</code>.</p>
  <div class="card">
    <div class="grid cols3">
      <label>Search <input id="brain-q" placeholder="question or keywords"></label>
      <label>topK <input id="brain-k" placeholder="5" inputmode="numeric"></label>
      <label>&nbsp;<button class="btn btn-primary" id="btn-brain-search">Search</button></label>
    </div>
    <pre class="out" id="brain-out"></pre>
  </div>
  <div class="split">
    <div class="card">
      <h3 style="margin-top:0">Add</h3>
      <label style="display:flex;flex-direction:column;gap:.2rem;font-size:.75rem;color:var(--muted)">
        Text <textarea id="brain-text" placeholder="Note, fact or observation…"></textarea>
      </label>
      <div class="toolbar">
        <button class="btn" id="btn-brain-note">Note</button>
        <button class="btn" id="btn-brain-fact">Fact</button>
        <button class="btn btn-ghost" id="btn-brain-consolidate">Consolidate</button>
      </div>
    </div>
    <div class="card">
      <h3 style="margin-top:0">Latest entries</h3>
      <div class="toolbar"><button class="btn btn-ghost" id="btn-brain-list">Refresh</button></div>
      <pre class="out" id="brain-list"></pre>
    </div>
  </div>
</section>

<!-- ===================== CANVAS ===================== -->
<section id="panel-canvas" class="panel">
  <h2>Remote canvas</h2>
  <p class="muted">Draw commands generated in BASIC (<code>WEBCANVAS</code>) → JSON on the <code>/ws/canvas</code> WebSocket → this <code>&lt;canvas&gt;</code>.</p>
  <div class="card">
    <div class="toolbar">
      <button class="btn btn-primary" id="btn-canvas-connect">Connect WS</button>
      <button class="btn" id="btn-canvas-demo">Request demo</button>
      <button class="btn btn-ghost" id="btn-canvas-clear">Clear (local)</button>
      <span class="muted" id="canvas-state">not connected</span>
    </div>
    <canvas id="gmb-canvas" class="gmb-canvas" width="800" height="480"></canvas>
    <pre class="out" id="canvas-log"></pre>
  </div>
</section>

<!-- ===================== WASM ===================== -->
<section id="panel-wasm" class="panel">
  <h2>WASM</h2>
  <p class="muted">Target <code>.bas → .wasm</code> (clang wasm32 + <code>WasmBridge.inc</code>). This tab is a <b>shell</b>:
     if <code>static/prog.wasm</code> is missing it says so instead of pretending.</p>
  <div class="card">
    <div class="toolbar">
      <button class="btn btn-ghost" id="btn-wasm-check">Check prog.wasm</button>
      <button class="btn" id="btn-wasm-demo">Demo draw (JS)</button>
      <span class="muted" id="wasm-state">not checked</span>
    </div>
    <canvas id="wasm-canvas" class="gmb-canvas" width="800" height="320"></canvas>
    <div class="hint" id="wasm-hint">
      To build a module: <code>gmb dump c prog.bas --out /tmp/prog.c</code>
      then <code>clang --target=wasm32 -o shared/webapp/static/prog.wasm /tmp/prog.c GMBasic/native/gmb_runtime_c/src/*.c</code>.
    </div>
    <pre class="out" id="wasm-log"></pre>
  </div>
</section>

</main>
<div class="toast" id="toast"></div>

<script>
(function(){
  "use strict";
  var S = { refreshMs: 2500, paused:false, status:null, agents:[], ws:null };
  var el = function(id){ return document.getElementById(id); };
  function esc(s){ return String(s==null?"":s).replace(/[&<>"']/g,function(c){
      return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }

  var toastTimer=null;
  function toast(msg,bad){
    var t=el('toast'); t.textContent=msg; t.className='toast show'+(bad?' bad':'');
    clearTimeout(toastTimer); toastTimer=setTimeout(function(){t.className='toast';},2600);
  }
  function banner(msg){
    var b=el('banner');
    if(!msg){ b.className='banner'; b.textContent=''; return; }
    b.textContent=msg; b.className='banner show';
  }

  function api(path, opts){
    opts = opts || {};
    return fetch(path, opts).then(function(r){
      return r.text().then(function(txt){
        var data=null;
        try{ data = txt ? JSON.parse(txt) : null; }catch(e){ data = { error:'bad_json', message: txt.slice(0,300) }; }
        if(!r.ok){
          var msg = (data && (data.message||data.error)) || ('HTTP '+r.status);
          throw new Error(msg);
        }
        return data;
      });
    });
  }
  function postJson(path, obj){
    return api(path,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(obj||{})});
  }
  function out(id, obj){
    var e=el(id); if(!e) return;
    e.textContent = typeof obj === 'string' ? obj : JSON.stringify(obj,null,2);
    e.className='out show';
  }

  // ---------- stato ----------
  function fmtUp(s){
    s = Math.max(0, s|0);
    var h=Math.floor(s/3600), m=Math.floor((s%3600)/60), x=s%60;
    return (h?h+'h ':'') + m + 'm ' + x + 's';
  }
  function refreshStatus(){
    return api('/api/status').then(function(st){
      S.status=st;
      if(st.refreshMs && st.refreshMs>0) S.refreshMs=st.refreshMs;
      var chip=el('chip-api');
      var reach = st.apiReachable===true;
      chip.className='chip '+(reach?'ok':'bad');
      chip.innerHTML='API: <b>'+(reach?'ok':'down')+'</b>';
      el('chip-provider').innerHTML='provider: <b>'+esc(st.activeProvider||'—')+'</b>';
      el('chip-model').innerHTML='model: <b>'+esc(st.model||'—')+'</b>';
      el('chip-agents').innerHTML='agents: <b>'+esc(st.agents)+'</b>';
      var ct=el('chip-teams'); if(ct) ct.innerHTML='teams: <b>'+esc(st.teams==null?0:st.teams)+'</b>';
      el('chip-uptime').innerHTML='uptime: <b>'+esc(fmtUp(st.uptimeSec))+'</b>';
      if(!reach) banner('The agent server (port '+st.apiPort+') is not responding: live data is stalled. '+
                        'Check that `AI AGENT SERVE` started (process log).');
      else banner('');
      return st;
    }).catch(function(e){
      banner('Dashboard reachable but /api/status failed: '+e.message);
      return null;
    });
  }

  // ---------- agents ----------
  function agentRow(a){
    return '<tr><td class="name">'+esc(a.name)+'</td>'
      + '<td><span class="badge '+(a.status?'idle':'')+'">'+esc(a.status||'—')+'</span></td>'
      + '<td>'+badgePerm(a.permission)+'</td>'
      + '<td class="muted">'+esc(a.model||'-')+'</td>'
      + '<td><button class="btn btn-ghost" data-act="chat" data-name="'+esc(a.name)+'">Chat</button> '
      + '<button class="btn btn-ghost" data-act="pick" data-name="'+esc(a.name)+'">Seleziona</button></td></tr>';
  }
  function badgePerm(p){
    var k=(p||'').toLowerCase();
    return '<span class="badge perm-'+esc(k)+'">'+esc(p||'—')+'</span>';
  }
  function refreshAgents(){
    return api('/api/agents').then(function(list){
      S.agents=list||[];
      var tb=el('agents-body');
      tb.innerHTML = S.agents.length ? S.agents.map(agentRow).join('')
        : '<tr><td colspan="5" class="muted">No agents — create one with the form below</td></tr>';
      var dl=el('agent-names');
      dl.innerHTML = S.agents.map(function(a){return '<option value="'+esc(a.name)+'">';}).join('');
      var dl2=el('agent-names-2');
      if(dl2) dl2.innerHTML = dl.innerHTML;
      return S.agents;
    }).catch(function(e){ toast('agents: '+e.message,true); return []; });
  }
  function wireAgents(){
    el('btn-create').addEventListener('click',function(){
      var name=el('new-name').value.trim();
      if(!name){ toast('a name is required',true); return; }
      var body={name:name, permission:el('new-perm').value,
                systemPrompt:el('new-prompt').value.trim()};
      var model=el('new-model').value.trim(); if(model) body.model=model;
      var t=el('new-temp').value.trim(); if(t) body.temperature=t;
      postJson('/api/agents',body).then(function(r){
        toast('agent created: '+r.created); el('new-name').value=''; el('new-prompt').value='';
        refreshAgents();
      }).catch(function(e){ toast('create: '+e.message,true); });
    });
    el('btn-update').addEventListener('click',function(){
      var name=el('sel-agent').value.trim();
      if(!name){ toast('select an agent',true); return; }
      var body={};
      var m=el('set-model').value.trim(); if(m) body.model=m;
      var p=el('set-perm').value; if(p) body.permission=p;
      var t=el('set-temp').value.trim(); if(t) body.temperature=t;
      var sp=el('set-prompt').value.trim(); if(sp) body.systemPrompt=sp;
      if(!Object.keys(body).length){ toast('no fields to update',true); return; }
      api('/api/agents/'+encodeURIComponent(name),{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)})
        .then(function(r){ toast('updated ('+r.fields+' fields)'); refreshAgents(); })
        .catch(function(e){ toast('update: '+e.message,true); });
    });
    el('btn-delete').addEventListener('click',function(){
      var name=el('sel-agent').value.trim();
      if(!name){ toast('select an agent',true); return; }
      if(!confirm('Delete agent "'+name+'"?')) return;
      api('/api/agents/'+encodeURIComponent(name),{method:'DELETE'})
        .then(function(r){ toast('deleted: '+r.deleted); refreshAgents(); })
        .catch(function(e){ toast('delete: '+e.message,true); });
    });
    el('btn-ask').addEventListener('click',function(){
      var name=el('sel-agent').value.trim();
      var prompt=el('chat-prompt').value.trim();
      if(!name||!prompt){ toast('agent and prompt are required',true); return; }
      el('ask-state').textContent='sending…';
      postJson('/api/agents/'+encodeURIComponent(name)+'/ask',{prompt:prompt})
        .then(function(r){ out('chat-out',r); el('ask-state').textContent=''; refreshAgents(); })
        .catch(function(e){ out('chat-out','error: '+e.message); el('ask-state').textContent=''; });
    });
    el('agents-body').addEventListener('click',function(ev){
      var b=ev.target.closest('button[data-act]'); if(!b) return;
      el('sel-agent').value=b.getAttribute('data-name');
      if(b.getAttribute('data-act')==='chat') el('chat-prompt').focus();
    });
  }

  // ---------- teams ----------
  function refreshTeams(){
    return api('/api/teams').then(function(list){
      var tb=el('teams-body');
      list=list||[];
      tb.innerHTML = list.length ? list.map(function(t){
        return '<tr><td class="name">'+esc(t.name)+'</td><td><span class="badge strategy">'+esc(t.strategy||'-')+
               '</span></td><td>'+esc(t.memberCount||0)+'</td>'
             + '<td><button class="btn btn-ghost" data-team="'+esc(t.name)+'">Seleziona</button> '
             + '<button class="btn btn-ghost" data-team-add="'+esc(t.name)+'">+ Agent</button> '
             + '<button class="btn btn-danger" data-team-del="'+esc(t.name)+'">Delete</button></td></tr>';
      }).join('') : '<tr><td colspan="4" class="muted">No teams — create one below</td></tr>';
      var dl=el('team-names');
      if(dl) dl.innerHTML = list.map(function(t){return '<option value="'+esc(t.name)+'">';}).join('');
      return list;
    }).catch(function(e){ toast('teams: '+e.message,true); return []; });
  }
  function wireTeams(){
    el('teams-body').addEventListener('click',function(ev){
      var b=ev.target.closest('button[data-team]');
      if(b){ el('bc-team').value=b.getAttribute('data-team'); el('team-add-team').value=b.getAttribute('data-team'); return; }
      var a=ev.target.closest('button[data-team-add]');
      if(a){ el('team-add-team').value=a.getAttribute('data-team-add'); el('team-add-agent').focus(); return; }
      var d=ev.target.closest('button[data-team-del]');
      if(d){
        var name=d.getAttribute('data-team-del');
        if(!confirm('Delete team "'+name+'"?')) return;
        api('/api/teams/'+encodeURIComponent(name),{method:'DELETE'})
          .then(function(r){ toast('team deleted: '+(r.deleted||name)); refreshTeams(); })
          .catch(function(e){ toast('delete team: '+e.message,true); });
      }
    });
    el('btn-team-create').addEventListener('click',function(){
      var n=el('team-name').value.trim();
      if(!n){ toast('team name?',true); return; }
      postJson('/api/teams',{name:n, strategy:el('team-strategy').value})
        .then(function(r){ toast('team created: '+(r.name||n)); el('team-name').value=''; refreshTeams(); })
        .catch(function(e){ toast('create team: '+e.message,true); });
    });
    el('btn-team-add').addEventListener('click',function(){
      var t=el('team-add-team').value.trim(), a=el('team-add-agent').value.trim();
      if(!t||!a){ toast('team and agent are required',true); return; }
      postJson('/api/teams/'+encodeURIComponent(t)+'/agents',{agent:a, role:el('team-add-role').value})
        .then(function(r){ toast('member added to '+t); refreshTeams(); refreshAgents(); })
        .catch(function(e){ toast('add member: '+e.message,true); });
    });
    el('btn-broadcast').addEventListener('click',function(){
      var t=el('bc-team').value.trim(), m=el('bc-msg').value.trim();
      if(!t||!m){ toast('team and message are required',true); return; }
      postJson('/api/team/'+encodeURIComponent(t)+'/broadcast',{message:m})
        .then(function(r){ out('bc-out',r); })
        .catch(function(e){ out('bc-out','error: '+e.message); });
    });
  }

  // ---------- log ----------
  function refreshEvents(){
    return api('/api/events').then(function(list){
      list=list||[];
      var f=(el('log-filter').value||'').toLowerCase();
      var rows=list.filter(function(e){
        if(!f) return true;
        return JSON.stringify(e).toLowerCase().indexOf(f)>=0;
      });
      var tb=el('log-body');
      tb.innerHTML = rows.length ? rows.slice().reverse().map(function(e){
        var ts=e.timestamp? String(e.timestamp).replace('T',' ').slice(0,19):'';
        return '<tr><td><span class="muted">'+esc(ts)+'</span> <span class="badge">'+esc(e.kind||'')+'</span> '+
               '<b>'+esc(e.agent||'')+'</b> — '+esc(e.detail||'')+'</td></tr>';
      }).join('') : '<tr><td class="muted">No events'+(f?' matching the filter':'')+'</td></tr>';
      el('log-count').textContent=list.length+' events';
      if(el('log-autoscroll').checked) tb.scrollTop=0;
      return rows;
    }).catch(function(e){ el('log-count').textContent='error: '+e.message; return []; });
  }
  function wireLog(){
    el('btn-log-refresh').addEventListener('click',refreshEvents);
    el('log-filter').addEventListener('input',refreshEvents);
    // Eventi in tempo reale via SSE (chunked): il server manda solo i NUOVI eventi.
    // Se EventSource non e' disponibile o il canale cade, resta il polling di refreshEvents().
    try{
      var es=new EventSource('/api/events/stream');
      es.onopen=function(){ var b=el('log-live'); if(b){ b.textContent='live'; b.className='badge perm-yolo'; } };
      es.onmessage=function(m){
        var txt;
        try{ txt=JSON.parse(m.data); }catch(_){ txt=m.data; }
        if(typeof txt!=='string') txt=String(txt);
        var f=(el('log-filter').value||'').toLowerCase();
        if(f && txt.toLowerCase().indexOf(f)<0) return;
        var tb=el('log-body');
        var tr=document.createElement('tr');
        var td=document.createElement('td');
        td.className='detail';
        td.textContent=txt;
        tr.appendChild(td);
        if(tb.firstChild) tb.insertBefore(tr, tb.firstChild); else tb.appendChild(tr);
        var c=el('log-count'); if(c) c.textContent='live';
      };
      es.onerror=function(){ var b=el('log-live'); if(b){ b.textContent='polling'; b.className='badge'; } };
    }catch(_){}
  }

  // ---------- workflows ----------
  function refreshWorkflows(){
    return api('/api/workflows').then(function(list){
      list=list||[];
      var tb=el('wf-body');
      tb.innerHTML = list.length ? list.map(function(w){
        var steps=(w.steps||[]).join(', ');
        return '<tr><td class="name">'+esc(w.name)+'</td><td><span class="badge">'+esc(w.status||'')+'</span></td>'+
               '<td class="muted">'+esc(steps)+'</td>'+
               '<td><button class="btn btn-ghost" data-wf-pick="'+esc(w.name)+'">Seleziona</button> '+
               '<button class="btn btn-ghost" data-wf-run="'+esc(w.name)+'">Run</button></td></tr>';
      }).join('') : '<tr><td colspan="4" class="muted">No workflows</td></tr>';
      return list;
    }).catch(function(e){ toast('workflows: '+e.message,true); return []; });
  }
  function wireWorkflows(){
    el('btn-wf-create').addEventListener('click',function(){
      var n=el('wf-name').value.trim(); if(!n){ toast('workflow name?',true); return; }
      postJson('/api/workflows',{name:n}).then(function(r){ toast('workflow created'); el('wf-target').value=n; refreshWorkflows(); })
        .catch(function(e){ toast('create: '+e.message,true); });
    });
    el('btn-wf-step').addEventListener('click',function(){
      var wf=el('wf-step-wf').value.trim()||el('wf-target').value.trim();
      var st=el('wf-step-name').value.trim(), ac=el('wf-step-action').value;
      if(!wf||!st){ toast('workflow and step name are required',true); return; }
      var body={name:st,action:ac};
      var rt=el('wf-step-retry').value.trim(); if(rt) body.retryCount=parseInt(rt,10)||0;
      postJson('/api/workflows/'+encodeURIComponent(wf)+'/steps',body)
        .then(function(r){ out('wf-out',r); refreshWorkflows(); })
        .catch(function(e){ out('wf-out','error: '+e.message); });
    });
    el('btn-wf-run').addEventListener('click',function(){
      runWf(el('wf-target').value.trim());
    });
    el('btn-wf-detail').addEventListener('click',function(){
      var wf=el('wf-target').value.trim(); if(!wf){ toast('workflow name?',true); return; }
      api('/api/workflows/'+encodeURIComponent(wf)).then(function(r){ out('wf-out',r); })
        .catch(function(e){ out('wf-out','error: '+e.message); });
    });
    el('btn-wf-delete').addEventListener('click',function(){
      var wf=el('wf-target').value.trim(); if(!wf){ toast('workflow name?',true); return; }
      if(!confirm('Delete workflow "'+wf+'"?')) return;
      api('/api/workflows/'+encodeURIComponent(wf),{method:'DELETE'})
        .then(function(r){ out('wf-out',r); refreshWorkflows(); })
        .catch(function(e){ out('wf-out','error: '+e.message); });
    });
    el('wf-body').addEventListener('click',function(ev){
      var pick=ev.target.closest('button[data-wf-pick]');
      if(pick){ el('wf-target').value=pick.getAttribute('data-wf-pick'); el('wf-step-wf').value=el('wf-target').value; return; }
      var run=ev.target.closest('button[data-wf-run]');
      if(run) runWf(run.getAttribute('data-wf-run'));
    });
  }
  function runWf(wf){
    if(!wf){ toast('workflow name?',true); return; }
    el('wf-target').value=wf;
    postJson('/api/workflows/'+encodeURIComponent(wf)+'/execute',{})
      .then(function(r){ out('wf-out',r); refreshWorkflows(); refreshEvents(); })
      .catch(function(e){ out('wf-out','error: '+e.message); });
  }

  // ---------- memory ----------
  function refreshMemory(){
    return api('/api/memory').then(function(r){
      var keys=(r&&r.keys)||[];
      el('mem-count').textContent=keys.length+' keys';
      var tb=el('mem-body');
      tb.innerHTML = keys.length ? keys.map(function(k){
        return '<tr><td class="name">'+esc(k)+'</td><td class="muted">…</td>'+
               '<td><button class="btn btn-ghost" data-mem-load="'+esc(k)+'">Load</button> '+
               '<button class="btn btn-ghost" data-mem-del="'+esc(k)+'">Delete</button></td></tr>';
      }).join('') : '<tr><td colspan="3" class="muted">No keys</td></tr>';
      return keys;
    }).catch(function(e){ toast('memory: '+e.message,true); return []; });
  }
  function wireMemory(){
    el('btn-mem-refresh').addEventListener('click',refreshMemory);
    el('btn-mem-store').addEventListener('click',function(){
      var k=el('mem-key').value.trim(), v=el('mem-value').value;
      if(!k){ toast('key?',true); return; }
      postJson('/api/memory',{key:k,value:v,longTerm:el('mem-long').checked?1:0})
        .then(function(r){ out('mem-out',r); refreshMemory(); })
        .catch(function(e){ out('mem-out','error: '+e.message); });
    });
    el('btn-mem-load').addEventListener('click',function(){
      var k=el('mem-key').value.trim(); if(!k){ toast('key?',true); return; }
      api('/api/memory?key='+encodeURIComponent(k)).then(function(r){
        out('mem-out',r); if(r && r.value!==undefined) el('mem-value').value=r.value;
      }).catch(function(e){ out('mem-out','error: '+e.message); });
    });
    el('btn-mem-delete').addEventListener('click',function(){
      var k=el('mem-key').value.trim(); if(!k){ toast('key?',true); return; }
      api('/api/memory?key='+encodeURIComponent(k),{method:'DELETE'})
        .then(function(r){ out('mem-out',r); refreshMemory(); })
        .catch(function(e){ out('mem-out','error: '+e.message); });
    });
    el('mem-search').addEventListener('input',function(){
      var p=el('mem-search').value.trim();
      api('/api/memory/search?pattern='+encodeURIComponent(p)).then(function(r){
        var keys=(r&&r.keys)||[];
        var tb=el('mem-body');
        tb.innerHTML = keys.length ? keys.map(function(k){
          return '<tr><td class="name">'+esc(k)+'</td><td class="muted">…</td>'+
                 '<td><button class="btn btn-ghost" data-mem-load="'+esc(k)+'">Load</button> '+
                 '<button class="btn btn-ghost" data-mem-del="'+esc(k)+'">Delete</button></td></tr>';
        }).join('') : '<tr><td colspan="3" class="muted">No matches</td></tr>';
        el('mem-count').textContent=keys.length+' matches';
      }).catch(function(){});
    });
    el('mem-body').addEventListener('click',function(ev){
      var l=ev.target.closest('button[data-mem-load]');
      if(l){ var k=l.getAttribute('data-mem-load'); el('mem-key').value=k;
        api('/api/memory?key='+encodeURIComponent(k)).then(function(r){
          out('mem-out',r); if(r && r.value!==undefined) el('mem-value').value=r.value;
        }).catch(function(e){ out('mem-out','error: '+e.message); });
        return; }
      var d=ev.target.closest('button[data-mem-del]');
      if(d){ var kd=d.getAttribute('data-mem-del');
        api('/api/memory?key='+encodeURIComponent(kd),{method:'DELETE'})
          .then(function(r){ out('mem-out',r); refreshMemory(); })
          .catch(function(e){ out('mem-out','error: '+e.message); });
      }
    });
  }

  // ---------- brain ----------
  function wireBrain(){
    el('btn-brain-search').addEventListener('click',function(){
      var q=el('brain-q').value.trim(), k=el('brain-k').value.trim()||'5';
      api('/api/brain/search?query='+encodeURIComponent(q)+'&topK='+encodeURIComponent(k))
        .then(function(r){ out('brain-out',r); })
        .catch(function(e){ out('brain-out','error: '+e.message); });
    });
    el('btn-brain-note').addEventListener('click',function(){
      var t=el('brain-text').value.trim(); if(!t){ toast('text?',true); return; }
      postJson('/api/brain/note',{text:t}).then(function(r){ out('brain-out',r); brainList(); })
        .catch(function(e){ out('brain-out','error: '+e.message); });
    });
    el('btn-brain-fact').addEventListener('click',function(){
      var t=el('brain-text').value.trim(); if(!t){ toast('text?',true); return; }
      postJson('/api/brain/save',{fact:t}).then(function(r){ out('brain-out',r); brainList(); })
        .catch(function(e){ out('brain-out','error: '+e.message); });
    });
    el('btn-brain-consolidate').addEventListener('click',function(){
      postJson('/api/brain/consolidate',{}).then(function(r){ out('brain-out',r); brainList(); })
        .catch(function(e){ out('brain-out','error: '+e.message); });
    });
    el('btn-brain-list').addEventListener('click',brainList);
  }
  function brainList(){
    api('/api/brain/list?limit=20').then(function(r){ out('brain-list',r); })
      .catch(function(e){ out('brain-list','error: '+e.message); });
  }

  // ---------- canvas ----------
  function canvasReplay(cmd, c){
    if(!cmd||!c) return;
    var ctx=c.getContext('2d');
    var color=function(n){ return 'hsl('+((n*37)%360)+' 70% 45%)'; };
    switch(cmd.op){
      case 'clear': ctx.fillStyle=color(cmd.c||0); ctx.fillRect(0,0,c.width,c.height); break;
      case 'pset': ctx.fillStyle=color(cmd.c||0); ctx.fillRect(cmd.x|0,cmd.y|0,2,2); break;
      case 'line': ctx.strokeStyle=color(cmd.c||0); ctx.beginPath(); ctx.moveTo(cmd.x1|0,cmd.y1|0); ctx.lineTo(cmd.x2|0,cmd.y2|0); ctx.stroke(); break;
      case 'rect': ctx.strokeStyle=color(cmd.c||0); ctx.strokeRect(cmd.x|0,cmd.y|0,cmd.w|0,cmd.h|0); break;
      case 'circle': ctx.strokeStyle=color(cmd.c||0); ctx.beginPath(); ctx.arc(cmd.x|0,cmd.y|0,cmd.r|0,0,Math.PI*2); ctx.stroke(); break;
      case 'text': ctx.fillStyle=color(cmd.c||0); ctx.font='14px monospace'; ctx.fillText(cmd.txt||'',cmd.x|0,cmd.y|0); break;
      case 'frame': ctx.strokeStyle=color(cmd.c||0); ctx.strokeRect(cmd.x|0,cmd.y|0,cmd.w|0,cmd.h|0); break;
      default: break;
    }
  }
  function wireCanvas(){
    var c=el('gmb-canvas');
    el('btn-canvas-connect').addEventListener('click',function(){
      if(S.ws){ try{S.ws.close();}catch(e){} S.ws=null; }
      var proto = location.protocol==='https:'?'wss':'ws';
      var ws = new WebSocket(proto+'://'+location.host+'/ws/canvas');
      S.ws=ws;
      el('canvas-state').textContent='connecting…';
      ws.onopen=function(){ el('canvas-state').textContent='connected'; toast('WS connected'); };
      ws.onclose=function(){ el('canvas-state').textContent='closed'; S.ws=null; };
      ws.onerror=function(){ el('canvas-state').textContent='error'; };
      ws.onmessage=function(ev){
        var lines=String(ev.data).split('\n'); var log=[];
        lines.forEach(function(line){
          if(!line) return;
          log.push(line);
          try{ canvasReplay(JSON.parse(line), c); }catch(e){ log.push('parse: '+e.message); }
        });
        var o=el('canvas-log'); o.textContent=(log.join('\n')+'\n'+o.textContent).slice(0,4000); o.className='out show';
      };
    });
    el('btn-canvas-demo').addEventListener('click',function(){
      if(S.ws && S.ws.readyState===1){ S.ws.send(JSON.stringify({op:'demo'})); }
      else toast('connect the WebSocket first',true);
    });
    el('btn-canvas-clear').addEventListener('click',function(){ canvasReplay({op:'clear',c:0}, c); });
  }

  // ---------- wasm ----------
  function wireWasm(){
    el('btn-wasm-check').addEventListener('click',function(){
      fetch('/static/prog.wasm',{method:'HEAD'}).then(function(r){
        if(r.ok){
          el('wasm-state').textContent='prog.wasm present';
          out('wasm-log','prog.wasm found ('+r.headers.get('content-length')+' bytes).\nLoad it with WebAssembly.instantiate(fetch(...)).');
        }else{
          el('wasm-state').textContent='prog.wasm missing (404)';
          out('wasm-log','No module at static/prog.wasm.\nThe shell is ready: build a .bas for wasm32 and copy it here.\nUse "Demo draw (JS)" to verify the canvas.');
        }
      }).catch(function(e){ el('wasm-state').textContent='error'; out('wasm-log',String(e)); });
    });
    el('btn-wasm-demo').addEventListener('click',function(){
      var c=el('wasm-canvas'), ctx=c.getContext('2d');
      ctx.fillStyle='#fff'; ctx.fillRect(0,0,c.width,c.height);
      ctx.fillStyle='#2563eb'; ctx.fillRect(20,20,60,40);
      ctx.strokeStyle='#0c4a6e'; ctx.beginPath(); ctx.arc(90,90,20,0,Math.PI*2); ctx.stroke();
      ctx.fillStyle='#1c2430'; ctx.font='13px monospace'; ctx.fillText('WASM demo (JS fallback)',10,150);
    });
  }

  // ---------- tabs ----------
  var TABS=['agents','teams','log','workflows','memory','brain','canvas','wasm'];
  function showTab(name){
    if(TABS.indexOf(name)<0) name='agents';
    TABS.forEach(function(t){
      var p=el('panel-'+t); if(p) p.className='panel'+(t===name?' active':'');
    });
    Array.prototype.forEach.call(document.querySelectorAll('#tabs button'),function(b){
      b.className = b.getAttribute('data-tab')===name ? 'active' : '';
    });
    try{ localStorage.setItem('gmb-webapp-tab',name); }catch(e){}
    if(location.hash!=='#'+name) history.replaceState(null,'','#'+name);
    if(name==='agents') refreshAgents();
    if(name==='teams') refreshTeams();
    if(name==='log') refreshEvents();
    if(name==='workflows') refreshWorkflows();
    if(name==='memory') refreshMemory();
    if(name==='brain') brainList();
  }
  function wireTabs(){
    el('tabs').addEventListener('click',function(ev){
      var b=ev.target.closest('button[data-tab]'); if(b) showTab(b.getAttribute('data-tab'));
    });
    window.addEventListener('hashchange',function(){ showTab((location.hash||'#agents').slice(1)); });
  }

  // ---------- polling ----------
  function tick(){
    if(S.paused) return;
    refreshStatus().then(function(st){
      if(!st) return;
      var tab=(location.hash||'#agents').slice(1);
      if(tab==='agents') refreshAgents();
      else if(tab==='teams') refreshTeams();
      else if(tab==='log') refreshEvents();
    });
  }
  function startPolling(){
    setInterval(tick, S.refreshMs>0?S.refreshMs:2500);
  }
  function wirePause(){
    el('btn-pause').addEventListener('click',function(){
      S.paused=!S.paused;
      el('btn-pause').textContent = S.paused ? '▶ resume' : '⏸ pause';
      toast(S.paused?'polling paused':'polling active');
      if(!S.paused) tick();
    });
  }

  // ---------- init ----------
  wireTabs(); wireAgents(); wireTeams(); wireLog(); wireWorkflows(); wireMemory(); wireBrain(); wireCanvas(); wireWasm(); wirePause();
  var initial=(location.hash||'').slice(1);
  if(!initial){ try{ initial=localStorage.getItem('gmb-webapp-tab')||'agents'; }catch(e){ initial='agents'; } }
  refreshStatus().then(function(){ showTab(initial); startPolling(); });
})();
</script>
</body>
</html>
