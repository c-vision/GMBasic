<%@ IMPORT JSON, AI, MEMORY %>
<%@ IMPORT DASHBOARD %>
<%
  ' FILE: webapp/pages/index.bsp — WEBAPP Agents Dashboard (C1b) + Canvas/WASM tabs
  ' 5 tab: Agents · Teams · Log · Canvas · WASM
  ' Sorgente di verità del markup: l'utente modifica qui HTML/CSS/JS senza toccare C#.
  ' Dati: SSR via AI.AGENTLIST/TEAMLIST/AGENTEVENTS (zero JS, zero CORS) + JS fetch live
  ' su /api/* (same-origin via proxy BASIC in webapp/app.bas quando serve).
  ' Include: WebCanvas/WasmBridge inclusi solo nella tab dedicata per non appesantire le 3 C1b.
%>
<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>GMBasic — Agents Operating Center</title>
<style>
  :root { color-scheme: light dark; }
  * { box-sizing: border-box; margin: 0; }
  body {
    font-family: -apple-system, "Segoe UI", Roboto, sans-serif;
    background: #f4f6fb; color: #1c2430; line-height: 1.5; padding: 0;
  }
  header {
    background: linear-gradient(135deg, #1e293b, #334155);
    color: #fff; padding: 1.6rem 2rem;
  }
  header h1 { font-size: 1.5rem; letter-spacing: .3px; }
  header p { color: #cbd5e1; margin-top: .3rem; font-size: .9rem; }
  header .hint { color: #93c5fd; font-size: .82rem; margin-top: .4rem; }
  .tabs {
    display: flex; gap: .45rem; padding: .9rem 2rem; background: #fff;
    border-bottom: 1px solid #e2e8f0; flex-wrap: wrap;
  }
  .tab {
    padding: .5rem .95rem; border-radius: 8px; cursor: pointer; font-weight: 600;
    border: 1px solid #e2e8f0; background: #f8fafc; color: #334155; font-size: .86rem;
  }
  .tab.active { background: #2563eb; color: #fff; border-color: #2563eb; }
  .panel { display: none; max-width: 1020px; margin: 1.4rem auto; padding: 0 1.5rem; }
  .panel.active { display: block; }
  .card {
    background: #fff; border: 1px solid #e2e8f0; border-radius: 12px;
    box-shadow: 0 1px 3px rgba(15,23,42,.06); overflow: hidden;
  }
  table { width: 100%; border-collapse: collapse; }
  th {
    text-align: left; font-size: .72rem; text-transform: uppercase;
    letter-spacing: .5px; color: #64748b; background: #f8fafc;
    padding: .6rem .9rem; border-bottom: 1px solid #e2e8f0;
  }
  td { padding: .75rem .9rem; border-bottom: 1px solid #f1f5f9; font-size: .9rem; }
  tr:last-child td { border-bottom: 0; }
  tr:hover td { background: #f8fafc; }
  .name { font-weight: 600; color: #2563eb; }
  .ver { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .82rem; color: #334155; }
  .muted { color: #94a3b8; }
  .empty { text-align: center; color: #94a3b8; padding: 1.2rem !important; }
  .badge {
    display: inline-block; font-size: .68rem; font-weight: 600;
    padding: .15rem .5rem; border-radius: 999px; background: #e2e8f0; color: #334155;
  }
  .badge.idle { background: #e0e7ff; color: #3730a3; }
  .badge.working, .badge.executing { background: #fef3c7; color: #92400e; }
  .badge.planning { background: #d1fae5; color: #065f46; }
  .badge.waiting { background: #fce7f3; color: #9d174d; }
  .badge.perm-yolo { background: #fee2e2; color: #991b1b; }
  .badge.perm-supervised { background: #fef9c3; color: #854d0e; }
  .badge.perm-sandbox { background: #dcfce7; color: #166534; }
  .badge.strategy { background: #e0f2fe; color: #0c4a6e; }
  .btn {
    display: inline-block; padding: .4rem .75rem; border-radius: 8px;
    font-size: .82rem; font-weight: 600; cursor: pointer; border: none;
  }
  .btn-ghost { background: #eef2ff; color: #3730a3; }
  .btn-primary { background: #2563eb; color: #fff; }
  .btn:active { transform: scale(.98); }
  .toolbar { display: flex; gap: .6rem; align-items: center; margin: 1rem 0 .8rem; flex-wrap: wrap; }
  .toolbar input { padding: .5rem .7rem; border: 1px solid #e2e8f0; border-radius: 8px; font-size: .9rem; }
  .toolbar input:focus { outline: 2px solid #93c5fd; border-color: #93c5fd; }
  pre.json { background: #0f172a; color: #e2e8f0; border-radius: 8px; padding: .8rem 1rem; font-size: .82rem; overflow-x: auto; }
  .hint-box { background: #fffbeb; border: 1px solid #fde68a; border-radius: 8px; padding: .7rem .9rem; font-size: .84rem; color: #92400e; margin: .8rem 0; }
  canvas.gmb-canvas { border: 1px solid #e2e8f0; border-radius: 12px; background: #fff; display: block; margin: .8rem 0; }
</style>
</head>
<body>
<header>
  <h1>GMBasic — Agents Operating Center</h1>
  <p>5 tab: Agents · Teams · Log · Canvas · WASM — SSR via AI.* + live fetch su /api/*</p>
  <p class="hint">Editabile in BASIC: <code>webapp/pages/index.bsp</code> + <code>include/AgentsDashboard.inc</code> + <code>WebCanvas.inc</code> + <code>WasmBridge.inc</code></p>
</header>

<nav class="tabs" role="tablist">
  <button class="tab active" data-tab="agents">Agents</button>
  <button class="tab" data-tab="teams">Teams</button>
  <button class="tab" data-tab="log">Log</button>
  <button class="tab" data-tab="canvas">Canvas</button>
  <button class="tab" data-tab="wasm">WASM</button>
</nav>

<!-- ===================== TAB: AGENTS ===================== -->
<section id="panel-agents" class="panel active">
  <h2>Agents</h2>
  <p class="muted" style="font-size:.84rem;margin:.3rem 0 .8rem">Lista da <code>AI.AGENTLIST()</code> (SSR) + live <code>GET /api/agents</code>. Chat via <code>POST /api/agent/{n}/prompt</code>.</p>
  <div class="card">
    <table>
      <thead><tr><th>Name</th><th>Status</th><th>Permission</th><th>Teams</th><th>Model</th><th>Actions</th></tr></thead>
      <tbody id="agents-body">
        <%
          DIM anames() = AI.AGENTLIST()
          IF UBOUND(anames) < 0 THEN
            PRINT DASHBOARD.EmptyRowHtml(6, "Nessun agente — crea con AI AGENT CREATE Demo")
          ELSE
            FOR i = 0 TO UBOUND(anames)
              DIM nm$ = anames(i)
              DIM perm$ = AI.AGENTGET(nm$, "permission")
              IF perm$ = "" THEN perm$ = "YOLO"
              DIM model$ = AI.AGENTGET(nm$, "model")
              ' teams via helper: se GetTeamsJson non espone teams per agent, placeholder "-"
              PRINT DASHBOARD.AgentRowRichHtml(nm$, "Idle", perm$, "-", model$)
            NEXT i
          END IF
        %>
      </tbody>
    </table>
  </div>
  <div class="toolbar">
    <input id="chat-agent" placeholder="agent name" style="width:160px">
    <input id="chat-prompt" placeholder="prompt" style="flex:1;min-width:220px">
    <button class="btn btn-primary" onclick="sendPrompt()">Send</button>
  </div>
  <pre id="chat-answer" class="json" style="display:none"></pre>
  <div class="hint-box">Suggerimento: <code>AI AGENT TRACE VERBOSE</code> prima di chattare per popolare il Log.</div>
</section>

<!-- ===================== TAB: TEAMS ===================== -->
<section id="panel-teams" class="panel">
  <h2>Teams</h2>
  <p class="muted" style="font-size:.84rem;margin:.3rem 0 .8rem">Lista da <code>AI.TEAMLIST()</code> (SSR) + live <code>GET /api/teams</code>.</p>
  <div class="card">
    <table>
      <thead><tr><th>Name</th><th>Strategy</th><th>Members</th><th>Actions</th></tr></thead>
      <tbody id="teams-body">
        <%
          ' AI.TEAMLIST() ritorna i NOMI separati da CHR$(10) (non un array, non JSON):
          ' si normalizza con SPLIT, come MEMORY.LIST().
          DIM tl$ = AI.TEAMLIST()
          IF LEN(tl$) = 0 THEN
            PRINT DASHBOARD.EmptyRowHtml(4, "Nessun team — crea con AI TEAM CREATE MyTeam")
          ELSE
            DIM tnames() AS STRING = SPLIT(tl$, CHR$(10))
            FOR i = 0 TO UBOUND(tnames)
              IF LEN(TRIM$(tnames(i))) > 0 THEN PRINT DASHBOARD.TeamRowHtml(TRIM$(tnames(i)), "-", 0)
            NEXT i
          END IF
        %>
      </tbody>
    </table>
  </div>
  <div class="toolbar">
    <input id="team-name" placeholder="team name" style="width:180px">
    <input id="team-msg" placeholder="broadcast message" style="flex:1;min-width:220px">
    <button class="btn btn-ghost" onclick="teamBroadcast()">Broadcast</button>
  </div>
  <pre id="team-answer" class="json" style="display:none"></pre>
</section>

<!-- ===================== TAB: LOG ===================== -->
<section id="panel-log" class="panel">
  <h2>Log / Events</h2>
  <p class="muted" style="font-size:.84rem;margin:.3rem 0 .8rem">Ring buffer <code>AI.AGENTEVENTS()</code> (500, solo se <code>TRACE ON|VERBOSE</code>) + live <code>GET /api/events</code> (V1.1, fallback SSR).</p>
  <div class="card">
    <table>
      <thead><tr><th>Event</th></tr></thead>
      <tbody id="log-body">
        <%
          DIM evs() = AI.AGENTEVENTS()
          IF UBOUND(evs) < 0 THEN
            PRINT "<tr><td class='empty'>Nessun evento — attiva con AI AGENT TRACE VERBOSE e fai una ASK</td></tr>"
          ELSE
            FOR i = 0 TO UBOUND(evs)
              PRINT "<tr><td class='detail'>" + evs(i) + "</td></tr>"
            NEXT i
          END IF
        %>
      </tbody>
    </table>
  </div>
  <div class="toolbar">
    <button class="btn btn-ghost" onclick="refreshLog()">Refresh</button>
    <span class="muted" style="font-size:.82rem">Polling <code>DASHBOARD.REFRESH_MS%</code> = <%= DASHBOARD.REFRESH_MS% %> ms</span>
  </div>
  <h3 style="margin:1.2rem 0 .6rem">Workflows</h3>
  <p class="muted" style="font-size:.82rem;margin:.2rem 0 .6rem">CRUD via <code>POST /api/workflows</code> / <code>POST /api/workflows/{n}/steps</code> / <code>POST /api/workflows/{n}/execute</code> — senza toccare C#, solo BASIC + JS.</p>
  <div class="card">
    <table>
      <thead><tr><th>Name</th><th>Status</th><th>Steps</th><th>Actions</th></tr></thead>
      <tbody id="workflows-body">
        <%
          ' AI.WorkflowList() ritorna i NOMI separati da CHR$(10) (stringa, non array).
          DIM wl$ = AI.WorkflowList()
          IF LEN(wl$) = 0 THEN
            PRINT "<tr><td colspan='4' class='empty'>Nessun workflow — crea con AI WORKFLOW name + STEP o col form sotto</td></tr>"
          ELSE
            DIM wfs() AS STRING = SPLIT(wl$, CHR$(10))
            FOR i = 0 TO UBOUND(wfs)
              DIM wname AS STRING = TRIM$(wfs(i))
              IF LEN(wname) > 0 THEN
                DIM wstatus AS STRING = AI.WorkflowStatus(wname)
                DIM wsteps AS STRING = AI.WorkflowSteps(wname)
                PRINT "<tr><td class='name'>" + wname + "</td><td><span class='badge'>" + wstatus + "</span></td><td class='muted'>" + wsteps + "</td><td><button class='btn btn-ghost' onclick=""wfPick('" + wname + "')"">Pick</button> <button class='btn btn-ghost' onclick=""wfExecPick('" + wname + "')"">Run</button></td></tr>"
              END IF
            NEXT i
          END IF
        %>
      </tbody>
    </table>
  </div>
  <div class="toolbar">
    <input id="wf-name" placeholder="workflow name" style="width:150px">
    <button class="btn btn-ghost" onclick="wfCreate()">Create</button>
    <input id="wf-step-name" placeholder="step name" style="width:120px">
    <input id="wf-step-action" placeholder="action" style="flex:1;min-width:130px">
    <button class="btn btn-ghost" onclick="wfAddStep()">Add Step</button>
    <button class="btn btn-primary" onclick="wfExecute()">Execute</button>
    <button class="btn btn-ghost" onclick="wfDelete()" style="background:#fee2e2;color:#991b1b">Delete</button>
  </div>
  <pre id="wf-answer" class="json" style="display:none"></pre>

  <h3 style="margin:1.4rem 0 .6rem">Memory — <span class="muted" style="font-weight:400">MEMORY.STORE/LOAD + Brain</span></h3>
  <p class="muted" style="font-size:.82rem;margin:.2rem 0 .6rem">Key-value <code>MEMORY.*</code> via <code>/api/memory</code> + Second Brain <code>AI.MEMORYASK</code> via <code>/api/brain/search</code>. Editabile senza C#.</p>
  <div class="card">
    <table>
      <thead><tr><th>Key</th><th>Actions</th></tr></thead>
      <tbody id="memory-body">
        <%
          DIM mlist$ = MEMORY.LIST()
          IF mlist$ = "" THEN
            PRINT "<tr><td colspan='2' class='empty'>Nessuna chiave — usa MEMORY.STORE o il form sotto</td></tr>"
          ELSE
            DIM mkeys() AS STRING = SPLIT(mlist$, CHR$(10))
            FOR i = 0 TO UBOUND(mkeys)
              DIM mk$ = TRIM$(mkeys(i))
              IF mk$ <> "" THEN PRINT "<tr><td class='name'>" + mk$ + "</td><td><button class='btn btn-ghost' onclick=""memPick('" + mk$ + "')"">Pick</button> <button class='btn btn-ghost' onclick=""memLoadKey('" + mk$ + "')"">Load</button></td></tr>"
            NEXT i
          END IF
        %>
      </tbody>
    </table>
  </div>
  <div class="toolbar">
    <input id="mem-key" placeholder="key" style="width:160px">
    <input id="mem-value" placeholder="value" style="flex:1;min-width:160px">
    <button class="btn btn-ghost" onclick="memStore()">Store</button>
    <button class="btn btn-ghost" onclick="memLoad()">Load</button>
    <button class="btn btn-ghost" onclick="memDelete()" style="background:#fee2e2;color:#991b1b">Delete</button>
  </div>
  <div class="toolbar">
    <input id="mem-search" placeholder="pattern (es. test)" style="flex:1;min-width:160px">
    <button class="btn btn-ghost" onclick="memSearch()">Search</button>
    <input id="brain-query" placeholder="brain query" style="flex:1;min-width:160px">
    <button class="btn btn-ghost" onclick="brainSearch()">Brain Ask</button>
  </div>
  <div class="toolbar">
    <input id="brain-note" placeholder="nuova nota Second Brain…" style="flex:1;min-width:220px">
    <button class="btn btn-ghost" onclick="brainNote()">Add Note</button>
    <input id="brain-fact" placeholder="fatto durevole…" style="flex:1;min-width:160px">
    <button class="btn btn-ghost" onclick="brainSave()">Save Fact</button>
  </div>
  <div class="toolbar">
    <input id="brain-watch" placeholder="watch path (es. /tmp/note.md)" style="flex:1;min-width:180px">
    <button class="btn btn-ghost" onclick="brainWatch()">Watch</button>
    <input id="brain-import" placeholder="import file path" style="flex:1;min-width:160px">
    <button class="btn btn-ghost" onclick="brainImport()">Import</button>
    <button class="btn btn-ghost" onclick="brainRefresh()">Refresh</button>
    <button class="btn btn-ghost" onclick="brainConsolidate()">Consolidate</button>
    <button class="btn btn-ghost" onclick="brainList()">List</button>
  </div>
  <pre id="memory-answer" class="json" style="display:none"></pre>

  <h3 style="margin:1.4rem 0 .6rem">Summary — <span class="muted" style="font-weight:400">AI.ENRICH SUMMARIZATION</span></h3>
  <p class="muted" style="font-size:.82rem;margin:.2rem 0 .6rem">Sintesi via <code>POST /api/enrich {"text","mode":"SUMMARIZATION"}</code> (richiede <code>AI SET ACTIVE %CHAT</code>). Fallback: errore 200 con hint se nessun LLM.</p>
  <div class="card" style="padding:.9rem">
    <textarea id="summary-text" placeholder="Incolla qui il testo da riassumere…" style="width:100%;min-height:90px;padding:.6rem;border:1px solid #e2e8f0;border-radius:8px;font-family:inherit;font-size:.9rem"></textarea>
    <div class="toolbar" style="margin:.7rem 0 0">
      <select id="summary-mode" style="padding:.5rem .6rem;border:1px solid #e2e8f0;border-radius:8px;font-size:.9rem">
        <option value="SUMMARIZATION">SUMMARIZATION</option>
        <option value="TAGGING">TAGGING</option>
        <option value="ENTITY_EXTRACTION">ENTITY_EXTRACTION</option>
      </select>
      <button class="btn btn-primary" onclick="doEnrich()">Summarize</button>
      <span class="muted" style="font-size:.82rem" id="summary-hint"></span>
    </div>
  </div>
  <pre id="summary-answer" class="json" style="display:none"></pre>
</section>

<!-- ===================== TAB: CANVAS ===================== -->
<section id="panel-canvas" class="panel">
  <h2>Canvas Remoto (WebSocket)</h2>
  <p class="muted" style="font-size:.84rem;margin:.3rem 0 .8rem">Grafica remota: <code>WEBCANVAS.PSet/Line/Rect/Circle/Sprite</code> in BASIC → WS <code>{op:"pset"}</code> → <code>canvas.js:CanvasReplay</code> su <code>&lt;canvas&gt;</code>. Editabile in <code>include/WebCanvas.inc</code> + <code>webapp/static/canvas.js</code>.</p>
  <canvas id="gmb-canvas" class="gmb-canvas" width="800" height="480"></canvas>
  <div class="toolbar">
    <button class="btn btn-primary" onclick="canvasDemo()">Demo draw</button>
    <button class="btn btn-ghost" onclick="canvasClear()">Clear</button>
    <span class="muted" style="font-size:.82rem">WS: <code id="canvas-ws-status">disconnected</code></span>
  </div>
  <div class="hint-box">Avvio: <code>webapp/app.bas</code> registra <code>GET /ws/canvas</code> → <code>WEBCANVAS.Init(ws)</code> + demo. Oppure apri <a href="/canvas.bsp"><code>/canvas.bsp</code></a> standalone.</div>
  <pre id="canvas-log" class="json" style="display:none"></pre>
</section>

<!-- ===================== TAB: WASM ===================== -->
<section id="panel-wasm" class="panel">
  <h2>WASM — Esegui BASIC nel browser</h2>
  <p class="muted" style="font-size:.84rem;margin:.3rem 0 .8rem">Target <code>.bas → .wasm</code> via <code>clang --target=wasm32</code>. Import JS dichiarati in <code>include/WasmBridge.inc</code> (<code>DECLARE LIB "env"</code>), glue in <code>webapp/static/wasm.js</code>.</p>
  <canvas id="wasm-canvas" class="gmb-canvas" width="800" height="480"></canvas>
  <div class="toolbar">
    <button class="btn btn-primary" onclick="wasmLoad()">Load prog.wasm</button>
    <button class="btn btn-ghost" onclick="wasmDemo()">Demo draw (JS)</button>
    <span class="muted" style="font-size:.82rem" id="wasm-status">idle</span>
  </div>
  <div class="hint-box">
    Compilazione oggi (POC, zero C#):<br>
    <code>dotnet run --project REPL/REPL.csproj -- -c99 prog.bas -o /tmp/prog.c</code><br>
    <code>clang --target=wasm32 -o webapp/static/prog.wasm /tmp/prog.c native/gmb_runtime_c/src/*.c</code><br>
    Futuro: <code>gmb prog.bas -target wasm -o webapp/static/prog.wasm</code> + <a href="/wasm.bsp"><code>/wasm.bsp</code> standalone</a>
  </div>
  <pre id="wasm-log" class="json">WasmBridge: <%= WASMBRIDGE.Info() %></pre>
</section>

<script src="/static/canvas.js"></script>
<script src="/static/wasm.js"></script>
<script>
  // --- Tab switch (vanilla, editabile) ---
  document.querySelectorAll('.tab').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      document.querySelectorAll('.tab').forEach(b=>b.classList.remove('active'));
      document.querySelectorAll('.panel').forEach(p=>p.classList.remove('active'));
      btn.classList.add('active');
      document.getElementById('panel-'+btn.dataset.tab).classList.add('active');
    });
  });

  // --- Agents live refresh (same-origin /api via proxy BASIC se cross-port) ---
  async function refreshAgents(){
    try{
      const r = await fetch('/api/agents');
      if(!r.ok) return;
      const j = await r.json();
      const tb = document.getElementById('agents-body');
      if(!Array.isArray(j) || j.length===0) return;
      tb.innerHTML = j.map(a=>`<tr><td class="name">${esc(a.name)}</td><td>${badge(a.status)}</td><td>${permBadge(a.permission)}</td><td class="teams">${esc((a.teams||[]).join(', ')||'-')}</td><td class="ver">${esc(a.model||'-')}</td><td><button class="btn btn-ghost" onclick="chat('${esc(a.name)}')">Chat</button></td></tr>`).join('');
    }catch(e){}
  }
  async function refreshTeams(){
    try{
      const r = await fetch('/api/teams');
      if(!r.ok) return;
      const j = await r.json();
      const tb = document.getElementById('teams-body');
      if(!Array.isArray(j) || j.length===0) return;
      tb.innerHTML = j.map(t=>`<tr><td class="name">${esc(t.name)}</td><td><span class="badge strategy">${esc(t.strategy)}</span></td><td class="count">${t.memberCount||0}</td><td><button class="btn btn-ghost" onclick="teamChat('${esc(t.name)}')">Broadcast</button></td></tr>`).join('');
    }catch(e){}
  }
  async function refreshLog(){
    try{
      const r = await fetch('/api/events');
      if(r.ok){
        const j = await r.json();
        const tb = document.getElementById('log-body');
        if(Array.isArray(j) && j.length>0){
          tb.innerHTML = j.map(e=>`<tr><td class="detail"><span class="badge">${esc(e.kind||'')}</span> <b>${esc(e.agent||'')}</b> ${esc(e.detail||e.text||JSON.stringify(e))} <span class="muted">${esc(e.timestamp||'')}</span></td></tr>`).join('');
          return;
        }
      }
    }catch(e){}
    // fallback: resta SSR
  }
  async function refreshWorkflows(){
    try{
      const r=await fetch('/api/workflows');
      if(!r.ok) return;
      const j=await r.json();
      const tb=document.getElementById('workflows-body');
      if(!Array.isArray(j) || j.length===0) return;
      tb.innerHTML=j.map(w=>`<tr><td class="name">${esc(w.name)}</td><td><span class="badge">${esc(w.status)}</span></td><td class="muted">${esc((w.steps||[]).join(', ')||'-')}</td><td><button class="btn btn-ghost" onclick="wfPick('${esc(w.name)}')">Pick</button> <button class="btn btn-ghost" onclick="wfExecPick('${esc(w.name)}')">Run</button> <button class="btn btn-ghost" onclick="wfPick('${esc(w.name)}');wfDelete()" style="color:#991b1b">Del</button></td></tr>`).join('');
    }catch(e){}
  }
  function badge(s){ s=s||'Idle'; const k=s.toLowerCase(); if(k==='idle') return `<span class="badge idle">${esc(s)}</span>`; if(k==='working'||k==='executing') return `<span class="badge working">${esc(s)}</span>`; return `<span class="badge">${esc(s)}</span>`; }
  function permBadge(p){ p=p||'YOLO'; const k=p.toLowerCase(); if(k==='yolo') return `<span class="badge perm-yolo">YOLO</span>`; if(k==='supervised') return `<span class="badge perm-supervised">Supervised</span>`; if(k==='sandbox') return `<span class="badge perm-sandbox">Sandbox</span>`; return `<span class="badge">${esc(p)}</span>`; }
  function esc(s){ return String(s??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
  function chat(name){ document.getElementById('chat-agent').value=name; document.querySelector('[data-tab=agents]').click(); }
  function teamChat(name){ document.getElementById('team-name').value=name; document.querySelector('[data-tab=teams]').click(); }

  async function sendPrompt(){
    const agent=document.getElementById('chat-agent').value.trim();
    const prompt=document.getElementById('chat-prompt').value.trim();
    const out=document.getElementById('chat-answer');
    if(!agent||!prompt){ out.style.display='block'; out.textContent='{"error":"agent and prompt required"}'; return; }
    out.style.display='block'; out.textContent='…';
    try{
      const r=await fetch(`/api/agent/${encodeURIComponent(agent)}/prompt`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({prompt})});
      const j=await r.json(); out.textContent=JSON.stringify(j,null,2);
      refreshLog();
    }catch(e){ out.textContent='{"error":"'+esc(e.message)+'"}'; }
  }
  async function teamBroadcast(){
    const team=document.getElementById('team-name').value.trim();
    const msg=document.getElementById('team-msg').value.trim();
    const out=document.getElementById('team-answer');
    if(!team||!msg){ out.style.display='block'; out.textContent='{"error":"team and message required"}'; return; }
    out.style.display='block'; out.textContent='…';
    try{
      // V1: via WS o HTTP custom; fallback: POST su /api/teams/{team}/broadcast se implementata, altrimenti hint
      const r=await fetch(`/api/team/${encodeURIComponent(team)}/broadcast`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({message:msg})});
      const j=await r.json().catch(()=>({status:r.status}));
      out.textContent=JSON.stringify(j,null,2);
    }catch(e){ out.textContent='{"error":"'+esc(e.message)+'","hint":"Implementa POST /api/team/{name}/broadcast in IlRuntime.cs o via AI TEAM BROADCAST in app.bas"}'; }
  }

  // --- Workflows (V1.2e) ---
  function wfPick(n){ document.getElementById('wf-name').value=n; }
  async function wfExecPick(n){ document.getElementById('wf-name').value=n; await wfExecute(); }
  async function wfCreate(){
    const name=document.getElementById('wf-name').value.trim();
    const out=document.getElementById('wf-answer');
    if(!name){ out.style.display='block'; out.textContent='{"error":"workflow name required"}'; return; }
    out.style.display='block'; out.textContent='…';
    try{ const r=await fetch('/api/workflows',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name})}); const j=await r.json(); out.textContent=JSON.stringify(j,null,2); refreshWorkflows(); }catch(e){ out.textContent='{"error":"'+esc(e.message)+'"}'; }
  }
  async function wfAddStep(){
    const wf=document.getElementById('wf-name').value.trim();
    const step=document.getElementById('wf-step-name').value.trim();
    const action=document.getElementById('wf-step-action').value.trim();
    const out=document.getElementById('wf-answer');
    if(!wf||!step){ out.style.display='block'; out.textContent='{"error":"workflow and step required"}'; return; }
    out.style.display='block'; out.textContent='…';
    try{ const r=await fetch(`/api/workflows/${encodeURIComponent(wf)}/steps`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name:step,action})}); const j=await r.json(); out.textContent=JSON.stringify(j,null,2); refreshWorkflows(); }catch(e){ out.textContent='{"error":"'+esc(e.message)+'"}'; }
  }
  async function wfExecute(){
    const wf=document.getElementById('wf-name').value.trim();
    const out=document.getElementById('wf-answer');
    if(!wf){ out.style.display='block'; out.textContent='{"error":"workflow name required"}'; return; }
    out.style.display='block'; out.textContent='…';
    try{ const r=await fetch(`/api/workflows/${encodeURIComponent(wf)}/execute`,{method:'POST',headers:{'Content-Type':'application/json'},body:'{}'}); const j=await r.json(); out.textContent=JSON.stringify(j,null,2); refreshWorkflows(); refreshLog(); }catch(e){ out.textContent='{"error":"'+esc(e.message)+'"}'; }
  }
  async function wfDelete(){
    const wf=document.getElementById('wf-name').value.trim();
    const out=document.getElementById('wf-answer');
    if(!wf){ out.style.display='block'; out.textContent='{"error":"workflow name required"}'; return; }
    if(!confirm('Delete workflow '+wf+'?')) return;
    out.style.display='block'; out.textContent='…';
    try{ const r=await fetch(`/api/workflows/${encodeURIComponent(wf)}`,{method:'DELETE'}); const j=await r.json(); out.textContent=JSON.stringify(j,null,2); refreshWorkflows(); }catch(e){ out.textContent='{"error":"'+esc(e.message)+'"}'; }
  }

  // --- Memory / Brain / Summary (V1.2g) ---
  async function refreshMemory(){
    try{
      const r=await fetch('/api/memory');
      if(!r.ok) return;
      const j=await r.json();
      const tb=document.getElementById('memory-body');
      if(!j.keys || j.keys.length===0){ tb.innerHTML=`<tr><td colspan='2' class='empty'>Nessuna chiave</td></tr>`; return; }
      tb.innerHTML=j.keys.map(k=>`<tr><td class="name">${esc(k)}</td><td><button class="btn btn-ghost" onclick="memPick('${esc(k)}')">Pick</button> <button class="btn btn-ghost" onclick="memLoadKey('${esc(k)}')">Load</button></td></tr>`).join('');
    }catch(e){}
  }
  function memPick(k){ document.getElementById('mem-key').value=k; }
  async function memLoadKey(k){ document.getElementById('mem-key').value=k; await memLoad(); }
  async function memStore(){
    const key=document.getElementById('mem-key').value.trim();
    const value=document.getElementById('mem-value').value;
    const out=document.getElementById('memory-answer');
    if(!key){ out.style.display='block'; out.textContent='{"error":"key required"}'; return; }
    out.style.display='block'; out.textContent='…';
    try{ const r=await fetch('/api/memory',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({key,value})}); const j=await r.json(); out.textContent=JSON.stringify(j,null,2); refreshMemory(); }catch(e){ out.textContent='{"error":"'+esc(e.message)+'"}'; }
  }
  async function memLoad(){
    const key=document.getElementById('mem-key').value.trim();
    const out=document.getElementById('memory-answer');
    if(!key){ out.style.display='block'; out.textContent='{"error":"key required"}'; return; }
    out.style.display='block'; out.textContent='…';
    try{ const r=await fetch(`/api/memory?key=${encodeURIComponent(key)}`); const j=await r.json(); out.textContent=JSON.stringify(j,null,2); if(j.value!==undefined) document.getElementById('mem-value').value=j.value; }catch(e){ out.textContent='{"error":"'+esc(e.message)+'"}'; }
  }
  async function memDelete(){
    const key=document.getElementById('mem-key').value.trim();
    const out=document.getElementById('memory-answer');
    if(!key){ out.style.display='block'; out.textContent='{"error":"key required"}'; return; }
    out.style.display='block'; out.textContent='…';
    try{ const r=await fetch(`/api/memory?key=${encodeURIComponent(key)}`,{method:'DELETE'}); const j=await r.json(); out.textContent=JSON.stringify(j,null,2); refreshMemory(); }catch(e){ out.textContent='{"error":"'+esc(e.message)+'"}'; }
  }
  async function memSearch(){
    const pat=document.getElementById('mem-search').value.trim();
    const out=document.getElementById('memory-answer');
    out.style.display='block'; out.textContent='…';
    try{ const r=await fetch(`/api/memory/search?pattern=${encodeURIComponent(pat||'')}`); const j=await r.json(); out.textContent=JSON.stringify(j,null,2); const tb=document.getElementById('memory-body'); if(j.keys) tb.innerHTML=j.keys.map(k=>`<tr><td class="name">${esc(k)}</td><td><button class="btn btn-ghost" onclick="memLoadKey('${esc(k)}')">Load</button></td></tr>`).join('')||`<tr><td colspan='2' class='empty'>Nessun match</td></tr>`; }catch(e){ out.textContent='{"error":"'+esc(e.message)+'"}'; }
  }
  async function brainSearch(){
    const q=document.getElementById('brain-query').value.trim();
    const out=document.getElementById('memory-answer');
    if(!q){ out.style.display='block'; out.textContent='{"error":"query required"}'; return; }
    out.style.display='block'; out.textContent='…';
    try{ const r=await fetch(`/api/brain/search?query=${encodeURIComponent(q)}&topK=5`); const j=await r.json(); out.textContent=JSON.stringify(j,null,2); }catch(e){ out.textContent='{"error":"'+esc(e.message)+'"}'; }
  }
  async function brainNote(){
    const txt=document.getElementById('brain-note').value.trim();
    const out=document.getElementById('memory-answer');
    if(!txt){ out.style.display='block'; out.textContent='{"error":"text required"}'; return; }
    out.style.display='block'; out.textContent='…';
    try{ const r=await fetch('/api/brain/note',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({text:txt})}); const j=await r.json(); out.textContent=JSON.stringify(j,null,2); }catch(e){ out.textContent='{"error":"'+esc(e.message)+'"}'; }
  }
  async function brainSave(){
    const txt=document.getElementById('brain-fact').value.trim();
    const out=document.getElementById('memory-answer');
    if(!txt){ out.style.display='block'; out.textContent='{"error":"fact required"}'; return; }
    out.style.display='block'; out.textContent='…';
    try{ const r=await fetch('/api/brain/save',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({fact:txt})}); const j=await r.json(); out.textContent=JSON.stringify(j,null,2); }catch(e){ out.textContent='{"error":"'+esc(e.message)+'"}'; }
  }
  async function brainWatch(){
    const p=document.getElementById('brain-watch').value.trim();
    const out=document.getElementById('memory-answer');
    if(!p){ out.style.display='block'; out.textContent='{"error":"watch path required"}'; return; }
    out.style.display='block'; out.textContent='…';
    try{ const r=await fetch('/api/brain/watch',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({path:p})}); const j=await r.json(); out.textContent=JSON.stringify(j,null,2); }catch(e){ out.textContent='{"error":"'+esc(e.message)+'"}'; }
  }
  async function brainImport(){
    const p=document.getElementById('brain-import').value.trim();
    const out=document.getElementById('memory-answer');
    if(!p){ out.style.display='block'; out.textContent='{"error":"import path required"}'; return; }
    out.style.display='block'; out.textContent='…';
    try{ const r=await fetch('/api/brain/import',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({path:p})}); const j=await r.json(); out.textContent=JSON.stringify(j,null,2); }catch(e){ out.textContent='{"error":"'+esc(e.message)+'"}'; }
  }
  async function brainRefresh(){
    const out=document.getElementById('memory-answer');
    out.style.display='block'; out.textContent='…';
    try{ const r=await fetch('/api/brain/refresh',{method:'POST',headers:{'Content-Type':'application/json'},body:'{}'}); const j=await r.json(); out.textContent=JSON.stringify(j,null,2); }catch(e){ out.textContent='{"error":"'+esc(e.message)+'"}'; }
  }
  async function brainConsolidate(){
    const out=document.getElementById('memory-answer');
    out.style.display='block'; out.textContent='…';
    try{ const r=await fetch('/api/brain/consolidate',{method:'POST',headers:{'Content-Type':'application/json'},body:'{}'}); const j=await r.json(); out.textContent=JSON.stringify(j,null,2); }catch(e){ out.textContent='{"error":"'+esc(e.message)+'"}'; }
  }
  async function brainList(){
    const out=document.getElementById('memory-answer');
    out.style.display='block'; out.textContent='…';
    try{ const r=await fetch('/api/brain/list?limit=20'); const j=await r.json(); out.textContent=JSON.stringify(j,null,2); }catch(e){ out.textContent='{"error":"'+esc(e.message)+'"}'; }
  }
  async function doEnrich(){
    const text=document.getElementById('summary-text').value.trim();
    const mode=document.getElementById('summary-mode').value;
    const out=document.getElementById('summary-answer');
    const hint=document.getElementById('summary-hint');
    if(!text){ out.style.display='block'; out.textContent='{"error":"text required"}'; return; }
    out.style.display='block'; out.textContent='…'; hint.textContent='…';
    try{ const r=await fetch('/api/enrich',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({text,mode})}); const j=await r.json(); out.textContent=JSON.stringify(j,null,2); hint.textContent=j.summary? j.summary.slice(0,120)+'…' : (j.error||''); }catch(e){ out.textContent='{"error":"'+esc(e.message)+'"}'; hint.textContent='error'; }
  }

  // --- Canvas remoto ---
  let canvasWs = null;
  function canvasConnect(){
    const proto = location.protocol==='https:'?'wss://':'ws://';
    canvasWs = new WebSocket(proto+location.host+'/ws/canvas');
    canvasWs.onopen = ()=>{ document.getElementById('canvas-ws-status').textContent='connected'; };
    canvasWs.onclose = ()=>{ document.getElementById('canvas-ws-status').textContent='disconnected'; };
    canvasWs.onmessage = e=>{
      try{ const cmd=JSON.parse(e.data); CanvasReplay(cmd, document.getElementById('gmb-canvas')); }catch(err){}
    };
  }
  function canvasDemo(){
    const c=document.getElementById('gmb-canvas');
    // fallback locale (senza WS): disegna direttamente col JS del canvas
    CanvasReplay({op:'clear',c:0,v:1}, c);
    CanvasReplay({op:'pset',x:10,y:10,c:4,v:1}, c);
    CanvasReplay({op:'line',x1:0,y1:0,x2:120,y2:120,c:7,v:1}, c);
    CanvasReplay({op:'rect',x:20,y:20,w:60,h:40,c:2,v:1}, c);
    CanvasReplay({op:'circle',x:80,y:80,r:20,c:14,v:1}, c);
    CanvasReplay({op:'text',x:10,y:150,txt:'Hello Canvas',c:7,v:1}, c);
    CanvasReplay({op:'flush',v:1}, c);
    if(canvasWs && canvasWs.readyState===1) canvasWs.send(JSON.stringify({op:'demo'}));
  }
  function canvasClear(){
    CanvasReplay({op:'clear',c:0,v:1}, document.getElementById('gmb-canvas'));
  }

  // --- WASM ---
  async function wasmLoad(){
    const st=document.getElementById('wasm-status');
    st.textContent='loading…';
    try{
      await WasmLoad('/static/prog.wasm', document.getElementById('wasm-canvas'));
      st.textContent='loaded';
    }catch(e){ st.textContent='error: '+e.message; document.getElementById('wasm-log').textContent=String(e); }
  }
  function wasmDemo(){
    const c=document.getElementById('wasm-canvas');
    const ctx=c.getContext('2d');
    ctx.fillStyle='#fff'; ctx.fillRect(0,0,c.width,c.height);
    ctx.fillStyle='#2563eb'; ctx.fillRect(20,20,60,40);
    ctx.beginPath(); ctx.arc(80,80,20,0,Math.PI*2); ctx.strokeStyle='#0c4a6e'; ctx.stroke();
    document.getElementById('wasm-log').textContent='WASM demo (JS fallback, senza .wasm)';
  }

  setInterval(()=>{refreshAgents();refreshTeams();refreshLog();refreshWorkflows();refreshMemory();}, 3000);
  refreshAgents(); refreshTeams(); refreshLog(); refreshWorkflows(); refreshMemory();
  canvasConnect();
</script>
</body>
</html>
