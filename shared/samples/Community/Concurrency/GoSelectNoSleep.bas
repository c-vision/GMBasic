SUB Produttore(C AS CHANNEL OF INTEGER, WG AS WAITGROUP)
  SEND 42 TO C
  SEND 99 TO C
  DONE WG
END SUB

SUB Main()
  DIM C AS CHANNEL OF INTEGER
  DIM WG AS WAITGROUP
  GO SUB Produttore(C, WG) IN WG
  
  DIM V AS INTEGER, I AS INTEGER
  FOR I = 1 TO 2
    GO SELECT
      CASE RECEIVE V FROM C:
        PRINT "Val="; V
    END SELECT
  NEXT I
  WAIT WG
  PRINT "OK"
END SUB
