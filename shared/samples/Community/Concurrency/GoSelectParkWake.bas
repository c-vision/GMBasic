SUB Produttore(C AS CHANNEL OF INTEGER, WG AS WAITGROUP)
  WAIT 200
  SEND 42 TO C
  DONE WG
END SUB
SUB Main()
  DIM C AS CHANNEL OF INTEGER
  DIM WG AS WAITGROUP
  GO SUB Produttore(C, WG) IN WG
  GO SELECT
    CASE RECEIVE V FROM C:
      PRINT "ricevuto="; V
    END SELECT
  WAIT WG
  PRINT "OK"
END SUB
