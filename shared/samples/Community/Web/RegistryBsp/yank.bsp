<%@ IMPORT HTTP, JSON %>
<%@ ROUTE "/yank.bsp" %>
<%
  DIM registry$ = "http://127.0.0.1:8087"
  DIM pkgName$ = REQ.Query["name"]
  DIM pkgVer$ = REQ.Query["version"]
  DIM stato$ = ""
  DIM yanked = 0
  IF pkgName$ <> "" AND pkgVer$ <> "" THEN
    DIM opts AS HTTPOPTIONS = NEW HTTPOPTIONS
    ' il download risponde 410 per le versioni yanked: lo usiamo come sonda
    DIM r AS FETCHRESULT
    r = FETCH(registry$ + "/download/" + pkgName$ + "/" + pkgVer$, opts)
    IF r.StatusCode = 410 THEN yanked = 1
    IF r.StatusCode = 200 THEN yanked = 0
  END IF
%>
<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Yank — GMBasic Registry</title>
<style>
  :root { color-scheme: light dark; }
  * { box-sizing: border-box; margin: 0; }
  body { font-family: -apple-system, "Segoe UI", Roboto, sans-serif; background: #f4f6fb; color: #1c2430; line-height: 1.5; padding: 0; }
  header { background: linear-gradient(135deg, #1e293b, #334155); color: #fff; padding: 2rem 2.5rem; }
  header h1 { font-size: 1.5rem; }
  header a { color: #93c5fd; text-decoration: none; font-size: .9rem; }
  main { max-width: 560px; margin: 2rem auto; padding: 0 1.5rem; }
  .card { background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.5rem; box-shadow: 0 1px 3px rgba(15,23,42,.06); }
  input, button { width: 100%; padding: .6rem .8rem; border-radius: 8px; font-size: .95rem; margin-top: .6rem; }
  input { border: 1px solid #cbd5e1; }
  button { border: 0; background: #d97706; color: #fff; font-weight: 600; cursor: pointer; }
  .info { margin-top: 1rem; padding: .8rem; border-radius: 8px; background: #f8fafc; font-size: .85rem; }
  .yanked { background: #fef2f2; color: #991b1b; }
  pre { background: #0f172a; color: #e2e8f0; border-radius: 8px; padding: .8rem; overflow-x: auto; font-size: .82rem; margin-top: .8rem; }
</style>
</head>
<body>
<header>
  <h1>Yank / Unyank</h1>
  <p><a href="/index.bsp">&larr; Torna al registry</a></p>
</header>
<main>
  <div class="card">
    <form method="GET" action="/yank.bsp">
      <input name="name" placeholder="Nome pacchetto">
      <input name="version" placeholder="Versione (es. 1.0.1)">
      <button type="submit">Verifica</button>
    </form>
    <% IF pkgName$ <> "" AND pkgVer$ <> "" THEN %>
      <% IF yanked = 1 THEN %>
        <div class="info yanked">La versione <%= pkgName$ %>@<%= pkgVer$ %> è <strong>yanked</strong>
          (il download risponde 410).</div>
      <% ELSE %>
        <div class="info">La versione <%= pkgName$ %>@<%= pkgVer$ %> è <strong>attiva</strong>.</div>
      <% END IF %>
      <p style="margin-top:1rem;font-size:.85rem;color:#64748b">Ritira/riabilita con la CLI
         (solo owner/collaboratori):</p>
      <pre>gmb pkg yank <%= pkgName$ %> <%= pkgVer$ %> --reason "motivo"   ' yank
gmb pkg yank <%= pkgName$ %> <%= pkgVer$ %> --un                   ' unyank</pre>
    <% END IF %>
  </div>
</main>
</body>
</html>
