<%@ IMPORT HTTP, JSON %>
<%@ ROUTE "/packages/{name}" %>
<%
  DIM name = QUERY["name"]
  DIM registry$ = "http://127.0.0.1:8087"
  DIM opts AS HTTPOPTIONS = NEW HTTPOPTIONS
  DIM r = FETCH(registry$ + "/api/packages/" + name, opts)
  DIM m = JSON.PARSE(r.Body)
  DIM dlHref$ = "/download/" + m["name"] + "/" + m["version"]
  DIM installCmd$ = "PACKAGE INSTALL " + m["name"]
%>
<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= m["name"] %> — GMBasic Registry</title>
<style>
  :root { color-scheme: light dark; }
  * { box-sizing: border-box; margin: 0; }
  body {
    font-family: -apple-system, "Segoe UI", Roboto, sans-serif;
    background: #f4f6fb; color: #1c2430; line-height: 1.55; padding: 0;
  }
  header {
    background: linear-gradient(135deg, #1e293b, #334155); color: #fff; padding: 2rem 2.5rem;
  }
  header a { color: #93c5fd; text-decoration: none; font-size: .85rem; }
  header h1 { font-size: 1.5rem; margin-top: .6rem; }
  header .ver { color: #cbd5e1; font-weight: 400; font-size: .95rem; }
  main { max-width: 820px; margin: 2rem auto; padding: 0 1.5rem; }
  .card {
    background: #fff; border: 1px solid #e2e8f0; border-radius: 12px;
    box-shadow: 0 1px 3px rgba(15,23,42,.06); padding: 1.5rem 1.75rem;
  }
  .desc { color: #475569; font-size: 1rem; }
  h2 { font-size: .8rem; text-transform: uppercase; letter-spacing: .6px; color: #64748b; margin: 1.5rem 0 .6rem; }
  pre {
    background: #0f172a; color: #e2e8f0; border-radius: 8px; padding: .9rem 1.1rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .86rem;
    overflow-x: auto;
  }
  .field { display: flex; gap: .5rem; font-size: .9rem; padding: .35rem 0; }
  .field b { min-width: 130px; color: #64748b; font-weight: 600; }
  .actions { display: flex; gap: .6rem; margin-top: 1rem; flex-wrap: wrap; }
  .btn {
    display: inline-block; padding: .55rem 1.1rem; border-radius: 8px;
    font-size: .9rem; font-weight: 600; text-decoration: none; border: none; cursor: pointer;
  }
  .btn-primary { background: #2563eb; color: #fff; }
  .btn-ghost { background: #eef2ff; color: #3730a3; }
</style>
</head>
<body>
<header>
  <a href="/index.bsp">← Indice</a>
  <h1><%= m["name"] %> <span class="ver">v<%= m["version"] %></span></h1>
</header>
<main>
  <div class="card">
    <p class="desc"><%= m["description"] %></p>

    <h2>Dettagli</h2>
    <div class="field"><b>ContentType</b><%= m["contentType"] %></div>
    <div class="field"><b>Edition</b><%= m["edition"] %></div>
    <div class="field"><b>Backends</b><%= m["backends"] %></div>
    <div class="field"><b>Versioni</b><%= m["versions"] %></div>

    <h2>Installa</h2>
    <pre><%= installCmd$ %></pre>

    <div class="actions">
      <%
        PRINT "<a class='btn btn-primary' href='" + dlHref$ + "'>Scarica .gmbpkg</a>"
      %>
      <a class="btn btn-ghost" href="/index.bsp">Torna all'elenco</a>
    </div>

    <p style="font-size:.8rem;color:#94a3b8;margin-top:1rem">
      Servito da GMBasic BSP · registry: <%= registry$ %>
    </p>
  </div>
</main>
</body>
</html>
