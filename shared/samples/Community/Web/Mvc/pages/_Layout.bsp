<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>@RenderSection("Title")</title>
<style>
  body { font-family: system-ui, sans-serif; margin: 0; }
  header { background: #222; color: #fff; padding: 8px 16px; }
  main { padding: 16px; max-width: 640px; }
  footer { border-top: 1px solid #ccc; margin-top: 24px; padding: 8px 16px; font-size: .9em; }
  input { display: block; margin: 4px 0 12px; padding: 6px; width: 220px; }
  #out { background: #f4f4f4; padding: 8px; white-space: pre-wrap; }
</style>
</head>
<body>
<header>@Html.Partial("_Header.bsp")</header>
<main><% RENDERBODY %></main>
<footer>@RenderSection("Footer")</footer>
</body>
</html>
