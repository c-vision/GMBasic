' FILE: System/SystemCtypeUdt.bas
' SYSTEM.CTYPE, UDTALIGNED, UDTPACKED coverage.
IMPORT SYSTEM
TYPE TestUDT
    a AS INTEGER
    b AS DOUBLE
END TYPE
SUB Main()
    PRINT "CTYPE str:  "; SYSTEM.CTYPE(42, "STRING")
    PRINT "CTYPE int:  "; SYSTEM.CTYPE("123", "INTEGER")
    DIM u AS TestUDT
    PRINT "UDTPACKED:  "; SYSTEM.UDTPACKED(u)
    PRINT "UDTALIGNED: "; SYSTEM.UDTALIGNED(u)
    PRINT "Test Completato."
END SUB