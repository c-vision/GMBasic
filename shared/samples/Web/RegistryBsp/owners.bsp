<%@ IMPORT HTTP, JSON %>
<%@ ROUTE "/owners.bsp" %>
<%
  DIM registry$ = "http://127.0.0.1:8087"
  DIM pkgName$ = REQ.Query["name"]
  DIM owner$ = ""
  DIM collab$ = ""
  DIM trovato = 0
  IF pkgName$ <> "" THEN
    DIM opts AS HTTPOPTIONS = NEW HTTPOPTIONS
    DIM r AS FETCHRESULT
    r = FETCH(registry$ + "/api/packages/" + pkgName$, opts)
    IF r.StatusCode = 200 THEN
      DIM j = JSON.PARSE(r.Body)
      trovato = 1
      ' il dettaglio esposto dall'API include owner/collaborators se presenti
      owner$ = j["owner"]
      collab$ = j["collaborators"]
    END IF
  END IF
%>
<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Gestione owners — GMBasic Registry</title>
<style>
  :root { color-scheme: light dark; }
  * { box-sizing: border-box; margin: 0; }
  body { font-family: -apple-system, "Segoe UI", Roboto, sans-serif; background: #f4f6fb; color: #1c2430; line-height: 1.5; padding: 0; }
  header { background: linear-gradient(135deg, #1e293b, #334155); color: #fff; padding: 2rem 2.5rem; }
  header h1 { font-size: 1.5rem; }
  header a { color: #93c5fd; text-decoration: none; font-size: .9rem; }
  main { max-width: 560px; margin: 2rem auto; padding: 0 1.5rem; }
  .card { background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.5rem; box-shadow: 0 1px 3px rgba(15,23,42,.06); }
  input, button { width: 100%; padding: .6rem .8rem; border-radius: 8px; font-size: .95rem; margin-top: .6rem; }
  input { border: 1px solid #cbd5e1; }
  button { border: 0; background: #2563eb; color: #fff; font-weight: 600; cursor: pointer; }
  .info { margin-top: 1rem; padding: .8rem; border-radius: 8px; background: #f8fafc; font-size: .85rem; }
  pre { background: #0f172a; color: #e2e8f0; border-radius: 8px; padding: .8rem; overflow-x: auto; font-size: .82rem; margin-top: .8rem; }
</style>
</head>
<body>
<header>
  <h1>Gestione collaboratori</h1>
  <p><a href="/index.bsp">&larr; Torna al registry</a></p>
</header>
<main>
  <div class="card">
    <form method="GET" action="/owners.bsp">
      <input name="name" placeholder="Nome pacchetto (es. demo)">
      <button type="submit">Mostra</button>
    </form>
    <% IF pkgName$ <> "" AND trovato = 1 THEN %>
      <div class="info">
        <strong>Pacchetto:</strong> <%= pkgName$ %><br>
        <strong>Owner:</strong> <%= owner$ %><br>
        <strong>Collaboratori:</strong> <%= collab$ %>
      </div>
      <p style="margin-top:1rem;font-size:.85rem;color:#64748b">Solo l'owner può aggiungere/rimuovere
         collaboratori. Usa la CLI:</p>
      <pre>gmb pkg owners add    <%= pkgName$ %> &lt;utente&gt;
gmb pkg owners remove <%= pkgName$ %> &lt;utente&gt;</pre>
    <% ELSEIF pkgName$ <> "" AND trovato = 0 THEN %>
      <div class="info" style="background:#fef2f2;color:#991b1b">Pacchetto non trovato.</div>
    <% END IF %>
  </div>
</main>
</body>
</html>
