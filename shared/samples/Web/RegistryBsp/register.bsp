<%@ IMPORT HTTP, JSON %>
<%@ ROUTE "/register.bsp" %>
<%
  DIM registry$ = "http://127.0.0.1:8087"
  DIM esito$ = ""
  DIM errore$ = ""
  DIM username$ = QUERY["username"]
  DIM email$ = QUERY["email"]
  ' Il form è GET (campi in query); la pagina fa FETCH POST all'API del registry.
  IF username$ <> "" THEN
    DIM payload = NEW JSON
    payload["name"] = username$
    payload["email"] = email$
    DIM opts AS HTTPOPTIONS = NEW HTTPOPTIONS
    opts.Method = "POST"
    opts.Body = JSON.STRINGIFY(payload)
    DIM r AS FETCHRESULT
    r = FETCH(registry$ + "/api/users/register", opts)
    IF r.StatusCode = 200 THEN
      DIM j = JSON.PARSE(r.Body)
      esito$ = "Account creato. Token (salvalo, non lo vedrai piu'): " + j["token"]
    ELSE
      errore$ = "Registrazione fallita: " + r.Body
    END IF
  END IF
%>
<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Registrati — GMBasic Registry</title>
<style>
  :root { color-scheme: light dark; }
  * { box-sizing: border-box; margin: 0; }
  body { font-family: -apple-system, "Segoe UI", Roboto, sans-serif; background: #f4f6fb; color: #1c2430; line-height: 1.5; padding: 0; }
  header { background: linear-gradient(135deg, #1e293b, #334155); color: #fff; padding: 2rem 2.5rem; }
  header h1 { font-size: 1.5rem; }
  header a { color: #93c5fd; text-decoration: none; font-size: .9rem; }
  main { max-width: 560px; margin: 2rem auto; padding: 0 1.5rem; }
  .card { background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.5rem; box-shadow: 0 1px 3px rgba(15,23,42,.06); }
  label { display: block; font-weight: 600; font-size: .85rem; margin: 1rem 0 .35rem; }
  input { width: 100%; padding: .6rem .8rem; border: 1px solid #cbd5e1; border-radius: 8px; font-size: .95rem; }
  button { margin-top: 1.2rem; width: 100%; padding: .7rem; border: 0; border-radius: 8px; background: #2563eb; color: #fff; font-size: .95rem; font-weight: 600; cursor: pointer; }
  button:hover { background: #1d4ed8; }
  .ok { margin-top: 1rem; padding: .8rem; border-radius: 8px; background: #ecfdf5; color: #065f46; font-size: .85rem; word-break: break-all; }
  .err { margin-top: 1rem; padding: .8rem; border-radius: 8px; background: #fef2f2; color: #991b1b; font-size: .85rem; }
</style>
</head>
<body>
<header>
  <h1>Registrati</h1>
  <p><a href="/index.bsp">&larr; Torna al registry</a></p>
</header>
<main>
  <div class="card">
    <form method="GET" action="/register.bsp">
      <label for="username">Nome utente (account del registry)</label>
      <input id="username" name="username" required autocomplete="off">
      <label for="email">Email</label>
      <input id="email" name="email" type="email">
      <button type="submit">Crea account</button>
    </form>
    <% IF esito$ <> "" THEN %><div class="ok"><%= esito$ %></div><% END IF %>
    <% IF errore$ <> "" THEN %><div class="err"><%= errore$ %></div><% END IF %>
    <p style="margin-top:1.2rem;font-size:.8rem;color:#64748b">
      Dopo la registrazione usa il token con <code>gmb login &lt;token&gt;</code>.
      Il primo <code>gmb publish</code> reclama il nome del pacchetto.
    </p>
  </div>
</main>
</body>
</html>
