<%@ IMPORT HTTP, JSON %>
<%@ ROUTE "/" %>
<%
  DIM registry$ = "http://127.0.0.1:8087"
  DIM opts AS HTTPOPTIONS = NEW HTTPOPTIONS
  DIM r = FETCH(registry$ + "/api/packages", opts)
  DIM pkgs = JSON.PARSE(r.Body)
%>
<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>GMBasic Package Registry</title>
<style>
  :root { color-scheme: light dark; }
  * { box-sizing: border-box; margin: 0; }
  body {
    font-family: -apple-system, "Segoe UI", Roboto, sans-serif;
    background: #f4f6fb; color: #1c2430; line-height: 1.5; padding: 0;
  }
  header {
    background: linear-gradient(135deg, #1e293b, #334155);
    color: #fff; padding: 2rem 2.5rem;
  }
  header h1 { font-size: 1.6rem; letter-spacing: .3px; }
  header p { color: #cbd5e1; margin-top: .3rem; font-size: .95rem; }
  main { max-width: 980px; margin: 2rem auto; padding: 0 1.5rem; }
  .card {
    background: #fff; border: 1px solid #e2e8f0; border-radius: 12px;
    box-shadow: 0 1px 3px rgba(15,23,42,.06); overflow: hidden;
  }
  table { width: 100%; border-collapse: collapse; }
  th {
    text-align: left; font-size: .75rem; text-transform: uppercase;
    letter-spacing: .5px; color: #64748b; background: #f8fafc;
    padding: .7rem 1rem; border-bottom: 1px solid #e2e8f0;
  }
  td { padding: .85rem 1rem; border-bottom: 1px solid #f1f5f9; font-size: .93rem; }
  tr:last-child td { border-bottom: 0; }
  tr:hover td { background: #f8fafc; }
  .name { font-weight: 600; color: #2563eb; text-decoration: none; }
  .name:hover { text-decoration: underline; }
  .ver { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .82rem; color: #334155; }
  .desc { color: #475569; }
  .badge {
    display: inline-block; font-size: .68rem; font-weight: 600;
    padding: .15rem .5rem; border-radius: 999px; background: #e0e7ff; color: #3730a3;
  }
  .count { color: #94a3b8; font-size: .82rem; }
</style>
</head>
<body>
<header>
  <h1>📦 GMBasic Package Registry</h1>
  <p><%= pkgs.Count() %> pacchetti disponibili — installa con <code>PACKAGE INSTALL &lt;nome&gt;</code></p>
</header>
<main>
  <div class="card">
    <table>
      <thead>
        <tr><th>Pacchetto</th><th>Versione</th><th>Descrizione</th></tr>
      </thead>
      <tbody>
        <% FOR EACH k IN JSON.KEYS(pkgs) %>
          <%
            DIM nm = pkgs[k]["name"]
            PRINT "<tr><td><a class='name' href='/package.bsp?name=" + nm + "'>" + nm + "</a></td><td><span class='ver'>" + pkgs[k]["version"] + "</span></td><td class='desc'>" + pkgs[k]["description"] + "</td></tr>"
          %>
        <% NEXT %>
      </tbody>
    </table>
  </div>
  <p class="count" style="margin-top:1rem">Servito da GMBasic BSP (Basic Server Pages)</p>
  <nav style="margin-top:1.5rem;display:flex;gap:.8rem;flex-wrap:wrap">
    <a class="name" href="/register.bsp">Registrati</a>
    <a class="name" href="/publish.bsp">Pubblica</a>
    <a class="name" href="/owners.bsp">Owners</a>
    <a class="name" href="/yank.bsp">Yank</a>
    <a class="name" href="/admin.bsp">Admin</a>
  </nav>
</main>
</body>
</html>
