{
  "model": "Llama-3.2-1B-Instruct-4bit",
  "config": "config.json",
  "spec": {
    "model_type": "llama",
    "hidden_size": 2048,
    "num_hidden_layers": 16,
    "num_attention_heads": 32,
    "num_key_value_heads": 8,
    "head_dim": 64,
    "intermediate_size": 8192,
    "num_experts": null,
    "experts_per_token": null,
    "rope_theta": 500000.0,
    "rms_norm_eps": 1e-05,
    "tie_word_embeddings": true,
    "sliding_window": null,
    "vocab_size": 128256,
    "rope_scaling": {
      "factor": 32.0,
      "high_freq_factor": 4.0,
      "low_freq_factor": 1.0,
      "original_max_position_embeddings": 8192,
      "rope_type": "llama3"
    },
    "quant": {
      "bits": 4,
      "group_size": 64
    },
    "architectures": [
      "LlamaForCausalLM"
    ]
  },
  "contract": {
    "_source": "convenzione dell'architettura (best-effort; verificare per-modello se critico)",
    "rope_convention": "neox",
    "attention": "GQA",
    "kv_heads": 8,
    "q_heads": 32,
    "head_dim": 64,
    "eps": 1e-05,
    "tie_word_embeddings": true,
    "kv_layout": "perlayer",
    "position_semantics": "absolute-0based",
    "residual_order": "pre",
    "attention_scale": "1/sqrt(head_dim)",
    "mask": null,
    "recurrent_state": "none"
  }
}