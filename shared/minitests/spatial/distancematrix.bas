' MiniTest: SPATIAL.DISTANCEMATRIX (parita' 4 backend).
' EXPECT: 1  4.242641
IMPORT SPATIAL
IMPORT MATRIX
SUB Main()
  DIM X(1) AS ARRAY OF DOUBLE
  X(0) = {0, 0}
  X(1) = {3, 4}
  DIM Y(1) AS ARRAY OF DOUBLE
  Y(0) = {1, 0}
  Y(1) = {0, 1}
  m = SPATIAL.DISTANCEMATRIX(X, Y)
  PRINT ROUND(MATRIX.GETVALUE(m, 0, 0), 6); ROUND(MATRIX.GETVALUE(m, 1, 1), 6)
END SUB
