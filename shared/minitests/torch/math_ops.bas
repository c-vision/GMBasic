' MiniTest: TORCH LOG/POW/GELU/SOFTMAX/SIMILARITY (parita' 4 backend).
' EXPECT: 1.386294|16|0.841345|1|0
IMPORT TORCH
SUB Main()
  a = TORCH.ZEROS(1, 3)
  TORCH.SET(a, 0, 0, 1.0) : TORCH.SET(a, 0, 1, 2.0) : TORCH.SET(a, 0, 2, 4.0)
  l = TORCH.LOG(a)
  PRINT ROUND(TORCH.GET(l, 0, 2), 6)
  p = TORCH.POW(a, 2.0)
  PRINT ROUND(TORCH.GET(p, 0, 2), 6)
  g = TORCH.GELU(a)
  PRINT ROUND(TORCH.GET(g, 0, 0), 6)
  s = TORCH.SOFTMAX(a)
  PRINT ROUND(TORCH.SUM(s), 6)
  PRINT ROUND(TORCH.SIMILARITY(a, a, "euclidean"), 6)
  TORCH.FREE(a) : TORCH.FREE(l) : TORCH.FREE(p) : TORCH.FREE(g) : TORCH.FREE(s)
END SUB
