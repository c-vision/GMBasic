' MiniTest: TORCH LOSSMSE/LOSSCROSSENTROPY (parita' 4 backend).
' EXPECT: 0.005|0
IMPORT TORCH
SUB Main()
  y = TORCH.ZEROS(1, 3)
  TORCH.SET(y, 0, 0, 1.0) : TORCH.SET(y, 0, 1, 0.0) : TORCH.SET(y, 0, 2, 0.0)
  p = TORCH.ZEROS(1, 3)
  TORCH.SET(p, 0, 0, 0.9) : TORCH.SET(p, 0, 1, 0.05) : TORCH.SET(p, 0, 2, 0.05)
  PRINT ROUND(TORCH.LOSSMSE(y, p), 6)
  PRINT ROUND(TORCH.LOSSCROSSENTROPY(y, p), 6)
  TORCH.FREE(y) : TORCH.FREE(p)
END SUB
