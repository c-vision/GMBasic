' MiniTest: SIGNAL.BUTTER + LFILTER (parita' 4 backend).
' EXPECT: 0.131106439916626  0.622465736636155  1.47863552962276  2.50954045478109  3.57180355424326
IMPORT SIGNAL
SUB Main()
  DIM wn(0) AS DOUBLE = {0.3}
  DIM h = SIGNAL.BUTTER(2, wn, "low")
  DIM x(4) AS DOUBLE = {1, 2, 3, 4, 5}
  DIM y() = SIGNAL.LFILTER(h, x)
  PRINT y(0); y(1); y(2); y(3); y(4)
END SUB
