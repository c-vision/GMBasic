' EXPECT: 2020|9|30|2020|2|29|2001|2|28|2|3
SUB Main()
  r = DATETIME.DATEADD("M", 1, DATETIME.DATEVALUE("2020-08-31"))
  PRINT DATETIME.YEAR(r)
  PRINT DATETIME.MONTH(r)
  PRINT DATETIME.DAY(r)
  r2 = DATETIME.DATEADD("M", -1, DATETIME.DATEVALUE("2020-03-31"))
  PRINT DATETIME.YEAR(r2)
  PRINT DATETIME.MONTH(r2)
  PRINT DATETIME.DAY(r2)
  r3 = DATETIME.DATEADD("yyyy", 1, DATETIME.DATEVALUE("2000-02-29"))
  PRINT DATETIME.YEAR(r3)
  PRINT DATETIME.MONTH(r3)
  PRINT DATETIME.DAY(r3)
  PRINT DATETIME.DATEDIFF("M", DATETIME.DATEVALUE("2000-01-15"), DATETIME.DATEVALUE("2000-03-15"))
  PRINT DATETIME.DATEDIFF("yyyy", DATETIME.DATEVALUE("1998-06-01"), DATETIME.DATEVALUE("2001-06-01"))
END SUB
