SUB Main()
  t = DATETIME.TIMESERIAL(23, 45, 30)
  PRINT DATETIME.HOUR(DATETIME.DATEADD("s", 30, t))
  PRINT DATETIME.MINUTE(DATETIME.DATEADD("s", 30, t))
  PRINT DATETIME.SECOND(DATETIME.DATEADD("s", 30, t))
  PRINT DATETIME.HOUR(DATETIME.DATEADD("n", 15, t))
  PRINT DATETIME.MINUTE(DATETIME.DATEADD("n", 15, t))
  PRINT DATETIME.SECOND(DATETIME.DATEADD("n", 15, t))
  PRINT DATETIME.HOUR(DATETIME.DATEADD("h", 1, t))
  PRINT DATETIME.MINUTE(DATETIME.DATEADD("h", 1, t))
  PRINT DATETIME.SECOND(DATETIME.DATEADD("h", 1, t))
END SUB
