' EXPECT: 2020|2|29|2000|2|29|28|29|0
SUB Main()
  r = DATETIME.DATEADD("M", 1, DATETIME.DATEVALUE("2020-01-31"))
  PRINT DATETIME.YEAR(r)
  PRINT DATETIME.MONTH(r)
  PRINT DATETIME.DAY(r)
  r2 = DATETIME.DATEADD("D", -1, DATETIME.DATEVALUE("2000-03-01"))
  PRINT DATETIME.YEAR(r2)
  PRINT DATETIME.MONTH(r2)
  PRINT DATETIME.DAY(r2)
  PRINT DATETIME.DAYSINMONTH(DATETIME.DATEVALUE("1900-02-15"))
  PRINT DATETIME.DAYSINMONTH(DATETIME.DATEVALUE("2000-02-15"))
  PRINT DATETIME.ISLEAPYEAR(DATETIME.DATEVALUE("1900-02-15"))
END SUB
