' MiniTest: costanti JOYSTICK (%JOYUP/%JOYDOWN/%JOYLEFT/%JOYRIGHT/%JOYFIRE/%JOYBUTTON2)
'   e FILE_EVENT (%FILE_CREATED/%FILE_DELETED/%FILE_CHANGED/%FILE_RENAMED).
'   I valori sono: UP=1 DOWN=2 LEFT=4 RIGHT=8 FIRE=16 BUTTON2=32
'   FILE: CREATED=1 DELETED=2 CHANGED=4 RENAMED=8
' EXPECT: up= 1|down= 2|left= 4|right= 8|fire= 16|btn2= 32|fcr= 1|fdel= 2|fchg= 4|fren= 8
SUB Main
  PRINT "up="; %JOYUP
  PRINT "down="; %JOYDOWN
  PRINT "left="; %JOYLEFT
  PRINT "right="; %JOYRIGHT
  PRINT "fire="; %JOYFIRE
  PRINT "btn2="; %JOYBUTTON2
  PRINT "fcr="; %FILE_CREATED
  PRINT "fdel="; %FILE_DELETED
  PRINT "fchg="; %FILE_CHANGED
  PRINT "fren="; %FILE_RENAMED
END SUB
