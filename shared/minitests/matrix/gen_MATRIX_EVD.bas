' EXPECT: ev= 3
IMPORT MATRIX
IMPORT MATH
SUB Main()
  DIM h = MATRIX.CREATE(2,2)
  h = MATRIX.SETVALUE(h,0,0,2) : h = MATRIX.SETVALUE(h,0,1,1)
  h = MATRIX.SETVALUE(h,1,0,1) : h = MATRIX.SETVALUE(h,1,1,2)
  DIM ed = MATRIX.EVD(h)
  DIM ev = MATRIX.FACTOR(ed, "D")
  PRINT "ev="; MATH.ROUND(MATRIX.GETVALUE(ev,1,1),6)
END SUB