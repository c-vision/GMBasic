' EXPECT: u00= 3
SUB Main()
  DIM a = MATRIX.CREATE(2,2)
  a = MATRIX.SETVALUE(a,0,0,1) : a = MATRIX.SETVALUE(a,0,1,2)
  a = MATRIX.SETVALUE(a,1,0,3) : a = MATRIX.SETVALUE(a,1,1,4)
  DIM lu = LINALG.LU(a)
  DIM u   = LINALG.FACTOR(lu, "U")
  PRINT "u00="; MATH.ROUND(MATRIX.GETVALUE(u,0,0),6)
END SUB