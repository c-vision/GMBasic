' EXPECT: orth= 0.707107
IMPORT MATRIX
IMPORT MATH
SUB Main()
  DIM h = MATRIX.CREATE(2,2)
  h = MATRIX.SETVALUE(h, 0, 0, 2) : h = MATRIX.SETVALUE(h, 0, 1, 1)
  h = MATRIX.SETVALUE(h, 1, 0, 1) : h = MATRIX.SETVALUE(h, 1, 1, 2)
  DIM r = MATRIX.ORTH(h)
  PRINT "orth="; MATH.ROUND(ABS(MATRIX.GETVALUE(r, 0, 0)), 6)
END SUB
