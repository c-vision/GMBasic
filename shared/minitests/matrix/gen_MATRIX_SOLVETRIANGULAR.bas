IMPORT MATRIX
IMPORT MATH
SUB Main()
  DIM a = MATRIX.CREATE(2,2)
  a = MATRIX.SETVALUE(a,0,0,2) : a = MATRIX.SETVALUE(a,0,1,1)
  a = MATRIX.SETVALUE(a,1,0,0) : a = MATRIX.SETVALUE(a,1,1,3)
  DIM b(1)
  b(0)=4 : b(1)=6
  DIM xs() = MATRIX.SOLVETRIANGULAR(a, b, 0)
  PRINT "x0="; MATH.ROUND(xs(0),6)
END SUB