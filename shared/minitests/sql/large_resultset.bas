' SQL resultset grandi: oltre il vecchio cap silenzioso di 4096 righe / 511 char per cella.
' 4200 righe contate una per una (nessun troncamento) + cella lunga 600 char letta INTERA.
' EXPECT: rows= 4200|last= 4200|
IMPORT SQL
IMPORT IO

SUB Main()
    ON ERROR RESUME NEXT
    IF IO.FILEEXISTS("work/lrs.db") THEN KILL "work/lrs.db"
    IF IO.FILEEXISTS("work/lrs.db-wal") THEN KILL "work/lrs.db-wal"
    IF IO.FILEEXISTS("work/lrs.db-shm") THEN KILL "work/lrs.db-shm"
    RMDIR "work", TRUE
    ON ERROR GOTO 0
    MKDIR "work"
    SQL OPEN "work/lrs.db" ALIAS L
    SQL EXEC L, "CREATE TABLE big(n INTEGER, s TEXT)"
    SQL EXEC L, "WITH RECURSIVE c(x) AS (SELECT 1 UNION ALL SELECT x+1 FROM c WHERE x<4200) INSERT INTO big(n,s) SELECT x, printf('%0600d', x) FROM c"

    ' Conta tutte le righe (vecchio cap: si fermava a 4096).
    DIM rs AS SQLRESULTSET
    SQL QUERY L, rs, "SELECT n FROM big"
    DIM cnt = 0
    DO WHILE SQL.FETCH(rs)
        cnt = cnt + 1
    LOOP
    PRINT "rows="; cnt
    SQL CLOSE RESULTSET rs

    ' Ultima riga: n intero + cella da 600 char stampata INTERA (vecchio cap: 511).
    SQL QUERY L, rs, "SELECT n, s FROM big WHERE n = 4200"
    IF SQL.FETCH(rs) THEN
        PRINT "last="; rs("n")
        PRINT "long="; rs("s")
    END IF
    SQL CLOSE RESULTSET rs
    SQL CLOSE L
END SUB
