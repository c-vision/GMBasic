' MiniTest DBF: posizione e LASTREC dopo APPEND BLANK / DELETE / RECALL.
' EXPECT: r0= 2 / 2|r1= 3 / 3|r2= 4 / 4 /del= 0|r3= 1 /del=-1|r4= 0|r5= 4 / 4
IMPORT DBF
IMPORT IO

TYPE TCli
  ID AS INTEGER
  Nome AS STRING * 10
END TYPE

SUB Main()
  DIM p AS STRING
  p = "/tmp/gmb_mt_dbf_ab.dbf"
  KILL p
  DBF CREATE p FROM TYPE TCli
  DBF USE p ALIAS D EXCLUSIVE NEW
  DBF APPEND RECORD {ID: 1, Nome: "A"}
  DBF APPEND RECORD {ID: 2, Nome: "B"}
  PRINT "r0="; DBF.RECNO(); "/"; DBF.LASTREC()
  DBF APPEND BLANK
  PRINT "r1="; DBF.RECNO(); "/"; DBF.LASTREC()
  DBF REPLACE ID WITH 3
  DBF GO TOP
  DBF DELETE
  DBF APPEND BLANK
  PRINT "r2="; DBF.RECNO(); "/"; DBF.LASTREC(); "/del="; DBF.DELETED()
  DBF GO 1
  PRINT "r3="; DBF.RECNO(); "/del="; DBF.DELETED()
  DBF RECALL
  PRINT "r4="; DBF.DELETED()
  DBF GO BOTTOM
  PRINT "r5="; DBF.RECNO(); "/"; DBF.LASTREC()
  DBF CLOSE DATABASES
  KILL p
END SUB
