' MiniTest: CRYPTOGRAPHY.AESENCRYPT/AESDECRYPT — round-trip (parita' 4 backend).
' EXPECT: [104, 101, 108, 108, 111, 32, 119, 111, 114, 108, 100]
IMPORT CRYPTOGRAPHY
SUB Main()
  DIM enc() AS BYTE = CRYPTOGRAPHY.AESENCRYPT("hello world", "0123456789abcdef")
  DIM dec() AS BYTE = CRYPTOGRAPHY.AESDECRYPT(enc, "0123456789abcdef")
  PRINT dec
END SUB
