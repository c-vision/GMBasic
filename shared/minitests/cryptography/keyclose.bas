' MiniTest: CRYPTOGRAPHY.KEYCLOSE — chiude l'handle di chiave.
' EXPECT: closed
REQUIRE "crypto"
IMPORT CRYPTOGRAPHY
SUB Main()
  DIM keys(1) AS LONG
  CALL CRYPTOGRAPHY.KEYGEN("ECDSA", 256, keys)
  pem$ = CRYPTOGRAPHY.KEYEXPORT(keys(0))
  imported = CRYPTOGRAPHY.KEYIMPORT(pem$)
  CALL CRYPTOGRAPHY.KEYCLOSE(imported)
  PRINT "closed"
END SUB
