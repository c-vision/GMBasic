' MiniTest: CRYPTOGRAPHY TOBASE64/FROMBASE64, TOBASE64URL/FROMBASE64URL, TOHEX/FROMHEX.
' EXPECT: aGVsbG8=|[104, 101, 108, 108, 111]|aGVsbG8_|[104, 101, 108, 108, 111, 63]|4142|[65, 66]
IMPORT CRYPTOGRAPHY
SUB Main()
  b64$ = CRYPTOGRAPHY.TOBASE64("hello")
  PRINT b64$
  PRINT CRYPTOGRAPHY.FROMBASE64(b64$)
  u$ = CRYPTOGRAPHY.TOBASE64URL("hello?")
  PRINT u$
  PRINT CRYPTOGRAPHY.FROMBASE64URL(u$)
  h$ = CRYPTOGRAPHY.TOHEX("AB")
  PRINT h$
  PRINT CRYPTOGRAPHY.FROMHEX(h$)
END SUB
