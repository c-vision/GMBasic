' MiniTest: CRYPTOGRAPHY TOBASE64/FROMBASE64, TOBASE64URL/FROMBASE64URL, TOHEX/FROMHEX.
' EXPECT: aGVsbG8=|[104,101,108,108,111]|aGVsbG8_|[104,101,108,108,111,63]|4142|[65,66]
REQUIRE "crypto"
IMPORT CRYPTOGRAPHY
SUB Main()
  b64$ = CRYPTOGRAPHY.TOBASE64("hello")
  PRINT b64$
  DIM d1(7) AS BYTE
  n1 = CRYPTOGRAPHY.FROMBASE64(b64$, d1)
  DIM r1(n1 - 1) AS BYTE
  FOR i = 0 TO n1 - 1
    r1(i) = d1(i)
  NEXT i
  PRINT r1
  u$ = CRYPTOGRAPHY.TOBASE64URL("hello?")
  PRINT u$
  DIM d2(7) AS BYTE
  n2 = CRYPTOGRAPHY.FROMBASE64URL(u$, d2)
  DIM r2(n2 - 1) AS BYTE
  FOR i = 0 TO n2 - 1
    r2(i) = d2(i)
  NEXT i
  PRINT r2
  h$ = CRYPTOGRAPHY.TOHEX("AB")
  PRINT h$
  DIM d3(1) AS BYTE
  n3 = CRYPTOGRAPHY.FROMHEX(h$, d3)
  DIM r3(n3 - 1) AS BYTE
  FOR i = 0 TO n3 - 1
    r3(i) = d3(i)
  NEXT i
  PRINT r3
END SUB
