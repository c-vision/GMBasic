' MiniTest: CRYPTOGRAPHY.ENCRYPTASYM/DECRYPTASYM (parita' 4 backend).
' EXPECT: [104, 101, 108, 108, 111]
IMPORT CRYPTOGRAPHY
SUB Main()
  DIM keys = CRYPTOGRAPHY.KEYGEN("RSA", 2048)
  DIM enc() AS BYTE = CRYPTOGRAPHY.ENCRYPTASYM("hello", keys(1))
  DIM dec() AS BYTE = CRYPTOGRAPHY.DECRYPTASYM(enc, keys(0))
  PRINT dec
END SUB
