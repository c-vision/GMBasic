' MiniTest: CRYPTOGRAPHY.ENCRYPTASYM/DECRYPTASYM.
' EXPECT: [104,101,108,108,111]
REQUIRE "crypto"
IMPORT CRYPTOGRAPHY
SUB Main()
  DIM keys(1) AS LONG
  CALL CRYPTOGRAPHY.KEYGEN("RSA", 2048, keys)
  DIM enc(255) AS BYTE
  n = CRYPTOGRAPHY.ENCRYPTASYM("hello", keys(1), enc)
  DIM dec(255) AS BYTE
  k = CRYPTOGRAPHY.DECRYPTASYM(enc, n, keys(0), dec)
  DIM r(k - 1) AS BYTE
  FOR i = 0 TO k - 1
    r(i) = dec(i)
  NEXT i
  PRINT r
END SUB
