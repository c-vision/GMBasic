' MiniTest: CRYPTOGRAPHY.CHACHA20POLY1305ENCRYPT/DECRYPT — round-trip (parita' 4 backend).
' EXPECT: [74, 42, 61, 159, 47]|[250, 219, 7, 70, 81, 71, 79, 1, 164, 156, 181, 190, 118, 48, 33, 68]|[104, 101, 108, 108, 111]
IMPORT CRYPTOGRAPHY
SUB Main()
  DIM key() AS BYTE = CRYPTOGRAPHY.FROMHEX("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f")
  DIM nonce() AS BYTE = CRYPTOGRAPHY.FROMHEX("000000000000004a00000000")
  DIM aad() AS BYTE = CRYPTOGRAPHY.FROMHEX("01020304")
  DIM r = CRYPTOGRAPHY.CHACHA20POLY1305ENCRYPT("hello", key, nonce, aad)
  PRINT r("ciphertext")
  PRINT r("tag")
  PRINT CRYPTOGRAPHY.CHACHA20POLY1305DECRYPT(r("ciphertext"), r("tag"), key, nonce, aad)
END SUB
