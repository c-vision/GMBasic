' MiniTest: CRYPTOGRAPHY.VERIFYRAW (Ed25519, RFC 8032 test vector 2).
' EXPECT: verify: ok|tamper: fail
REQUIRE "crypto"
IMPORT CRYPTOGRAPHY
SUB Main()
  pub$ = "PUAXw+hDiVqStwqnTRt+vJyYLM8uxJaMwM1V8Sr0Zgw="
  DIM sig(63) AS BYTE
  CRYPTOGRAPHY.FROMHEX("92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00", sig)
  DIM msg(0) AS BYTE
  CRYPTOGRAPHY.FROMHEX("72", msg)
  IF CRYPTOGRAPHY.VERIFYRAW(sig, 64, msg, 1, pub$) THEN PRINT "verify: ok" ELSE PRINT "verify: fail"
  DIM bad(0) AS BYTE
  CRYPTOGRAPHY.FROMHEX("73", bad)
  IF CRYPTOGRAPHY.VERIFYRAW(sig, 64, bad, 1, pub$) THEN PRINT "tamper: ok" ELSE PRINT "tamper: fail"
END SUB
