' MiniTest: CRYPTOGRAPHY.CHACHA20ENCRYPT/DECRYPT — round-trip.
' EXPECT: [104, 101, 108, 108, 111]
REQUIRE "crypto"
IMPORT CRYPTOGRAPHY
SUB Main()
  DIM key(31) AS BYTE
  CRYPTOGRAPHY.FROMHEX("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f", key)
  DIM nonce(11) AS BYTE
  CRYPTOGRAPHY.FROMHEX("000000000000004a00000000", nonce)
  DIM enc(4) AS BYTE
  n = CRYPTOGRAPHY.CHACHA20ENCRYPT("hello", key, nonce, enc)
  DIM dec(4) AS BYTE
  k = CRYPTOGRAPHY.CHACHA20DECRYPT(enc, n, key, nonce, dec)
  DIM r(k - 1) AS BYTE
  FOR i = 0 TO k - 1
    r(i) = dec(i)
  NEXT i
  PRINT r
END SUB
