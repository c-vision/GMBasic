' MiniTest: CRYPTOGRAPHY.CHACHA20ENCRYPT/DECRYPT — round-trip (parita' 4 backend).
' EXPECT: [104, 101, 108, 108, 111]
IMPORT CRYPTOGRAPHY
SUB Main()
  DIM key() AS BYTE = CRYPTOGRAPHY.FROMHEX("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f")
  DIM nonce() AS BYTE = CRYPTOGRAPHY.FROMHEX("000000000000004a00000000")
  DIM enc() AS BYTE = CRYPTOGRAPHY.CHACHA20ENCRYPT("hello", key, nonce)
  DIM dec() AS BYTE = CRYPTOGRAPHY.CHACHA20DECRYPT(enc, key, nonce)
  PRINT dec
END SUB
