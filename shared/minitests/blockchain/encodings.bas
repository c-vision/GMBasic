' MiniTest BLOCKCHAIN (pacchetto `blockchain`, ABI a array di BYTE): hash e encoding di "hello".
REQUIRE "blockchain"
REQUIRE "crypto"
IMPORT BLOCKCHAIN
IMPORT CRYPTOGRAPHY

SUB Main()
  DIM d(4) AS BYTE
  DIM _n_d AS LONG
  _n_d = FROMHEX("68656c6c6f", d)
  DIM h(31) AS BYTE
  KECCAK256(d, h)
  PRINT "k="; BYTESHEX(h)
  DIM r(19) AS BYTE
  RIPEMD160(d, r)
  PRINT "r="; BYTESHEX(r)
  PRINT "b32="; BASE32ENCODE(d)
  PRINT "b58="; BASE58ENCODE(d)
END SUB
