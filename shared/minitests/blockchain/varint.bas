' EXPECT: e0=00|e1=01|e127=7f|d127= 127|rt= 127
' MiniTest BLOCKCHAIN: VARINTENCODE/VARINTDECODE (LEB128) su valori single-byte 0/1/127.
IMPORT BLOCKCHAIN
IMPORT CRYPTOGRAPHY
SUB Main()
  PRINT "e0="; TOHEX(VARINTENCODE(0))
  PRINT "e1="; TOHEX(VARINTENCODE(1))
  PRINT "e127="; TOHEX(VARINTENCODE(127))
  DIM b() = FROMHEX("7f")
  PRINT "d127="; VARINTDECODE(b())
  PRINT "rt="; VARINTDECODE(VARINTENCODE(127))
END SUB
