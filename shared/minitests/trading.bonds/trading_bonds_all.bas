' MiniTest NAMESPACE TRADING.BONDS — tutte le 9 funzioni della superficie.
' BondPrice, BondYield, BondEquivalentYield, CurrentYield, YieldToMaturity,
' ZeroCouponBondValue, ZeroCouponBondYield, DURATION, PRICESIMPLE.
' EXPECT: 100|95.6808|0.072191|0.048775|0.041667|0.052083|0.055102|78.352617|0.04564|1.952381|101.886095
IMPORT BONDS
IMPORT DATETIME

SUB B_bond()
  PRINT ROUND(BONDS.BONDPRICE(DATETIME.DATEVALUE("2024-01-01"), DATETIME.DATEVALUE("2026-01-01"), 0.05, 0.05, 100, 1), 4)
  PRINT ROUND(BONDS.BONDPRICE(DATETIME.DATEVALUE("2024-01-01"), DATETIME.DATEVALUE("2026-01-01"), 0.05, 0.05, 100, 1, 1), 4)
  PRINT ROUND(BONDS.BONDYIELD(DATETIME.DATEVALUE("2024-01-01"), DATETIME.DATEVALUE("2026-01-01"), 0.05, 96, 100, 1), 6)
  PRINT ROUND(BONDS.BONDYIELD(DATETIME.DATEVALUE("2024-01-01"), DATETIME.DATEVALUE("2026-01-01"), 0.05, 96, 100, 1, 1), 6)
END SUB

SUB B_bonds2()
  PRINT ROUND(BONDS.BondEquivalentYield(100, 96, 365), 6)
  PRINT ROUND(BONDS.CurrentYield(5, 96), 6)
  PRINT ROUND(BONDS.YieldToMaturity(5, 100, 96, 10), 6)
  PRINT ROUND(BONDS.ZeroCouponBondValue(100, 0.05, 5), 6)
  PRINT ROUND(BONDS.ZeroCouponBondYield(100, 80, 5), 6)
END SUB

SUB B_duration()
  PRINT ROUND(BONDS.DURATION(DATETIME.DATEVALUE("2024-01-01"), DATETIME.DATEVALUE("2026-01-01"), 0.05, 0.05, 1, 0, 1), 6)
END SUB

SUB B_pricesimple()
  PRINT ROUND(BONDS.PRICESIMPLE(DATETIME.DATEVALUE("2024-01-01"), DATETIME.DATEVALUE("2026-01-01"), 0.05, 0.04, 100, 1), 6)
END SUB

SUB Main()
  B_bond()
  B_bonds2()
  B_duration()
  B_pricesimple()
END SUB
