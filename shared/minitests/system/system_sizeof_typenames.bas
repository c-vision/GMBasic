' MiniTest: SIZEOF di un NOME DI TIPO SCALARE scritto come argomento nudo — canone in
'  common/Ast/TypeLayout.cs (TrySizeOfTypeName), tabella replicata solo in C99Native
'  (gmb_sizeof_type_name). Parità 4 backend (IL, PCodeVM, VM/C, C99Native).
'  Larghezze: 1 BIT/BOOLEAN/BYTE/SBYTE · 2 INTEGER/SHORT/UINT/UINTEGER/USHORT · 4 SINGLE ·
'  8 LONG/ULONG/QUAD/UQUAD/DOUBLE/NUMERIC · 16 CURRENCY · STRING senza "* n" = -1.
' EXPECT: 1|1|1|1|2|2|2|2|2|4|8|8|8|8|8|8|16|-1
IMPORT SYSTEM
SUB Main()
  PRINT SIZEOF(BIT)
  PRINT SIZEOF(BOOLEAN)
  PRINT SIZEOF(BYTE)
  PRINT SIZEOF(SBYTE)
  PRINT SIZEOF(INTEGER)
  PRINT SIZEOF(SHORT)
  PRINT SIZEOF(UINT)
  PRINT SIZEOF(UINTEGER)
  PRINT SIZEOF(USHORT)
  PRINT SIZEOF(SINGLE)
  PRINT SIZEOF(LONG)
  PRINT SIZEOF(ULONG)
  PRINT SIZEOF(QUAD)
  PRINT SIZEOF(UQUAD)
  PRINT SIZEOF(DOUBLE)
  PRINT SIZEOF(NUMERIC)
  PRINT SIZEOF(CURRENCY)
  PRINT SIZEOF(STRING)
END SUB
