' EXPECT: p05= 0.604146|p15= 0.877588|r2= 0.855677|r2l= 0.842381|r2c= 0.774213
' Gradient boosting via FFI: modello opaco (handle LONG) + BOOSTFREE.
IMPORT MULTIVARIATE
SUB Main()
  DIM X(19, 0) AS DOUBLE
  DIM y(19) AS DOUBLE
  FOR i = 0 TO 19
    X(i,0) = i * 0.1
    y(i) = SIN(X(i,0)) + 0.1 * COS(i * 1.3)
  NEXT i
  DIM q(0) AS DOUBLE
  DIM m AS LONG = MULTIVARIATE.BOOSTFIT(X, y, 0, 10, 0.1, 2)
  q(0) = 0.5
  PRINT "p05="; MATH.ROUND(MULTIVARIATE.BOOSTPREDICT(m, q), 6)
  q(0) = 1.5
  PRINT "p15="; MATH.ROUND(MULTIVARIATE.BOOSTPREDICT(m, q), 6)
  PRINT "r2="; MATH.ROUND(MULTIVARIATE.BOOSTSCORE(m, X, y), 6)
  MULTIVARIATE.BOOSTFREE(m)
  DIM m1 AS LONG = MULTIVARIATE.BOOSTFIT(X, y, 1, 10, 0.1, 2)
  PRINT "r2l="; MATH.ROUND(MULTIVARIATE.BOOSTSCORE(m1, X, y), 6)
  MULTIVARIATE.BOOSTFREE(m1)
  DIM m2 AS LONG = MULTIVARIATE.BOOSTFIT(X, y, 2, 10, 0.1, 2)
  PRINT "r2c="; MATH.ROUND(MULTIVARIATE.BOOSTSCORE(m2, X, y), 6)
  MULTIVARIATE.BOOSTFREE(m2)
END SUB
