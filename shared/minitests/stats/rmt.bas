' EXPECT: lp= 1.44|lm= 0.64|coh= 1|norm= 3.163068|dk= 2|ang= 1.570796|t= 0.75
IMPORT MULTIVARIATE
SUB Main()
  PRINT "lp="; MATH.ROUND(MULTIVARIATE.RMTLAMBDAPLUS(4, 100, 1.0), 6)
  PRINT "lm="; MATH.ROUND(MULTIVARIATE.RMTLAMBDAMINUS(4, 100, 1.0), 6)
  DIM v(3) AS DOUBLE
  v(0) = 0.5: v(1) = 0.5: v(2) = 0.5: v(3) = 0.5
  PRINT "coh="; MATH.ROUND(MULTIVARIATE.RMTCOHERENCE(v), 6)
  DIM a(8) AS DOUBLE
  a(0) = 1: a(1) = 0.2: a(2) = 0.1
  a(3) = 0.2: a(4) = 3: a(5) = 0.4
  a(6) = 0.1: a(7) = 0.4: a(8) = 2
  PRINT "norm="; MATH.ROUND(MULTIVARIATE.RMTSPECTRALNORM(a, 3), 6)
  PRINT "dk="; MATH.ROUND(MULTIVARIATE.RMTDAVISKAHAN(0.5, 0.25), 6)
  DIM u(2) AS DOUBLE
  DIM w(2) AS DOUBLE
  u(0) = 1: u(1) = 0: u(2) = 0
  w(0) = 0: w(1) = 1: w(2) = 0
  PRINT "ang="; MATH.ROUND(MULTIVARIATE.RMTPRINCIPALANGLE(u, w), 6)
  PRINT "t="; MATH.ROUND(MULTIVARIATE.RMTTIGHTNESS(0.9, 1.2), 6)
END SUB
