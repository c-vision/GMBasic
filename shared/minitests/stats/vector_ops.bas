' EXPECT: add= 5  7  9|sub= 3  3  3|mul= 4  10  18|scale= 2  4  6|norm= 0.6  0.8|cross= 0  0  1|ang= 1.570796|dist= 3|lerp= 2.5
IMPORT VECTOR
SUB Main()
  DIM a = VECTOR.CREATE(1, 2, 3)
  DIM b = VECTOR.CREATE(4, 5, 6)
  DIM s = VECTOR.VADD(a, b)
  PRINT "add="; VECTOR.VGET(s, 0); VECTOR.VGET(s, 1); VECTOR.VGET(s, 2)
  DIM d = VECTOR.VSUB(b, a)
  PRINT "sub="; VECTOR.VGET(d, 0); VECTOR.VGET(d, 1); VECTOR.VGET(d, 2)
  DIM m = VECTOR.VMUL(a, b)
  PRINT "mul="; VECTOR.VGET(m, 0); VECTOR.VGET(m, 1); VECTOR.VGET(m, 2)
  DIM q = VECTOR.VSCALE(a, 2.0)
  PRINT "scale="; VECTOR.VGET(q, 0); VECTOR.VGET(q, 1); VECTOR.VGET(q, 2)
  DIM n = VECTOR.VNORM(VECTOR.CREATE(3, 4, 0))
  PRINT "norm="; MATH.ROUND(VECTOR.VGET(n, 0), 6); MATH.ROUND(VECTOR.VGET(n, 1), 6)
  DIM c = VECTOR.VCROSS(VECTOR.CREATE(1, 0, 0), VECTOR.CREATE(0, 1, 0))
  PRINT "cross="; VECTOR.VGET(c, 0); VECTOR.VGET(c, 1); VECTOR.VGET(c, 2)
  PRINT "ang="; MATH.ROUND(VECTOR.VANGLE(VECTOR.CREATE(1, 0, 0), VECTOR.CREATE(0, 1, 0)), 6)
  PRINT "dist="; MATH.ROUND(VECTOR.VDIST(VECTOR.CREATE(1, 1, 1), VECTOR.CREATE(1, 1, 4)), 6)
  DIM l = VECTOR.VLERP(VECTOR.CREATE(0, 0, 0), VECTOR.CREATE(10, 10, 10), 0.25)
  PRINT "lerp="; VECTOR.VGET(l, 0)
END SUB
