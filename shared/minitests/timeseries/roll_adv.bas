' TIMESERIES (FFI): TSROLLREGRESSION/TSROLLREGRESSIONSINGLE/TSROLLMINMAX/TSDECOMPOSE/
' TSCOVARIANCEMATRIX/TSOUTLIERS. Le matrici sono ora piatte (row-major/interleaved).
' EXPECT: rr= 1|rs= 1.5|mm= 1 , 4|cv= 1|dec= 3|out= 0
IMPORT TIMESERIES AS TS
SUB Main()
  DIM s(5) AS DOUBLE = {1,2,4,3,5,7}
  DIM d(1) AS ARRAY OF DOUBLE
  d(0) = {1.0, 2.0, 3.0, 4.0}
  d(1) = {2.0, 4.0, 5.0, 8.0}
  DIM rr() AS DOUBLE = TS.TSROLLREGRESSION(s, s, 3)
  DIM rs() AS DOUBLE = TS.TSROLLREGRESSIONSINGLE(s, 3)
  DIM mm() AS DOUBLE = TS.TSROLLMINMAX(s, 3)
  DIM dec() AS DOUBLE = TS.TSDECOMPOSE(s, 2)
  DIM cv() AS DOUBLE = TS.TSCOVARIANCEMATRIX(d)
  DIM ol(5) AS LONG
  DIM noc AS LONG = TS.TSOUTLIERS(s, 2.0, ol)
  PRINT "rr="; MATH.ROUND(rr(0), 4)
  PRINT "rs="; MATH.ROUND(rs(0), 4)
  PRINT "mm="; MATH.ROUND(mm(0), 4); ","; MATH.ROUND(mm(1), 4)
  PRINT "cv="; MATH.ROUND(cv(1), 4)
  PRINT "dec="; (UBOUND(dec) + 1) / (UBOUND(s) + 1)
  PRINT "out="; noc
END SUB
