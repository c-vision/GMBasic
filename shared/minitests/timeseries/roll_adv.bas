' TIMESERIES: TSROLLREGRESSION/TSROLLREGRESSIONSINGLE/TSROLLMINMAX/TSDECOMPOSE/
' TSCOVARIANCEMATRIX/TSOUTLIERS (matrice = array di array, m(i)(j)).
' EXPECT: rr= 1|rs= 1.5|mm= 1 , 4|cv= 1|dec= 3|out= 0
IMPORT TIMESERIES AS TS
SUB Main()
  DIM s(5) AS DOUBLE = {1,2,4,3,5,7}
  DIM d(1) AS ARRAY OF DOUBLE
  d(0) = {1.0, 2.0, 3.0, 4.0}
  d(1) = {2.0, 4.0, 5.0, 8.0}
  DIM rr() AS ARRAY OF DOUBLE = TS.TSROLLREGRESSION(s, s, 3)
  DIM rs() AS ARRAY OF DOUBLE = TS.TSROLLREGRESSIONSINGLE(s, 3)
  DIM mm() AS ARRAY OF DOUBLE = TS.TSROLLMINMAX(s, 3)
  DIM dec() AS ARRAY OF DOUBLE = TS.TSDECOMPOSE(s, 2)
  DIM cv() AS ARRAY OF DOUBLE = TS.TSCOVARIANCEMATRIX(d)
  DIM ol() AS LONG = TS.TSOUTLIERS(s, 2.0)
  PRINT "rr="; MATH.ROUND(rr(0)(0), 4)
  PRINT "rs="; MATH.ROUND(rs(0)(0), 4)
  PRINT "mm="; MATH.ROUND(mm(0)(0), 4); ","; MATH.ROUND(mm(0)(1), 4)
  PRINT "cv="; MATH.ROUND(cv(0)(1), 4)
  PRINT "dec="; UBOUND(dec) + 1
  PRINT "out="; UBOUND(ol) + 1
END SUB
