' Minitest MESSAGE ciclo completo — CONNECT/SUBSCRIBE/ON MESSAGE/PUBLISH/UNSUBSCRIBE/PING/CLOSE.
' Parità 4 backend: dopo UNSUBSCRIBE non arriva più nulla.
' EXPECT: RX s t a|DONE
IMPORT MESSAGE
SUB H(id AS STRING, topic AS STRING, payload AS STRING)
  PRINT "RX "; id; " "; topic; " "; payload
END SUB
SUB Main()
  DIM b AS LONG
  MESSAGE CONNECT "local" AS b
  MESSAGE SUBSCRIBE b TOPIC("t") AS "s"
  ON MESSAGE "s" CALL H
  MESSAGE PUBLISH b TOPIC("t") DATA("a")
  SLEEP 150
  MESSAGE UNSUBSCRIBE "s"
  MESSAGE PUBLISH b TOPIC("t") DATA("b")
  SLEEP 150
  MESSAGE PING b
  MESSAGE CLOSE b
  PRINT "DONE"
END SUB
