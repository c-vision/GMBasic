DECLARE FUNCTION RHO_NAT LIB "gmbquant" ALIAS "ofx_q_rho_s" (S AS DOUBLE, K AS DOUBLE, T AS DOUBLE, r AS DOUBLE, vol AS DOUBLE, type AS STRING) AS DOUBLE
PUBLIC FUNCTION Rho(S AS DOUBLE, K AS DOUBLE, T AS DOUBLE, r AS DOUBLE, vol AS DOUBLE, type AS STRING) AS DOUBLE
