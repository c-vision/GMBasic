PUBLIC FUNCTION Theta(S AS DOUBLE, K AS DOUBLE, T AS DOUBLE, r AS DOUBLE, vol AS DOUBLE, type AS STRING) AS DOUBLE
  RETURN THETA_NAT(S, K, T, r, vol, type)
