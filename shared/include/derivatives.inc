' derivatives.inc — namespace DERIVATIVES: opzioni e greche (FFI, libgmbquant).
'
' Erano TRADING.OPTIONS (16 funzioni). `type` è la stringa "CALL"/"PUT".
'
'   BsCall / BsPut(S, K, T, r, vol[, q])       q = dividend yield (0 = Black-Scholes)
'   MertonCall / MertonPut(S, K, T, r, vol[, q])
'   BinomialOption(S, K, T, r, vol, steps, type)
'   Delta/Theta/Rho/Charm(S, K, T, r, vol, type)
'   Gamma/Vega/Vanna/Volga/Zomma(S, K, T, r, vol)
'   DeltaSpeed(S, K, T, r, vol)   GammaColor(S, K, T, r, vol)
NAMESPACE DERIVATIVES

DECLARE FUNCTION BSCALL_NAT LIB "gmbquant" ALIAS "ofx_q_bs_call" (S AS DOUBLE, K AS DOUBLE, T AS DOUBLE, r AS DOUBLE, vol AS DOUBLE, q AS DOUBLE) AS DOUBLE
PUBLIC FUNCTION BsCall(S AS DOUBLE, K AS DOUBLE, T AS DOUBLE, r AS DOUBLE, vol AS DOUBLE, OPTIONAL q AS DOUBLE = 0) AS DOUBLE
  RETURN BSCALL_NAT(S, K, T, r, vol, q)
END FUNCTION

DECLARE FUNCTION BSPUT_NAT LIB "gmbquant" ALIAS "ofx_q_bs_put" (S AS DOUBLE, K AS DOUBLE, T AS DOUBLE, r AS DOUBLE, vol AS DOUBLE, q AS DOUBLE) AS DOUBLE
PUBLIC FUNCTION BsPut(S AS DOUBLE, K AS DOUBLE, T AS DOUBLE, r AS DOUBLE, vol AS DOUBLE, OPTIONAL q AS DOUBLE = 0) AS DOUBLE
  RETURN BSPUT_NAT(S, K, T, r, vol, q)
END FUNCTION

DECLARE FUNCTION MERTONCALL_NAT LIB "gmbquant" ALIAS "ofx_q_merton_call" (S AS DOUBLE, K AS DOUBLE, T AS DOUBLE, r AS DOUBLE, vol AS DOUBLE, q AS DOUBLE) AS DOUBLE
PUBLIC FUNCTION MertonCall(S AS DOUBLE, K AS DOUBLE, T AS DOUBLE, r AS DOUBLE, vol AS DOUBLE, OPTIONAL q AS DOUBLE = 0) AS DOUBLE
  RETURN MERTONCALL_NAT(S, K, T, r, vol, q)
END FUNCTION

DECLARE FUNCTION MERTONPUT_NAT LIB "gmbquant" ALIAS "ofx_q_merton_put" (S AS DOUBLE, K AS DOUBLE, T AS DOUBLE, r AS DOUBLE, vol AS DOUBLE, q AS DOUBLE) AS DOUBLE
PUBLIC FUNCTION MertonPut(S AS DOUBLE, K AS DOUBLE, T AS DOUBLE, r AS DOUBLE, vol AS DOUBLE, OPTIONAL q AS DOUBLE = 0) AS DOUBLE
  RETURN MERTONPUT_NAT(S, K, T, r, vol, q)
END FUNCTION

DECLARE FUNCTION BINOMIALOPTION_NAT LIB "gmbquant" ALIAS "ofx_q_binomial_s" (S AS DOUBLE, K AS DOUBLE, T AS DOUBLE, r AS DOUBLE, vol AS DOUBLE, steps AS LONG, type AS STRING) AS DOUBLE
PUBLIC FUNCTION BinomialOption(S AS DOUBLE, K AS DOUBLE, T AS DOUBLE, r AS DOUBLE, vol AS DOUBLE, steps AS LONG, type AS STRING) AS DOUBLE
  RETURN BINOMIALOPTION_NAT(S, K, T, r, vol, steps, type)
END FUNCTION

DECLARE FUNCTION DELTA_NAT LIB "gmbquant" ALIAS "ofx_q_delta_s" (S AS DOUBLE, K AS DOUBLE, T AS DOUBLE, r AS DOUBLE, vol AS DOUBLE, type AS STRING) AS DOUBLE
PUBLIC FUNCTION Delta(S AS DOUBLE, K AS DOUBLE, T AS DOUBLE, r AS DOUBLE, vol AS DOUBLE, type AS STRING) AS DOUBLE
  RETURN DELTA_NAT(S, K, T, r, vol, type)
