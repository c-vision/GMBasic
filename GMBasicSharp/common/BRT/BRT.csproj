<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>GMBasic.Runtime</AssemblyName>
    <RootNamespace>Basic.Runtime</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <Description>BASIC Runtime — runtime services for compiled BASIC programs</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CommonLib\CommonLib.csproj" />
    <ProjectReference Include="..\Databases\Databases.csproj" />
    <!-- CompiledChunk per il serializzatore A1 (VM/C bridge) -->
    <ProjectReference Include="..\Compiler\Compiler.csproj" />
  </ItemGroup>

  <!-- I motori database su file (DBF/ISAM/SPEED/Ledger) stanno in modules/Database e sono
       SEMPRE referenziati: DatabaseService.Native.cs li usa in qualunque build. -->
  <ItemGroup>
    <ProjectReference Include="..\..\modules\Database\Database.csproj" />
  </ItemGroup>

</Project>
